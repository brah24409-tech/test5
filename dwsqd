            if not isEquipRequired() then return end
            if isSelectedWeapon(child) then
                task.wait(0.1)
                equipSelected()
            end
        end)

        -- Periodic check as a safety net
        local lastEquipRequired = false
        while task.wait(0.5) do
            if _G.ScriptVersion ~= myVersion then break end
            local currentRequired = isEquipRequired()
            if currentRequired then
                if _G.selectedWeapon then
                    equipSelected()
                    if LocalPlayer.Character then
                        enforceOnlySelected(LocalPlayer.Character)
                    end
                end
            else
                if lastEquipRequired then
                    unequipSelected()
                end
            end
            lastEquipRequired = currentRequired
        end
    end)
