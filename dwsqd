    --// ========== UNLOAD & CLEANUP SECTION ==========
    local unloadSection = SettingsTab:NewSection("Unload Script")

    unloadSection:NewButton("Unload Everything", "Stops all loops, destroys UI, removes ESP & resets player", function()
        pcall(function()
            -- 1. Notify user
            if Notify then
                Notify("Unloading", "Stopping all features and cleaning up memory...", 2)
            end

            -- 2. Invalidate ScriptVersion to kill all active background loops
            _G.ScriptVersion = (_G.ScriptVersion or 0) + 9999

            if _G.ZelesESPShutdown then pcall(_G.ZelesESPShutdown) end
            -- 3. Kill all active flags & global toggles
            local flagsToClear = {
                "AutoFarm", "AutoChest", "KillAura", "AutoMastery", "AutoRaid", "AutoFruit",
                "AutoStats", "AutoHaki", "AutoBusk", "AutoObservation", "AutoDungeon",
                "AutoSeaBeast", "AutoEliteHunter", "AutoPirateRaid", "AutoBone", "AutoDino",
                "AutoPrehistoric", "AutoBerry", "BerryESP", "FruitESP", "ChestESP", "PlayerESP",
                "IslandESP", "FlowerESP", "MirageESP", "KitsuneESP", "Noclip", "InfEnergy",
                "InfGeppo", "FastAttack", "SmartAttack", "AutoClicker", "AutoEquip", "BringMob",
                "Tweening", "WalkSpeed", "JumpPower", "Fly", "AutoHopCastleRaid", "AutoSkylandsCastle",
                "CastleEventActive", "AutoSelectTeam", "AutoLaw", "AutoRengoku", "AutoSaber",
                "AutoPole", "AutoBisento", "AutoTrueTripleKatana", "AutoDarkCoat", "AutoSolveMoments",
                "SecretsESP"
            }
            for _, flag in ipairs(flagsToClear) do
                _G[flag] = false
            end

            -- 4. Cancel active Tweens & stop TP immediately
            if stopAllTweens then stopAllTweens() end
            if _G.stopAllTweens then _G.stopAllTweens() end
            if _G.ActiveTween then
                pcall(function()
                    _G.ActiveTween:Cancel()
                    _G.ActiveTween:Destroy()
                end)
                _G.ActiveTween = nil
            end
            if _G.ActiveTweenNoclip then
                pcall(function() _G.ActiveTweenNoclip:Disconnect() end)
                _G.ActiveTweenNoclip = nil
            end
            if _G.ActiveTweenBV then
                pcall(function() _G.ActiveTweenBV:Destroy() end)
                _G.ActiveTweenBV = nil
            end

            -- 5. Disconnect all tracked connections
            if _G.ZelesConnections and type(_G.ZelesConnections) == "table" then
                for _, conn in pairs(_G.ZelesConnections) do
                    pcall(function()
                        if typeof(conn) == "RBXScriptConnection" then
                            conn:Disconnect()
                        end
                    end)
                end
                _G.ZelesConnections = {}
            end

            -- 6. Clean up Body Movers, temporary parts, velocities and Noclip on Character
            local lp = game:GetService("Players").LocalPlayer
            local char = lp and lp.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BodyVelocity") or part:IsA("BodyGyro") or part:IsA("BodyPosition")
                    or part:IsA("AlignPosition") or part:IsA("AlignOrientation") or part:IsA("VectorForce")
                    or part:IsA("LinearVelocity") or part:IsA("BodyThrust") or part:IsA("RocketPropulsion")
                    or part.Name == "Zeles_TP_Velocity" then
                        pcall(function() part:Destroy() end)
                    end
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function()
                        hrp.Velocity = Vector3.new(0, 0, 0)
                        hrp.RotVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end)
                end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.WalkSpeed = 16
                    hum.JumpPower = 50
                end
            end

            -- 7. Remove any script-created drawings / ESP / folders in Workspace
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj.Name:find("Zeles") or obj.Name:find("ESP") or obj.Name == "Orion_Folder" then
                    pcall(function() obj:Destroy() end)
                end
            end

            -- 8. Destroy Orion UI & screen containers
            pcall(function()
                if _G.OrionLib and _G.OrionLib.Destroy then
                    _G.OrionLib:Destroy()
                end
                if OrionLib and OrionLib.Destroy then
                    OrionLib:Destroy()
                end
            end)

            local CoreGui = game:GetService("CoreGui")
            local pgui = lp and lp:FindFirstChild("PlayerGui")
            for _, parent in ipairs({CoreGui, pgui, (gethui and gethui())}) do
                if parent then
                    for _, v in ipairs(parent:GetChildren()) do
                        if v.Name:find("Orion") or v.Name:find("Zeles") or v.Name == "Orion" or v:FindFirstChild("MainContainer") then
                            pcall(function() v:Destroy() end)
                        end
                    end
                end
            end

            -- 9. Clear global references
            _G.OrionLib = nil
            _G.ZelesHub = nil

            if rconsoleprint then
                rconsoleprint("\n\27[33m[ZELES HUB] Script completely unloaded.\27[0m\n")
            end
        end)
    end)
end
