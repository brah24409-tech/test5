    local function getMyBoat()
        for _, v in pairs(game.Workspace.Boats:GetChildren()) do
            local ownerAttr = v:GetAttribute("Owner")
            local ownerVal = v:FindFirstChild("Owner")
            if (ownerAttr == LocalPlayer.Name or ownerAttr == tostring(LocalPlayer.UserId)) or 
               (ownerVal and (ownerVal.Value == LocalPlayer.Name or ownerVal.Value == LocalPlayer or ownerVal.Value == tostring(LocalPlayer.UserId))) then
                return v
            end
        end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            for _, v in pairs(game.Workspace.Boats:GetChildren()) do
                if (v:GetPivot().Position - root.Position).Magnitude < 50 then
                    return v
                end
            end
        end
        return nil
    end

