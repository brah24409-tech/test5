local BoneSection = StatusTab:NewSection("Farming Bone")

local function getBoneCount(lite)
    local count = 0
    local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
    
    -- Priority 1: CommF_ "Bones", "Check" (Authoritative Blox Fruits server query)
    if commF then
        pcall(function()
            local res = commF:InvokeServer("Bones", "Check")
            if type(res) == "number" and res > 0 then
                count = res
            elseif type(res) == "string" then
                local num = tonumber(res:match("%d+"))
                if num and num > 0 then count = num end
            end
        end)
    end
    if count > 0 then return count end
    if lite then
        -- perf: label polling skips the getInventory dump (huge server round-trip)
        pcall(function()
            local data = LocalPlayer and LocalPlayer:FindFirstChild("Data")
            if data then
                for _, child in ipairs(data:GetChildren()) do
                    local nv = tonumber(child.Value)
                    if nv and child.Name:lower():find("bone") then count = math.max(count, nv) end
                end
            end
        end)
        return count
    end
    
    -- Priority 2: Check Inventory via getInventory
    if commF then
        local ok, inv = pcall(function() return commF:InvokeServer("getInventory") end)
        if ok and type(inv) == "table" then
            for _, item in pairs(inv) do
                if type(item) == "table" and item.Name then
                    local n = tostring(item.Name):lower()
                    if n == "bones" or n == "bone" or n:find("bone") then
                        local c = tonumber(item.Count) or tonumber(item.count) or tonumber(item.Value) or tonumber(item.Amount) or 1
                        if c > count then count = c end
                    end
                end
            end
        end
    end
    if count > 0 then return count end
    
    -- Priority 3: Player Data folder / Attributes
    pcall(function()
        local lp = LocalPlayer
        if lp then
            local data = lp:FindFirstChild("Data")
            if data then
                for _, child in ipairs(data:GetChildren()) do
                    if child.Name:lower():find("bone") and child.Value then
                        local num = tonumber(child.Value)
                        if num and num > count then count = num end
                    end
                end
            end
            for attrName, attrVal in pairs(lp:GetAttributes()) do
                if tostring(attrName):lower():find("bone") and tonumber(attrVal) then
                    local num = tonumber(attrVal)
                    if num and num > count then count = num end
                end
            end
        end
    end)
    
    return count
end
_G.GetBonesCount = getBoneCount

