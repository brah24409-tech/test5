-- Combat helper for bosses (uses same anti-rubberband TP & attack logic as main farm)
function AttackBoss(boss)
    if not boss or not boss:FindFirstChildOfClass("Humanoid") or (boss:FindFirstChildOfClass("Humanoid") and boss:FindFirstChildOfClass("Humanoid").Health or 0) <= 0 then return end
    if not boss:FindFirstChild("HumanoidRootPart") then return end

    -- Disable boss movement and collision
    pcall(function()
        boss.HumanoidRootPart.CanCollide = false
        if boss:FindFirstChildOfClass("Humanoid") then boss:FindFirstChildOfClass("Humanoid").WalkSpeed = 0 end
        boss.HumanoidRootPart.Size = Vector3.new(1, 1, 1)
    end)

    -- Equip selected weapon or best tool from backpack
    local char = LocalPlayer.Character
    if char then
        if _G.selectedWeapon then
            local tool = LocalPlayer.Backpack:FindFirstChild(_G.selectedWeapon)
            if tool and tool:IsA("Tool") then
                tool.Parent = char
            end
        end
        if not char:FindFirstChildOfClass("Tool") then
            for _, t in pairs(LocalPlayer.Backpack:GetChildren()) do
                if t:IsA("Tool") and (t.ToolTip == "Melee" or t.ToolTip == "Sword" or t.ToolTip == "Blox Fruit") then
                    t.Parent = char
                    break
                end
            end
            if not char:FindFirstChildOfClass("Tool") then
                local t = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                if t then t.Parent = char end
            end
        end
    end

    -- Attack loop
    _G.BossFightActive = true
    while _G.AutoFarmBoss or _G.AutoFarmAllBoss or _G.AutoIndra or _G.AutoIceQuest do
        if not boss.Parent or not boss:FindFirstChildOfClass("Humanoid") or (boss:FindFirstChildOfClass("Humanoid") and boss:FindFirstChildOfClass("Humanoid").Health or 0) <= 0 then break end

        local curChar = LocalPlayer.Character
        local hrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
        local hum = curChar and curChar:FindFirstChildOfClass("Humanoid")
        if not curChar or not hrp or not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
            if stopAllTweens then stopAllTweens() end
            if ClearCombatAnchor then ClearCombatAnchor() end
            task.wait(1.5)
            break
        end

        local bHrp = boss:FindFirstChild("HumanoidRootPart")
        if not bHrp then break end

        local targetCF = bHrp.CFrame * CFrame.new(0, 15, 0)
        local dist = (targetCF.Position - hrp.Position).Magnitude

        if dist > 45 then
            TP(targetCF, true)
            task.wait(0.2)
        else
            MaintainCombatAnchor(bHrp.CFrame, 15, boss)
            SmartAttackTarget(boss)
        end

        RunService.Heartbeat:Wait()
    end
    _G.BossFightActive = false
    ClearCombatAnchor()
end

