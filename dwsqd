    local function TP(cf, isAutomation)
        local char = LocalPlayer.Character
        if not char or not char:IsDescendantOf(workspace) then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hrp:IsDescendantOf(workspace) then return end
    
        pcall(function()
            if isAutomation and not isAnyAutomationActive() then return end

            local totalDist = (cf.Position - hrp.Position).Magnitude
            if totalDist < 5 then
                hrp.CFrame = cf
                return
            end

            if _G.ActiveTween and _G.ActiveTweenTarget then
                if (_G.ActiveTweenTarget - cf.Position).Magnitude < 5 then
                    return
                end
                stopAllTweens()
            end
        
            ClearCombatAnchor()
            _G.ActiveTweenTarget = cf.Position

            -- BodyVelocity to negate gravity and external physics impulses
            local bv = hrp:FindFirstChild("Zeles_TP_Velocity") or Instance.new("BodyVelocity")
            bv.Name = "Zeles_TP_Velocity"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Parent = hrp
            _G.ActiveTweenBV = bv

            -- Noclip and zero velocity loop
            local noclipConn = RunService.Stepped:Connect(function()
                if char and char.Parent then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
                if hrp and hrp.Parent then
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                    pcall(function()
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end)
                end
            end)
            _G.ActiveTweenNoclip = noclipConn

            if hum then
                hum.Sit = false
            end

            -- Chunk movement into distance segments with safe micro-pauses for server sync
            local maxSegmentDist = 350
            local currentPos = hrp.Position
            local targetPos = cf.Position

            -- Anti-Water / Raid High Altitude elevation:
            -- If in raid dimension and player is near or below water (Y < 30), immediately boost above water
            if ((CheckInRaid and CheckInRaid()) or _G.AutoRaid) and currentPos.Y < 30 then
                pcall(function()
                    hrp.CFrame = CFrame.new(currentPos.X, 90, currentPos.Z)
                    currentPos = hrp.Position
                end)
            end

            local segments = math.max(1, math.ceil(totalDist / maxSegmentDist))

            local tpSessionId = (_G.TP_SessionId or 0) + 1
            _G.TP_SessionId = tpSessionId

            for seg = 1, segments do
                if _G.TP_SessionId ~= tpSessionId then
                    stopAllTweens()
                    return
                end
                if isAutomation and not isAnyAutomationActive() then
                    stopAllTweens()
                    return
                end
                if _G.CheckGodsChalice and _G.AutoGodsChalice and _G.CheckGodsChalice() then
                    stopAllTweens()
                    return
                end
                if _G.CheckFistOfDarkness and _G.AutoFistOfDarkness and _G.CheckFistOfDarkness() then
                    stopAllTweens()
                    return
                end
                if not hrp or not hrp.Parent then break end

                local alpha = seg / segments
                local segTargetPos = currentPos:Lerp(targetPos, alpha)

                -- Maintain safe flight altitude above ocean/lava in raid dimension (sea level ~0 to -5)
                if (CheckInRaid and CheckInRaid()) or _G.AutoRaid then
                    if seg < segments then
                        local safeAlt = math.max(currentPos.Y, targetPos.Y, 110)
                        segTargetPos = Vector3.new(segTargetPos.X, safeAlt, segTargetPos.Z)
                    end
                end

                local segTargetCF = (seg == segments) and cf or CFrame.new(segTargetPos, targetPos)
                local segDist = (segTargetPos - hrp.Position).Magnitude

                local speed = 217
                local duration = math.max(0.05, segDist / speed)

                local tween = TweenService:Create(
                    hrp,
                    TweenInfo.new(duration, Enum.EasingStyle.Linear),
                    { CFrame = segTargetCF }
                )
                _G.ActiveTween = tween
                tween:Play()

                local completed = false
                local conn
                conn = tween.Completed:Connect(function()
                    completed = true
                    if conn then pcall(function() conn:Disconnect() end) end
                end)

                local startTime = tick()
                while not completed do
                    if _G.TP_SessionId ~= tpSessionId then
                        stopAllTweens()
                        return
                    end
                    if isAutomation and not isAnyAutomationActive() then
                        stopAllTweens()
                        return
                    end
                    if _G.CheckGodsChalice and _G.AutoGodsChalice and _G.CheckGodsChalice() then
                        stopAllTweens()
                        return
                    end
                    if _G.CheckFistOfDarkness and _G.AutoFistOfDarkness and _G.CheckFistOfDarkness() then
                        stopAllTweens()
                        return
                    end
                    if tween.PlaybackState == Enum.PlaybackState.Cancelled or tween.PlaybackState == Enum.PlaybackState.Completed then
                        break
                    end
                    if tick() - startTime > (duration + 1.5) then
                        break
                    end
                    task.wait(0.04)
                end
                if conn then pcall(function() conn:Disconnect() end) end

                if _G.TP_SessionId ~= tpSessionId then
                    stopAllTweens()
                    return
                end

                -- Micro-pause between segments to allow server to confirm physics position and prevent rubberbanding
                if seg < segments then
                    task.wait(0.22)
                end
            end

            _G.ActiveTweenTarget = nil
            if noclipConn then pcall(function() noclipConn:Disconnect() end) end
            _G.ActiveTweenNoclip = nil

            if bv and bv.Parent then
                pcall(function() bv:Destroy() end)
            end
            _G.ActiveTweenBV = nil
            _G.ActiveTween = nil
        end)
    end
