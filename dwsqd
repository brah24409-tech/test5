	-- Search -------------------------------------------------------------------
	local function textHas(value, query)
		return tostring(value or ""):lower():find(query, 1, true) ~= nil
	end
	local function tabHasMatch(tab, query)
		for _, section in ipairs(tab.Sections or {}) do
			if textHas(section.Name, query) then
				return true
			end
			for _, element in ipairs(section.Elements) do
				if textHas(element.Name, query) then
					return true
				end
			end
		end
		return false
	end
	-- Every tab and sub-tab, in sidebar order.
	local function findOtherMatch(query, skip)
		for _, top in ipairs(Window.Tabs) do
			if top ~= skip and tabHasMatch(top, query) then
				return top
			end
			for _, sub in ipairs(top.SubTabs or {}) do
				if sub ~= skip and tabHasMatch(sub, query) then
					return sub
				end
			end
		end
		return nil
	end

	local searchJumping = false
	local function applySearch()
		local tab = Window.ActiveTab
		if not tab then
			return
		end
		local query = searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
		-- Nothing here but a match elsewhere: follow it to that tab.
		if query ~= "" and not searchJumping and not tabHasMatch(tab, query) then
			local target = findOtherMatch(query, tab)
			if target then
				searchJumping = true
				Window:SelectTab(target) -- calls applySearch for the new tab
				searchJumping = false
				return
			end
		end
		for _, section in ipairs(tab.Sections) do
			local sectionMatch = query == "" or textHas(section.Name, query)
			local any = false
			for _, element in ipairs(section.Elements) do
				local visible = query == "" or sectionMatch or textHas(element.Name, query)
				element.Frame.Visible = visible
				any = any or visible
			end
			section.Frame.Visible = any or sectionMatch or #section.Elements == 0 and query == ""
		end
		tab.EmptyLabel.Visible = query ~= "" and (function()
			for _, section in ipairs(tab.Sections) do
				if section.Frame.Visible then
					return false
				end
			end
			return true
		end)()
	end

	Window.ApplySearch = applySearch

	-- Tabs -----------------------------------------------------------------------
	-- Top-level tabs can hold sub-tabs (categories). They fold open beneath their parent on a
	-- tree guide; the parent shows a chevron and stays lit while one of its children is open.
	local TAB_HEIGHT, SUB_HEIGHT, SUB_GAP = COMPACT and 38 or 36, 30, 2
	local GUIDE_X = 20 -- centre of a parent's 17px icon (icon at x=12)
	local SUB_INDENT = 30 -- sub-tab buttons start here, right of the guide

	function Window:SidebarHeading(text)
