            local currentIsland = workspace._WorldOrigin:FindFirstChild("Locations") and workspace._WorldOrigin.Locations:FindFirstChild("Island " .. currentIslandIndex)
            local islandPos = currentIsland and currentIsland.Position

            local nearestEnemy = nil
            local nearestDist = math.huge

            -- Search enemies within current raid island vicinity
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                local hum = v:FindFirstChildOfClass("Humanoid")
                local eHrp = v:FindFirstChild("HumanoidRootPart")
                if hum and eHrp and (hum.Health or 0) > 0 then
                    local enemyPos = eHrp.Position
                    local isTargetable = false
                    if islandPos then
                        if math.abs(enemyPos.Y - islandPos.Y) <= 600 and (enemyPos - islandPos).Magnitude <= 1500 then
                            isTargetable = true
                        end
                    else
                        if (enemyPos - myHrp.Position).Magnitude <= 1500 then
                            isTargetable = true
                        end
                    end

                    if isTargetable then
                        local dist = (enemyPos - myHrp.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearestEnemy = v
                        end
                    end
                end
            end

            return nearestEnemy
        end

        local function getRaidIslandSafeCFrame(islandIndex)
            local locs = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
            local loc = locs and locs:FindFirstChild("Island " .. islandIndex)
            if not loc then return nil end

            local x = loc.Position.X
            local z = loc.Position.Z

            -- Raycast downward from high altitude to find the real physical surface of this island
            local rayOrigin = Vector3.new(x, 350, z)
            local rayDirection = Vector3.new(0, -600, 0)
            local raycastParams = RaycastParams.new()
            local lp = game:GetService("Players").LocalPlayer
            if lp and lp.Character then
                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                raycastParams.FilterDescendantsInstances = {lp.Character}
            end
            local hit = workspace:Raycast(rayOrigin, rayDirection, raycastParams)

            local groundY = nil
            if hit and hit.Position.Y > 0 then
                groundY = hit.Position.Y
            else
                -- Fallback: check nearby enemies to sample actual island walking height
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    local eHrp = enemy:FindFirstChild("HumanoidRootPart")
                    if eHrp and (Vector3.new(eHrp.Position.X, 0, eHrp.Position.Z) - Vector3.new(x, 0, z)).Magnitude < 400 then
                        if eHrp.Position.Y > 15 then
                            groundY = eHrp.Position.Y
                            break
                        end
                    end
                end
                groundY = groundY or math.max(loc.Position.Y, 35)
            end

            -- Ensure we hover 40 studs above true island surface, clamped to at least Y = 65
            local safeY = math.max(groundY + 40, 65)
            return CFrame.new(x, safeY, z)
        end

