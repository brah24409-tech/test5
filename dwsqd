			Name = "Re-execute on teleport",Description = "Loads the hub again after a rejoin or server hop",
			Flag = "ui_reexecute",
			Callback = function(value)
				if value and not queued then
					queued = true
					pcall(queueOnTeleport, opts.Reexecute)
				end
			end,
		})
	end
	interface:Divider()
	interface:Button({
		Name = "Close hub",Confirm = true, ConfirmText = "Click again to close",
		Callback = function()
			self:Unload()
		end,
	})

	-- Configs --------------------------------------------------------------------------
	local configs = tab:Section({ Name = "Configs",Side = "Left" })
	if not FS.available then
		configs:Label({ Name = "File system unavailable" })
	else
		local nameInput = configs:Input({ Name = "Config name",Placeholder = "e.g. main", MaxLength = 32 })
		local list = configs:Dropdown({ Name = "Saved configs",Options = self:ListConfigs(), AllowNone = true })
		local autoloadLabel = configs:Label({ Name = "Autoload", Value = self:GetAutoload() or "None" })
		local function refresh()
			list:Refresh(self:ListConfigs(), true)
			autoloadLabel:Set(self:GetAutoload() or "None")
		end
		configs:Button({
			Name = "Save",Style = "Primary",
			Callback = function()
				local name = nameInput:Get()
				if name == "" then
					name = list:Get() or ""
				end
				local ok, err = self:SaveConfig(name)
				notify(ok and "Config saved" or "Could not save", ok and name or tostring(err), ok and "success" or "error")
				refresh()
			end,
		})
		configs:Button({
			Name = "Load",
			Callback = function()
				local name = list:Get()
				if not name then
					notify("Select a config first", nil, "warning")
					return
				end
				local ok, err = self:LoadConfig(name)
				notify(ok and "Config loaded" or "Could not load", ok and name or tostring(err), ok and "success" or "error")
			end,
		})
		configs:Button({
			Name = "Delete",Style = "Danger", Confirm = true, ConfirmText = "Click again to delete",
			Callback = function()
				local name = list:Get()
				if not name then
					notify("Select a config first", nil, "warning")
					return
				end
				local ok = self:DeleteConfig(name)
				if ok and self:GetAutoload() == name then
					self:SetAutoload("")
				end
				notify(ok and "Config deleted" or "Could not delete", name, ok and "success" or "error")
				refresh()
			end,
		})
		configs:Button({
			Name = "Set as autoload",
			Callback = function()
				local name = list:Get()
				self:SetAutoload(name or "")
				notify("Autoload", name and (name .. " loads on start") or "Autoload cleared")
				refresh()
			end,
		})
		configs:Button({ Name = "Refresh list",Callback = refresh })
		local autoload = self:GetAutoload()
		if autoload then
			task.delay(0.5, function()
				if not self.Unloaded and self:LoadConfig(autoload) then
					notify("Autoloaded config", autoload, "success")
				end
			end)
		end
	end

	-- Theme ----------------------------------------------------------------------------
	-- NOTE (removed on purpose): the Theme section (presets, gradient colours, tint, roundness,
	-- reset) is switched off and the UI always runs the Noir theme.
	-- TO ADD IT BACK:
	--   1. Uncomment the line below.
	--   2. In the "Restore the last theme" block further up, change `if false and FS.available then`
	--      back to `if FS.available then` so a saved theme loads again.
	-- The Theme section code itself (Library:AddThemeSection) is untouched.
	-- self:AddThemeSection(tab, "Right")

	-- Server ---------------------------------------------------------------------------
	local server = tab:Section({ Name = "Server",Side = "Right" })
	local playersLabel = server:Label({ Name = "Players", Value = "-" })
	local uptimeLabel = server:Label({ Name = "Server uptime", Value = "-" })
	task.spawn(function()
		while not self.Unloaded do
			playersLabel:Set(#Players:GetPlayers() .. " / " .. Players.MaxPlayers)
			local t = math.floor(Workspace.DistributedGameTime)
			uptimeLabel:Set(string.format("%dh %02dm", t // 3600, (t % 3600) // 60))
			task.wait(2)
		end
	end)
	server:Button({
		Name = "Rejoin",
		Callback = function()
			if #Players:GetPlayers() <= 1 then
				TeleportService:Teleport(game.PlaceId, LocalPlayer)
			else
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
			end
		end,
	})
	local function fetchServers()
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
		local ok, body = pcall(function()
			if httpRequest then
				local response = httpRequest({ Url = url, Method = "GET" })
                if type(response) ~= "table" then error("Invalid HTTP response") end
                local status = tonumber(response.StatusCode or response.status_code or response.Status or response.status)
                if status and (status < 200 or status >= 300) then error("HTTP request failed") end
                local body = response.Body or response.body
                if type(body) ~= "string" then error("HTTP response body unavailable") end
                return body
			end
			return game:HttpGet(url)
		end)
		if not ok or type(body) ~= "string" then
			return nil
		end
		local decoded, data = pcall(HttpService.JSONDecode, HttpService, body)
		return decoded and type(data) == "table" and data.data or nil
	end
	local function hop(pick)
		local servers = fetchServers()
		if not servers then
			notify("Server hop", "Could not reach the server list.", "error")
			return
		end
		local candidates = {}
		for _, s in ipairs(servers) do
			if s.id ~= game.JobId and tonumber(s.playing) and tonumber(s.maxPlayers) and s.playing < s.maxPlayers then
				table.insert(candidates, s)
			end
		end
		if #candidates == 0 then
			notify("Server hop", "No other server with free slots.", "warning")
			return
		end
		local target = pick(candidates)
		notify("Server hop", "Joining a server with " .. target.playing .. " players...")
		TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, LocalPlayer)
	end
	server:Button({
		Name = "Server hop",Style = "Primary",
		Callback = function()
			task.spawn(hop, function(list)
				return list[math.random(1, #list)]
			end)
		end,
	})
	server:Button({
		Name = "Smallest server",
		Callback = function()
			task.spawn(hop, function(list)
				table.sort(list, function(a, b)
					return a.playing < b.playing
				end)
				return list[1]
			end)
		end,
	})
	server:Button({ Name = "Copy JobId",Callback = function() copy(game.JobId, "JobId") end })
	server:Button({
		Name = "Copy join script",
		Callback = function()
			copy(string.format('game:GetService("TeleportService"):TeleportToPlaceInstance(%d, "%s")', game.PlaceId, game.JobId), "Join script")
		end,
	})

	-- Performance ----------------------------------------------------------------------
	local perf = tab:Section({ Name = "Performance",Side = "Left" })
	if setfpscap then
		local original = getfpscap and getfpscap() or 60
		local unlocked, cap = false, 144
		local function applyCap()
			pcall(setfpscap, unlocked and 0 or cap)
		end
		perf:Toggle({ Name = "Unlock FPS",Flag = "perf_unlock", Callback = function(value) unlocked = value applyCap() end })
		perf:Slider({ Name = "FPS cap",Min = 30, Max = 360, Increment = 10, Default = 144, Flag = "perf_cap", Callback = function(value) cap = value if not unlocked then applyCap() end end })
		self:OnUnload(function()
			pcall(setfpscap, original)
		end)
	end

	-- Low graphics: shadows, fog, particles, decals/textures. Originals are kept and put back.
	local saved = {}
	local lowOn = false
	local function lowGraphics(on)
		lowOn = on
		if on then
			saved.GlobalShadows = Lighting.GlobalShadows
			saved.FogEnd = Lighting.FogEnd
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 1e9
			saved.objects = {}
			for _, object in ipairs(Workspace:GetDescendants()) do
				if object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Smoke") or object:IsA("Fire") or object:IsA("Sparkles") then
					if object.Enabled then
						saved.objects[object] = "Enabled"
						object.Enabled = false
					end
				elseif object:IsA("Decal") or object:IsA("Texture") then
					if object.Transparency < 1 then
						saved.objects[object] = object.Transparency
						object.Transparency = 1
					end
				end
			end
			for _, effect in ipairs(Lighting:GetChildren()) do
				if effect:IsA("PostEffect") and effect.Enabled then
					saved.objects[effect] = "Enabled"
					effect.Enabled = false
				end
			end
		elseif saved.objects then
			Lighting.GlobalShadows = saved.GlobalShadows
			Lighting.FogEnd = saved.FogEnd
			for object, value in pairs(saved.objects) do
				if object.Parent then
					if value == "Enabled" then
						object.Enabled = true
					else
						object.Transparency = value
					end
				end
			end
			saved.objects = nil
		end
	end
	perf:Toggle({ Name = "Low graphics",Description = "No shadows, fog, particles or textures", Flag = "perf_low", Callback = lowGraphics })
	self:OnUnload(function()
		if lowOn then
			lowGraphics(false)
		end
	end)

	local antiAfk = false
	local VirtualUser = game:GetService("VirtualUser")
	Connect(LocalPlayer.Idled, function()
		if antiAfk then
			pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.zero)
			end)
		end
	end)
	perf:Toggle({ Name = "Anti-AFK",Description = "Never get kicked for idling", Default = true, Flag = "perf_antiafk", Callback = function(value) antiAfk = value end })

	local executor = "Unknown"
	if identifyexecutor then
		local ok, name, version = pcall(identifyexecutor)
		if ok and name then
			executor = tostring(name) .. (version and (" " .. tostring(version)) or "")
		end
	end
	perf:Label({ Name = "Executor", Value = executor })
end

--// Unload ----------------------------------------------------------------------------

function Library:Unload()
	if self.Unloaded then
		return
	end
	self.Unloaded = true
	capturedPointer = nil
	for _, callback in ipairs(self._unloadCallbacks) do
		pcall(callback)
	end
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	ScreenGui:Destroy()
	if ENV.NOIR_UNLOAD then
		ENV.NOIR_UNLOAD = nil
	end
end

ENV.NOIR_UNLOAD = function()
	Library:Unload()
end
ENV.NOIR = Library

return Library

end


local function ZelesSplash(opts)
    opts = opts or {}
    local TweenService = game:GetService("TweenService")
    local RunService   = game:GetService("RunService")
    local Players      = game:GetService("Players")

    -- NOIR monochrome palette (matches the interface that opens after this).
    local C = {
        Bg      = Color3.fromRGB(11, 11, 12),
        Disc    = Color3.fromRGB(26, 26, 29),
        Accent  = Color3.fromRGB(245, 245, 247),
        Glass   = Color3.fromRGB(222, 222, 226),
        Accent2 = Color3.fromRGB(161, 161, 168),
        Track   = Color3.fromRGB(29, 29, 32),
        Faint   = Color3.fromRGB(161, 161, 168),
        Deep    = Color3.fromRGB(46, 46, 52),
        Void    = Color3.fromRGB(14, 14, 16),
    }

    local function N(class, props)
        local inst = Instance.new(class)
        for k, v in pairs(props) do
            if k ~= "Parent" then inst[k] = v end
        end
        if props.Parent then inst.Parent = props.Parent end
        return inst
    end
    local function round(inst, r)
        N("UICorner", { CornerRadius = r == "full" and UDim.new(1, 0) or UDim.new(0, r or 4), Parent = inst })
    end
    local function tween(inst, dur, props, style, dir)
        local t = TweenService:Create(inst, TweenInfo.new(dur, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
        t:Play()
        return t
    end
    local function seq(colors)
        local kps = {}
        for i, c in ipairs(colors) do
            kps[#kps + 1] = ColorSequenceKeypoint.new((i - 1) / math.max(#colors - 1, 1), c)
        end
        return ColorSequence.new(kps)
    end

    local textFont = opts.Font or Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.SemiBold)

    local gui = N("ScreenGui", {
        Name = "ZelesHubSplash", IgnoreGuiInset = true, ResetOnSpawn = false,
        DisplayOrder = 100000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    do
        local parent
        local ok, ui = pcall(function() return gethui and gethui() end)
        if ok and ui then parent = ui end
        if not parent then
            ok, ui = pcall(function() return game:GetService("CoreGui") end)
            if ok and ui then parent = ui end
        end
        gui.Parent = parent or Players.LocalPlayer:WaitForChild("PlayerGui")
    end

    local function factor()
        local cam = workspace.CurrentCamera
        local h = cam and cam.ViewportSize.Y or 720
        return math.clamp(h / 720, 0.7, 1.5)
    end

    ----------------------------------------------------------------
    -- Backdrop: stacked translucent discs fake a radial gradient
    ----------------------------------------------------------------
    local backdrop = N("Frame", {
        Name = "Splash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Bg,
        BorderSizePixel = 0, ZIndex = 800, Parent = gui,
    })
    for i = 1, 26 do
        local disc = N("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45),
            Size = UDim2.fromScale(1.3 * i / 26, 1.3 * i / 26), BackgroundColor3 = C.Disc,
            BackgroundTransparency = 1 - 0.14 * (1 - (i - 1) / 26), BorderSizePixel = 0,
            ZIndex = 800, Parent = backdrop,
        })
        round(disc, "full")
        N("UIAspectRatioConstraint", { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Width, Parent = disc })
    end

    local box = N("Frame", {
        Name = "Box", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(320, 200), BackgroundTransparency = 1, ZIndex = 801, Parent = backdrop,
    })
    local scale = N("UIScale", { Scale = factor() * 0.96, Parent = box })

    ----------------------------------------------------------------
    -- Brand title, progress bar, status line
    ----------------------------------------------------------------
    local spaced = string.upper(opts.Title or "ZELES HUB"):gsub(".", "%0 "):gsub("%s+$", "")
    local brandHome = UDim2.new(0.5, 0, 0, 62)
    local function brandLabel(z, color)
        return N("TextLabel", {
            BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
            Position = brandHome + UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 40), Text = spaced,
            FontFace = textFont, TextSize = 26, TextColor3 = color, TextTransparency = 1,
            ZIndex = z, Parent = box,
        })
    end
    local brand = brandLabel(805, Color3.new(1, 1, 1))

    local track = N("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 118),
        Size = UDim2.fromOffset(260, 3), BackgroundColor3 = C.Track, BorderSizePixel = 0,
        ZIndex = 803, Parent = box,
    })
    round(track, "full")
    local bar = N("Frame", {
        Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        ZIndex = 804, Parent = track,
    })
    round(bar, "full")
    N("UIGradient", { Color = seq({ C.Accent2, C.Glass, C.Accent }), Parent = bar })

    local status = N("TextLabel", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 134),
        Size = UDim2.new(1, 0, 0, 14), Text = string.lower(opts.Subtitle or "loading"),
        FontFace = textFont, TextSize = 11, TextColor3 = C.Faint, ZIndex = 803, Parent = box,
    })

    -- Entrance
    tween(scale, 0.6, { Scale = factor() }, Enum.EasingStyle.Exponential)
    task.delay(0.25, function()
        if not gui.Parent then return end
        local info = TweenInfo.new(0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        TweenService:Create(brand, info, { TextTransparency = 0, Position = brandHome }):Play()
    end)

    ----------------------------------------------------------------
    -- Controller
    ----------------------------------------------------------------
    local obj = { Instance = gui, Progress = 0, Done = false }
    local startedAt = os.clock()

    function obj:SetProgress(value, text)
        obj.Progress = math.max(obj.Progress or 0, math.clamp(value or 0, 0, 1))
        tween(bar, 0.3, { Size = UDim2.fromScale(obj.Progress, 1) })
        if text then status.Text = string.lower(text) end
    end

    function obj:Finish(onClosed)
        if obj.Done then return end
        obj.Done = true

        local wait0 = math.max((opts.MinDuration or 0) - (os.clock() - startedAt), 0)
        tween(bar, math.max(wait0, 0.2), { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Linear)
        status.Text = "ready"

        task.spawn(function()
            if wait0 > 0 then task.wait(wait0) end
            task.wait(0.2)

            task.wait(0.15)
            tween(backdrop, 0.35, { BackgroundTransparency = 1 })
            tween(scale, 0.35, { Scale = factor() * 1.04 })
            for _, d in ipairs(backdrop:GetDescendants()) do
                if d:IsA("TextLabel") then
                    tween(d, 0.25, { TextTransparency = 1 })
                elseif d:IsA("Frame") and d ~= backdrop then
                    tween(d, 0.25, { BackgroundTransparency = 1 })
                elseif d:IsA("UIStroke") then
                    tween(d, 0.25, { Transparency = 1 })
                end
            end
            -- The interface fades in as the splash fades out.
            if onClosed then pcall(onClosed) end
            task.wait(0.4)
            gui:Destroy()
        end)
    end

    -- Auto-advancing status steps (the real work happens while these play).
    if opts.Steps and #opts.Steps > 0 then
        local duration = math.max(opts.Duration or 2.4, opts.MinDuration or 0)
        task.spawn(function()
            for i, step in ipairs(opts.Steps) do
                if obj.Done then return end
                obj:SetProgress(i / #opts.Steps * 0.9, step)
                task.wait(duration / #opts.Steps)
            end
        end)
    end

    return obj
end

