    local function doJungleStar1()
            Notify("Jungle Star 1", "Starting Zipline Challenge...", 4)
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            -- 1. Locate and pick up Grappling Hook from ground if not in inventory
            local p = LocalPlayer
            local hasHook = (p.Character and (p.Character:FindFirstChild("Grappling Hook") or p.Character:FindFirstChild("Tool"))) or
                            (p.Backpack and (p.Backpack:FindFirstChild("Grappling Hook") or p.Backpack:FindFirstChild("Tool")))
            
            if not hasHook then
                local hook = workspace:FindFirstChild("GroundPickupGrapplingHook")
                if not hook then
                    for _, obj in ipairs(workspace:GetChildren()) do
                        if obj.Name:lower():find("grappling") or obj.Name:lower():find("hook") then
                            hook = obj
                            break
                        end
                    end
                end

                if hook then
                    local hookPrompt = hook:FindFirstChildWhichIsA("ProximityPrompt", true)
                    local hookPart = hook:FindFirstChildWhichIsA("BasePart", true) or (hook:IsA("BasePart") and hook)
                    if hookPart then
                        TP(hookPart.CFrame + Vector3.new(0, 3, 0), true)
                        task.wait(0.4)
                        if hookPrompt then
                            pcall(function() fireproximityprompt(hookPrompt) end)
                        end
                        task.wait(0.5)
                    end
                end
            end

            -- 2. Detect starting zipline (ishowspeedlover41 location: -1279.33, 74.41, -247.56)
            local sourcePos = Vector3.new(-1279.33, 74.41, -247.56)
            local targetPos = Vector3.new(-1482.84, 78.08, -15.26)

            -- If player ishowspeedlover41 is in server, use their exact live position
            local refPlayer = game:GetService("Players"):FindFirstChild("ishowspeedlover41")
            if refPlayer and refPlayer.Character and refPlayer.Character:FindFirstChild("HumanoidRootPart") then
                sourcePos = refPlayer.Character.HumanoidRootPart.Position
            end

            -- 3. Teleport onto the starting zipline platform
            TP(CFrame.new(sourcePos.X, sourcePos.Y + 1.5, sourcePos.Z), true)
            task.wait(0.4)

            -- 4. Equip the Grappling Hook
            local hookTool = p.Character:FindFirstChild("Grappling Hook") or p.Character:FindFirstChild("Tool") or
                             p.Backpack:FindFirstChild("Grappling Hook") or p.Backpack:FindFirstChild("Tool")
            if hookTool and hookTool.Parent ~= p.Character and p.Character:FindFirstChild("Humanoid") then
                p.Character.Humanoid:EquipTool(hookTool)
            elseif equipItem then
                equipItem("Grappling Hook")
                equipItem("Tool")
            end
            task.wait(0.4)

            -- 5. Orient player & camera towards the opposite target platform
            local cam = workspace.CurrentCamera
            if cam and hrp then
                cam.CFrame = CFrame.new(cam.CFrame.Position, targetPos)
                hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z))
            end
            task.wait(0.2)

            -- 6. Charge and launch grappling hook across to target
            local vim = game:GetService("VirtualInputManager")
            if vim and cam then
                local viewport = cam.ViewportSize
                local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
                vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
                task.wait(1.2) -- hold to charge
                vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
            end
            task.wait(1.0)

            -- 7. Interact / Ride zipline across to opposite platform
            local zp = nil
            pcall(function()
                local parts = hrp and workspace:GetPartBoundsInRadius(hrp.Position, 40) or {}
                for _, p in ipairs(parts) do
                    local pp = p:FindFirstChildWhichIsA("ProximityPrompt", true) or (p.Parent and p.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
                    if pp then zp = pp.Parent break end
                end
            end)
            if zp then
                for _, pPrompt in ipairs(zp:GetDescendants()) do
                    if pPrompt:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(pPrompt) end)
                    end
                end
            end
            task.wait(0.4)
            TP(CFrame.new(targetPos.X, targetPos.Y + 2.5, targetPos.Z), true)
            task.wait(0.5)

            -- 8. Talk to Quest Giver NPC to claim Star 1 + 4 levels
            turnInJungleQuestGiver()
            Notify("Jungle Star 1", "Star 1 Completed! (+4 Levels claimed)", 5)
    end

    local function doJungleStar2()
            task.wait(0.5)
            local Players = game:GetService("Players")
            local LocalPlayer = Players.LocalPlayer
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart")
            local hum = char:WaitForChild("Humanoid")
            local vim = game:GetService("VirtualInputManager")
            local vu = game:GetService("VirtualUser")
            local cam = workspace.CurrentCamera

            local function equipCombat()
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool or (tool.Name ~= "Electric Claw" and tool.Name ~= "Combat" and tool.Name ~= "Yama") then
                    local melee = LocalPlayer.Backpack:FindFirstChild("Electric Claw") or LocalPlayer.Backpack:FindFirstChild("Combat") or LocalPlayer.Backpack:FindFirstChild("Yama") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                    if melee and hum then
                        hum:EquipTool(melee)
                        task.wait(0.2)
                    end
                end
            end

            local function getMonkeyThiefMob(treePos)
                local enemyFolders = {workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Characters"), workspace}
                local candidates = {}
                for _, folder in ipairs(enemyFolders) do
                    if folder then
                        for _, mob in ipairs(folder:GetChildren()) do
                            if mob:IsA("Model") and not Players:GetPlayerFromCharacter(mob) then
                                local mHum = mob:FindFirstChildOfClass("Humanoid")
                                local mHrp = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head") or mob:FindFirstChildWhichIsA("BasePart")
                                if mHum and mHum.Health > 0 and mHrp then
                                    local mName = mob.Name:lower()
                                    if mName:find("thief") or mName:find("monkey") or mName:find("gorilla") then
                                        local dist = treePos and (mHrp.Position - treePos).Magnitude or 0
                                        table.insert(candidates, {mob = mob, dist = dist, isThiefName = (mName:find("thief") ~= nil)})
                                    end
                                end
                            end
                        end
                    end
                end
                
                -- Sort by thief name first, then by distance to tree
                table.sort(candidates, function(a, b)
                    if a.isThiefName ~= b.isThiefName then
                        return a.isThiefName
                    end
                    return a.dist < b.dist
                end)

                if #candidates > 0 then
                    if treePos then
                        -- If within 50 studs of target tree or named thief
                        if candidates[1].isThiefName or candidates[1].dist <= 50 then
                            return candidates[1].mob
                        end
                    else
                        return candidates[1].mob
                    end
                end
                return nil
            end

            local function hasAdventurerHat()
                local containers = {LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character}
                for _, container in ipairs(containers) do
                    if container then
                        for _, item in ipairs(container:GetChildren()) do
                            if item:IsA("Tool") or item:IsA("Accessory") then
                                local iName = item.Name:lower()
                                if iName:find("hat") or iName:find("adventurer") then
                                    return true
                                end
                            end
                        end
                    end
                end
                return false
            end

            local function findFootprintTargetTree()
                local jungle = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Jungle")
                local footstepsObj = jungle and jungle:FindFirstChild("MonkeyThiefFootsteps")

                if not footstepsObj then
                    return nil
                end

                local lastFootprintPos = nil
                local footprints = {}
                for _, child in ipairs(footstepsObj:GetChildren()) do
                    if child:IsA("BasePart") then
                        table.insert(footprints, child)
                    end
                end
                table.sort(footprints, function(a, b)
                    local numA = tonumber(a.Name:match("%d+")) or 0
                    local numB = tonumber(b.Name:match("%d+")) or 0
                    return numA > numB
                end)
                if #footprints > 0 then
                    lastFootprintPos = footprints[1].Position
                end

                if lastFootprintPos and jungle and jungle:FindFirstChild("BananaTrees") then
                    local nearestTree = nil
                    local minDist = math.huge
                    for _, tree in ipairs(jungle.BananaTrees:GetChildren()) do
                        local tPos = tree:IsA("BasePart") and tree.Position or (tree:IsA("Model") and tree:GetPivot().Position)
                        if tPos then
                            local dist = (tPos - lastFootprintPos).Magnitude
                            if dist < minDist then
                                minDist = dist
                                nearestTree = tree
                            end
                        end
                    end
                    if nearestTree then
                        return nearestTree:IsA("BasePart") and nearestTree.CFrame or nearestTree:GetPivot()
                    end
                end

                if lastFootprintPos then
                    return CFrame.new(lastFootprintPos + Vector3.new(0, 3, 0))
                end

                return nil
            end

            local function punchTreeSpot(treeCF, duration)
                equipCombat()
                local standCF = CFrame.new(treeCF.Position + Vector3.new(0, 2, 0) - (treeCF.LookVector * 3), treeCF.Position)
                TP(standCF, true)
                task.wait(0.3)

                local pStart = tick()
                while (tick() - pStart) < (duration or 15) do
                    local monkey = getMonkeyThiefMob(treeCF.Position)
                    if monkey then 
                        Notify("Jungle Star 2", "Monkey Thief detected! Engaging in combat...", 3)
                        return monkey 
                    end

                    hrp.CFrame = standCF
                    if cam then
                        cam.CFrame = CFrame.new(cam.CFrame.Position, treeCF.Position)
                    end

                    if mouse1click then pcall(mouse1click) end
                    if vu and cam then
                        local vp = cam.ViewportSize
                        vu:CaptureController()
                        vu:Button1Down(Vector2.new(vp.X / 2, vp.Y / 2), cam.CFrame)
                        task.wait(0.02)
                        vu:Button1Up(Vector2.new(vp.X / 2, vp.Y / 2), cam.CFrame)
                    end
                    if vim and cam then
                        local vp = cam.ViewportSize
                        vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 1)
                        task.wait(0.02)
                        vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 1)
                    end
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then pcall(function() tool:Activate() end) end

                    pcall(function()
                        local net = game:GetService("ReplicatedStorage"):FindFirstChild("Modules") and game:GetService("ReplicatedStorage").Modules:FindFirstChild("Net")
                        if net and net:FindFirstChild("RE/RegisterAttack") then
                            net["RE/RegisterAttack"]:FireServer(0)
                        end
                    end)

                    task.wait(0.1)
                end
                return getMonkeyThiefMob(treeCF.Position)
            end

            -- 1. Check if monkey thief is already spawned
            local targetTreeCF = findFootprintTargetTree()
            local treePos = targetTreeCF and targetTreeCF.Position or nil
            local monkey = getMonkeyThiefMob(treePos)

            -- 2. Locate tree via Footstep Trail in workspace.Map.Jungle & Punch Tree
            if not monkey then
                if targetTreeCF then
                    Notify("Jungle Star 2", "Footstep trail located! Punching target banana tree...", 4)
                    monkey = punchTreeSpot(targetTreeCF, 15)
                else
                    Notify("Jungle Star 2", "Footsteps not active in Jungle! Rumor is on cooldown or inactive on this server.", 4)
                    return
                end
            end

            local lastMonkeyPos = treePos or hrp.Position

            -- 3. Slay Monkey Thief with SmartAttack
            if monkey and (monkey:FindFirstChild("HumanoidRootPart") or monkey:FindFirstChild("Head") or monkey:FindFirstChildWhichIsA("BasePart")) then
                Notify("Jungle Star 2", "Slaying Monkey Thief...", 4)
                local mHrp = monkey:FindFirstChild("HumanoidRootPart") or monkey:FindFirstChild("Head") or monkey:FindFirstChildWhichIsA("BasePart")
                local mHum = monkey:FindFirstChildOfClass("Humanoid")
                
                while monkey and monkey.Parent and mHum and mHum.Health > 0 do
                    if mHrp and mHrp.Parent then
                        lastMonkeyPos = mHrp.Position
                        hrp.CFrame = mHrp.CFrame * CFrame.new(0, 8, 0)
                        hrp.Velocity = Vector3.new(0, 0, 0)
                    end

                    equipCombat()
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then pcall(function() tool:Activate() end) end

                    if _G.SmartAttackTarget then
                        _G.SmartAttackTarget(monkey)
                    elseif SmartAttackTarget then
                        SmartAttackTarget(monkey)
                    else
                        pcall(function()
                            local net = game:GetService("ReplicatedStorage").Modules.Net
                            net["RE/RegisterAttack"]:FireServer(0)
                            net["RE/RegisterHit"]:FireServer(monkey:FindFirstChild("Head") or mHrp, {}, tostring(LocalPlayer.UserId))
                        end)
                    end
                    task.wait(0.08)
                end
