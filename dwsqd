-- Detect which skills are currently unlocked for the equipped weapon
local function GetUnlockedSkills(tool)
    local unlocked = {}
    if not tool then return unlocked end
    
    local toolLevel = tool:FindFirstChild("Level") and tool.Level.Value or 0
    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
    local skillsFrame = pgui and pgui:FindFirstChild("Main") and pgui.Main:FindFirstChild("Skills")
    local toolSkillGui = skillsFrame and skillsFrame:FindFirstChild(tool.Name)

    local candidateKeys = {"Z", "X", "C", "V", "F"}
    if _G.SelectedMasterySkill == "Gun" or _G.SelectedMasterySkill == "Sword" then
        candidateKeys = {"Z", "X"}
    end

    for _, key in ipairs(candidateKeys) do
        local isUnlocked = true
        if toolSkillGui then
            local keyFrame = toolSkillGui:FindFirstChild(key)
            if keyFrame then
                local title = keyFrame:FindFirstChild("Title")
                if title and title:IsA("TextLabel") then
                    -- If color is dimmed grey (R < 0.6), the ability is locked
                    if title.TextColor3.R < 0.6 and title.TextColor3.G < 0.6 and title.TextColor3.B < 0.6 then
                        isUnlocked = false
                    end
                end
                local lvlLabel = keyFrame:FindFirstChild("Level")
                if lvlLabel and lvlLabel:IsA("TextLabel") then
                    local req = tonumber(lvlLabel.Text:match("%d+"))
                    if req and toolLevel < req then
                        isUnlocked = false
                    end
                end
            else
                isUnlocked = false
            end
        end
        if isUnlocked then
            table.insert(unlocked, key)
        end
    end
    return unlocked
end

