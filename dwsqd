-- Global Search & Highlight helper for navigation buttons
_G.SearchAndHighlight = function(targetName)
    local query = tostring(targetName or ""):lower()
    if query:find("language") or query:find("idioma") or query:find("langue") then
        if _G.ZelesTabsByName and _G.ZelesTabsByName["Settings"] and _G.ZelesUI and _G.ZelesUI.NoirWindow then
            pcall(function() _G.ZelesUI.NoirWindow:SelectTab(_G.ZelesTabsByName["Settings"]) end)
            return true
        end
    end
    if _G.ZelesTabsByName and _G.ZelesUI and _G.ZelesUI.NoirWindow then
        for tName, tObj in pairs(_G.ZelesTabsByName) do
            if tName:lower():find(query, 1, true) then
                pcall(function() _G.ZelesUI.NoirWindow:SelectTab(tObj) end)
                return true
            end
        end
    end
    return false
end
