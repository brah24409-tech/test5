local Sea3FishingSpot = CFrame.new(-16096.432, 14.749, 499.589) * CFrame.Angles(-0.000, -1.552, -0.000)

local function tweenToSea3FishingSpot()
    local pId = game.PlaceId
    local isSea3Map = (pId == 7449423635 or pId == 100117331123089)
    if not isSea3Map and _G.SEA3_IDS then
        for _, id in ipairs(_G.SEA3_IDS) do
            if pId == id then isSea3Map = true break end
        end
    end
    if not isSea3Map and isSea3 then
        pcall(function() if isSea3() then isSea3Map = true end end)
    end

    if not isSea3Map then
        OrionLib:MakeNotification({
            Name = "Fishing Location",
            Content = "Sea 3 Fishing Spot is only available in Sea 3!",
            Time = 4
        })
        return false
    end

    local lp = game:GetService("Players").LocalPlayer
    local char = lp and lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        if TP then
            TP(Sea3FishingSpot)
        else
            local ts = game:GetService("TweenService")
            local dist = (Sea3FishingSpot.Position - hrp.Position).Magnitude
            local duration = math.max(0.5, dist / 350)
            local tw = ts:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = Sea3FishingSpot})
            tw:Play()
        end
        return true
    end
    return false
end

local function getFishingRodTool()
    local lp = game:GetService("Players").LocalPlayer
    if not lp then return nil end
    
    -- Check character first
    if lp.Character then
        for _, item in ipairs(lp.Character:GetChildren()) do
            if item:IsA("Tool") and item.Name:lower():find("rod") then
                return item
            end
        end
    end
    
    -- Check backpack
    if lp:FindFirstChild("Backpack") then
        for _, item in ipairs(lp.Backpack:GetChildren()) do
            if item:IsA("Tool") and item.Name:lower():find("rod") then
                return item
            end
        end
    end
    
    return nil
end

local function startAutoFishingWorker()
    if not _G.AutoFish then return end
        task.spawn(function()
            local lp = game:GetService("Players").LocalPlayer
            local vu = game:GetService("VirtualUser")
            local vim = game:GetService("VirtualInputManager")
            local repStorage = game:GetService("ReplicatedStorage")
            
            -- Ensure Blox Fruits FishingGui UI Screen is initialized
            pcall(function()
                if repStorage:FindFirstChild("FishReplicated") and repStorage.FishReplicated:FindFirstChild("FishingClient") and repStorage.FishReplicated.FishingClient:FindFirstChild("UI") then
                    require(repStorage.FishReplicated.FishingClient.UI)
                end
            end)
            
            -- Executor Mouse Input Helpers
            local mPress = mouse1press or mouserepress or function() end
            local mRelease = mouse1release or mouserelease or function() end
            local mClick = mouse1click or clickmouse or function() end
            
            local function getCenter()
                local cam = workspace.CurrentCamera
                if cam and cam.ViewportSize then
                    return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
                end
                return Vector2.new(960, 540)
            end
            
            -- Hook Blox Fruits Minigame Controller for authentic 100% precision fish tracking
            pcall(function()
                local cm = require(repStorage.FishReplicated.FishingClient.Components.CatchingMinigame)
                if cm and cm.__state and cm.__state.Controller then
                    if not _G.OriginalFishingIsReeling then
                        _G.OriginalFishingIsReeling = cm.__state.Controller.IsReeling
                    end
                    cm.__state.Controller.IsReeling = function(self)
                        if _G.AutoFish and not _G.AutoFishInstantReel and _G.AutoFishMinigameAutopilot then
                            local userReeling = false
                            if _G.OriginalFishingIsReeling then
                                pcall(function() userReeling = _G.OriginalFishingIsReeling(self) end)
                            end
                            if userReeling then
                                return true
                            end

                            local st = cm.__state
                            if st and st.fishPos and st.playerPos then
                                return st.playerPos < st.fishPos
                            end
                        end
                        if _G.OriginalFishingIsReeling then
                            return _G.OriginalFishingIsReeling(self)
                        end
                        return false
                    end
                end
            end)

            local function pressDown()
                local center = getCenter()
                pcall(mPress)
                pcall(function() vu:Button1Down(center) end)
                if vim then pcall(function() vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0) end) end
            end
            
            local function releaseUp()
                local center = getCenter()
                pcall(mRelease)
                pcall(function() vu:Button1Up(center) end)
                if vim then pcall(function() vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0) end) end
            end
            
            local function clickOnce()
                local center = getCenter()
                pcall(mClick)
                pcall(function() vu:ClickButton1(center) end)
                pressDown()
                task.wait(0.04)
                releaseUp()
            end
            
            local function isExclamationPresent()
                local char = lp and lp.Character
                if char then
                    for _, item in ipairs(char:GetChildren()) do
                        if item:IsA("Tool") and item.Name:lower():find("rod") then
                            local st = item:GetAttribute("State")
                            if st == "FishBitten" or st == "Bitten" then
                                return true
                            end
                        end
                    end
                    for _, v in ipairs(char:GetDescendants()) do
                        if v.Name:lower():find("warn") or v.Name:lower():find("exclamation") or v.Name:lower():find("bite") then
                            return true
                        end
                    end
                end
                return false
            end
            
            local function dismissCatchGui()
                pcall(function()
                    if repStorage:FindFirstChild("DialogueController") then
                        local dc = require(repStorage.DialogueController)
                        if dc and dc.Active then
                            if dc.close then
                                dc.close()
                            elseif dc.advance then
                                dc.advance()
                            end
                        end
                    end
                end)
                pcall(function()
                    local dg = lp:FindFirstChild("PlayerGui") and lp.PlayerGui:FindFirstChild("DialogueGui")
                    if dg and dg.Enabled ~= false then
                        for _, v in ipairs(dg:GetDescendants()) do
                            if (v:IsA("TextButton") or v:IsA("ImageButton")) and v.Visible then
                                pcall(function() v:Activate() end)
                            end
                        end
                    end
                end)
            end

            local function unlockPlayerMovement()
                pcall(function() releaseUp() end)
                dismissCatchGui()
                pcall(function()
                    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        if hum.WalkSpeed == 0 then hum.WalkSpeed = 16 end
                        if hum.JumpPower == 0 then hum.JumpPower = 50 end
                    end
                end)
            end

            local function autoLearnRecipes()
                if _G.AutoLearnRecipes == false then return end
                local bp = lp:FindFirstChild("Backpack")
                if not bp then return end
                local craftRF = repStorage:FindFirstChild("Modules") and repStorage.Modules:FindFirstChild("Net") and repStorage.Modules.Net:FindFirstChild("RF/Craft")
                
                for _, item in ipairs(bp:GetChildren()) do
                    local nm = item.Name:lower()
                    if nm:find("recipe") or nm:find("potion") or nm:find("scroll") or nm:find("blueprint") then
                        if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
                            lp.Character.Humanoid:EquipTool(item)
                            task.wait(0.2)
                            item:Activate()
                            if craftRF then
                                pcall(function() craftRF:InvokeServer("LearnRecipe", item.Name) end)
                                pcall(function() craftRF:InvokeServer("UseItem", item.Name) end)
                            end
                            task.wait(0.2)
                        end
                    end
                end
            end

            local lastBaitCheck = 0
            local function checkAndAutoBuyBait()
                if tick() - lastBaitCheck < 2.0 then return end
                lastBaitCheck = tick()

                local fishData = lp:FindFirstChild("Data") and lp.Data:FindFirstChild("FishingData")
                local selectedBait = fishData and fishData:GetAttribute("SelectedBait")
                local commF = repStorage:FindFirstChild("Remotes") and repStorage.Remotes:FindFirstChild("CommF_")
                local craftRF = repStorage:FindFirstChild("Modules") and repStorage.Modules:FindFirstChild("Net") and repStorage.Modules.Net:FindFirstChild("RF/Craft")
                
                local IdMap = nil
                local ItemReplication = nil
                pcall(function()
                    IdMap = require(repStorage.IdMap)
                    ItemReplication = require(repStorage.Util.ItemReplication)
                end)

                local function getBaitCount(bName)
                    if IdMap and ItemReplication and IdMap.Bait and IdMap.Bait[bName] then
                        return ItemReplication.Quantity.readClient(IdMap.Bait[bName]) or 0
                    end
                    return 0
                end

                local currentCount = (selectedBait and selectedBait ~= "None" and getBaitCount(selectedBait)) or 0
                
                if currentCount <= 0 or selectedBait == "None" or selectedBait == nil or selectedBait == "" or _G.AutoBuyBait then
                    -- 1. Try to equip any owned bait in inventory
                    local baits = {"Basic Bait", "Good Bait", "Kelp Bait", "Frozen Bait", "Epic Bait", "Carnivore Bait", "Abyssal Bait"}
                    local equipped = false
                    if commF then
                        for _, bName in ipairs(baits) do
                            if getBaitCount(bName) > 0 then
                                local ok, r = pcall(function() return commF:InvokeServer("LoadItem", bName, {"Usables"}) end)
                                if ok and r == true then
                                    equipped = true
                                    break
                                end
                            end
                        end
                    end

                    -- 2. If no bait owned, craft Basic Bait (gives 10 per craft) and equip it
                    if not equipped and craftRF and commF then
                        pcall(function() craftRF:InvokeServer("Craft", "Basic Bait", 1, {}) end)
                        task.wait(0.3)
                        pcall(function() commF:InvokeServer("LoadItem", "Basic Bait", {"Usables"}) end)
                    end
                end
            end
            
            local lastZPress = 0
            local function tryUseReelBoost(rodTool)
                if _G.AutoUseReelBoost == false then return end
                if tick() - lastZPress < 0.5 then return end

                local isFull = false
                rodTool = rodTool or getFishingRodTool()
                if rodTool then
                    local alpha = rodTool:GetAttribute("SkillChargeAlpha")
                    if alpha and alpha >= 0.85 then
                        isFull = true
                    end
                end

                if not isFull then
                    local pgui = lp:FindFirstChild("PlayerGui")
                    local rodSkills = pgui and pgui:FindFirstChild("Main") and pgui.Main:FindFirstChild("Skills") and pgui.Main.Skills:FindFirstChild("Fishing Rod")
                    local zSkill = rodSkills and rodSkills:FindFirstChild("Z")
                    if zSkill then
                        local cd = zSkill:FindFirstChild("Cooldown")
                        if cd and cd.Size.Y.Scale <= 0.05 then
                            isFull = true
                        end
                    end
                end

                if isFull then
                    lastZPress = tick()
                    if vim then
                        pcall(function() vim:SendKeyEvent(true, Enum.KeyCode.Z, false, game) end)
                        task.wait(0.04)
                        pcall(function() vim:SendKeyEvent(false, Enum.KeyCode.Z, false, game) end)
                    end
                    if keypress and keyrelease then
                        pcall(function() keypress(0x5A) end)
                        task.wait(0.04)
                        pcall(function() keyrelease(0x5A) end)
                    end
                    pcall(function()
                        vu:SetKeyDown("0x7a")
                        task.wait(0.04)
                        vu:SetKeyUp("0x7a")
                    end)
                    local jtaRF = repStorage:FindFirstChild("Modules") and repStorage.Modules:FindFirstChild("Net") and repStorage.Modules.Net:FindFirstChild("RF/JobToolAbilities")
                    if jtaRF then
                        pcall(function() jtaRF:InvokeServer("Reel Boost") end)
                    end
                end
            end

            local function getFishingMinigameGui()
                local pgui = lp:FindFirstChild("PlayerGui")
                if not pgui then return nil end
                local reeling = pgui:FindFirstChild("Fishing_Reeling")
                if reeling and reeling.Enabled ~= false then return reeling end
                for _, gName in ipairs({"Fishing_Reeling", "FishingGui", "Fishing", "FishGui", "ReelGui", "MinigameGui"}) do
                    local gui = pgui:FindFirstChild(gName)
                    if gui and gui.Enabled ~= false then return gui end
                end
                return nil
            end

            local lastCastTime = 0
            local isHooking = false

            local function isFishingMinigameOpen()
                local pcallOk, isPlaying = pcall(function()
                    local cm = require(repStorage.FishReplicated.FishingClient.Components.CatchingMinigame)
                    return cm and cm.__state and cm.__state.playing
                end)
                if pcallOk and isPlaying then return true end

                local pgui = lp:FindFirstChild("PlayerGui")
                if not pgui then return false end
                for _, gName in ipairs({"Fishing_Reeling", "FishingGui", "Fishing", "FishGui", "ReelGui", "MinigameGui"}) do
                    local gui = pgui:FindFirstChild(gName)
                    if gui and gui.Enabled ~= false then
                        for _, desc in ipairs(gui:GetDescendants()) do
                            if desc.Name:lower():find("reel") or desc.Name:lower():find("bar") or desc.Name:lower():find("fish") then
                                if desc.Visible ~= false then return true end
                            end
                        end
                    end
                end
                return false
            end

            while _G.AutoFish do
                _G.FishingInstantCatch = _G.AutoFishInstantReel
                local rod = getFishingRodTool()
                
                -- Auto dismiss caught fish summary dialogue if open
                dismissCatchGui()
                
                -- Check and auto buy/equip bait when needed
                checkAndAutoBuyBait()
                
                -- Check and auto learn caught potion/recipe scrolls
                autoLearnRecipes()
                
                if rod then
                    -- Equip rod if in backpack
                    if rod.Parent == lp:FindFirstChild("Backpack") and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
                        lp.Character.Humanoid:EquipTool(rod)
                        task.wait(0.6)
                    end
                    
                    if rod.Parent == lp.Character then
                        pcall(function() vu:CaptureController() end)
                        local st = rod:GetAttribute("State") or "ReeledIn"
                        local sst = rod:GetAttribute("ServerState") or "ReeledIn"
                        local fishReq = repStorage:FindFirstChild("FishReplicated") and repStorage.FishReplicated:FindFirstChild("FishingRequest")
                        local hasBitten = isExclamationPresent() or st == "FishBitten" or st == "Bitten" or sst == "Biting"
                        local isMinigame = isFishingMinigameOpen() or st == "Catching" or sst == "Catching"
                        
                        -- 1. ACTIVE REELING / MINIGAME
                        if isMinigame then
                            isHooking = false
                            tryUseReelBoost(rod)
                            
                            if _G.AutoFishInstantReel then
                                _G.AutoFishMinigameAutopilot = false
                                -- Instant Reel enabled: complete catch immediately via net remotes
                                if fishReq then
                                    pcall(function() fishReq:InvokeServer("Catch", 100, 0, 100) end)
                                    pcall(function() fishReq:InvokeServer("CompleteCatch") end)
                                    pcall(function() fishReq:InvokeServer("Catching", false) end)
                                end
                                
                                clickOnce()
                                task.wait(0.3)
                                
                                local minigameTimeout = tick()
                                while tick() - minigameTimeout < 2.5 do
                                    if not isFishingMinigameOpen() and rod:GetAttribute("State") ~= "Catching" then
                                        break
                                    end
                                    task.wait(0.1)
                                end
                                task.wait(0.8)
                            else
                                -- Instant Reel OFF: autopilot minigame tracking & use Reel Boost
                                _G.AutoFishMinigameAutopilot = true

                                tryUseReelBoost(rod)

                                -- Fallback GUI steering only if Controller hook is not present
                                if not _G.OriginalFishingIsReeling then
                                    local mgGui = getFishingMinigameGui()
                                    local container = mgGui and mgGui:FindFirstChild("Container", true)
                                    local fishPart = container and container:FindFirstChild("Fish")
                                    local reelPart = container and container:FindFirstChild("ReelZone")

                                    if fishPart and reelPart then
                                        local fPos = fishPart.Position.X.Scale
                                        local rPos = reelPart.Position.X.Scale
                                        -- AnchorPoint is (0.5, 0.5) so rPos is already the center!
                                        if fPos > (rPos + 0.02) then
                                            pressDown()
                                        elseif fPos < (rPos - 0.02) then
                                            releaseUp()
                                        end
                                    end
                                end

                                if not isFishingMinigameOpen() and rod:GetAttribute("State") ~= "Catching" and (rod:GetAttribute("ServerState") or "") ~= "Catching" then
                                    _G.AutoFishMinigameAutopilot = false
                                    releaseUp()
                                    task.wait(0.3)
                                    dismissCatchGui()
                                    clickOnce()
                                    task.wait(0.5)
                                else
                                    task.wait(0.04)
                                end
                            end

                        -- 2. FISH BITTEN -> Hook Fish Once
                        elseif hasBitten and not isHooking and (tick() - lastCastTime > 1.5) then
                            _G.AutoFishMinigameAutopilot = false
                            isHooking = true
                            rod:Activate()
                            clickOnce()
                            if fishReq then
                                pcall(function() fishReq:InvokeServer("Catching", true, {fastBite = true}) end)
                                pcall(function() fishReq:InvokeServer("Catching", true) end)
                            end
                            pcall(function() rod:SetAttribute("State", "Catching") end)
                            task.wait(0.5)

                        -- 3. LINE IN WATER -> Wait for Fish (Do not click/interrupt)
                        elseif (st == "WaitingForFish" or st == "Waiting" or st == "Casting" or st == "Cast" or (tick() - lastCastTime <= 3.0)) then
                            dismissCatchGui()
                            task.wait(0.1)

                        -- 4. IDLE / REELED IN -> Clean Green Cast
                        elseif (st == "ReeledIn" or st == "None" or st == "Idle" or sst == "ReeledIn" or sst == "None") and (tick() - lastCastTime > 3.0) then
                            isHooking = false
                            lastCastTime = tick()
                            
                            -- Begin casting hold
                            pressDown()
                            
                            -- Hold for exact Green Power Zone
                            task.wait(0.72)
                            
                            -- Release mouse to throw bobber
                            releaseUp()
                            
                            -- Allow bobber to land in water
                            task.wait(1.8)
                        else
                            task.wait(0.1)
                        end
                    end
                else
                    OrionLib:MakeNotification({
                        Name = "Fishing Warning",
                        Content = "No Fishing Rod found in Inventory!",
                        Time = 3
                    })
                    task.wait(3)
                end
                
                -- Auto Sell Fish if enabled
                if _G.AutoFishSell then
                    local jobsRF = repStorage:FindFirstChild("Modules") and repStorage.Modules:FindFirstChild("Net") and repStorage.Modules.Net:FindFirstChild("RF/JobsRemoteFunction")
                    if jobsRF then
                        pcall(function() jobsRF:InvokeServer("FishingNPC", "SellFish") end)
                        pcall(function() jobsRF:InvokeServer("FishingNPC", "SellCorruptedFish") end)
                        pcall(function() jobsRF:InvokeServer("FishingNPC", "SellCelestialFish") end)
                    end
                end
                
                task.wait(0.05)
            end
            
