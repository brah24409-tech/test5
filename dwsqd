        elseif game.PlaceId == 7449423635 or game.PlaceId == 100117331123089 or game.PlaceId == 10011733112309 then
            mainPlaceId = 7449423635
        end

        local sfUrl = "https://games.roblox.com/v1/games/" .. tostring(mainPlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
        local req = (syn and syn.request) or (http and http.request) or http_request or request or httprequest
        local body = nil
        if req then
            local s, res = pcall(function()
                return req({Url = sfUrl, Method = "GET", Headers = {["Content-Type"] = "application/json"}})
            end)
            if s and res and (res.Body or res.body) then body = res.Body or res.body end
