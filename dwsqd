                                        mob = GetSpawnedEliteMob()
                                        if mob then break end
                                        if hrp and (hrp.Position - subCF.Position).Magnitude < 40 then break end
                                        task.wait(0.2)
                                    end
                                    if mob then break end
                                end
                            end
                        end
                    end
                end

                -- Step 4: Engage and Kill Elite Pirate Mob
                if mob and mob.Parent and mob:FindFirstChildOfClass("Humanoid") and mob:FindFirstChildOfClass("Humanoid").Health > 0 and mob:FindFirstChild("HumanoidRootPart") then
                    stopAllTweens()
                    while _G.AutoElitePirates and mob and mob.Parent and mob:FindFirstChildOfClass("Humanoid") and mob:FindFirstChildOfClass("Humanoid").Health > 0 do
                        local char = LocalPlayer.Character
                        local myHum = char and char:FindFirstChildOfClass("Humanoid")
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        if not char or not myHum or myHum.Health <= 0 or not hrp or myHum:GetState() == Enum.HumanoidStateType.Dead then
                            stopAllTweens()
                            ClearCombatAnchor()
                            task.wait(1.5)
                            break
                        end

                        local mHrp = mob:FindFirstChild("HumanoidRootPart")
                        if mHrp then
                            local dist = (hrp.Position - mHrp.Position).Magnitude
                            if dist > 35 then
                                if not _G.ActiveTween then
                                    TP(mHrp.CFrame * CFrame.new(0, 12, 0), true)
                                end
                            else
                                MaintainCombatAnchor(mHrp.CFrame, 12, mob)
                                if _G.BringMobs then pcall(function() BringMobs(mob) end) end
                                SmartAttackTarget(mob)
                            end
                        else
                            break
                        end
                        task.wait(0.1)
                    end
                    ClearCombatAnchor()
                end
            end)
        end
    end)

