    local UPPER_SKY_PAD_CF = CFrame.new(-4171.18115, 1095.35693, -354.226929, -0.981674552, 4.7707772e-08, -0.190565109, 6.17583353e-08, 1, -6.77921292e-08, 0.190565109, -7.83187915e-08, -0.981674552)
