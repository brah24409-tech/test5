local function getTikiPotClusters()
    local arena = nil
    for _, d in ipairs(workspace:GetDescendants()) do
        if d.Name == "EagleBossArena" then arena = d break end
    end

    local rawPots = {}
    if arena then
        for _, d in ipairs(arena:GetDescendants()) do
            local dn = d.Name:lower()
            local pn = d.Parent and d.Parent.Name:lower() or ""
            if not pn:find("pillar") and not dn:find("pillar") and not pn:find("statue") and not dn:find("statue") and not dn:find("arena") then
                if dn:find("brokenurn") or (dn:find("urn") and not dn:find("return")) or dn:find("pot") or dn:find("vase") or dn:find("jar") then
                    if d:IsA("BasePart") then
                        table.insert(rawPots, d)
                    end
                end
            end
        end
    end

    if #rawPots == 0 then
        local searchCenters = {
            Vector3.new(-16250, 160, 1320),
            Vector3.new(-16667, 146, 466),
            Vector3.new(-16474, 205, 1514)
        }
        local podKeywords = {"brokenurn", "urn", "pot", "vase", "jar", "vessel"}
        local function checkObj(obj)
            local n = obj.Name:lower()
            local pn = obj.Parent and obj.Parent.Name:lower() or ""
            if pn:find("pillar") or n:find("pillar") or pn:find("statue") or n:find("statue") then return end
            for _, kw in ipairs(podKeywords) do
                if n:find(kw, 1, true) then
                    local pos = nil
                    pcall(function()
                        pos = obj:IsA("Model") and obj:GetPivot().Position or (obj:IsA("BasePart") and obj.Position)
                    end)
                    if pos then
                        for _, center in ipairs(searchCenters) do
                            if (pos - center).Magnitude < 400 then
                                if obj:IsA("BasePart") then
                                    table.insert(rawPots, obj)
                                elseif obj:IsA("Model") then
                                    for _, ch in ipairs(obj:GetChildren()) do
                                        if ch:IsA("BasePart") then table.insert(rawPots, ch) end
                                    end
                                end
                                break
                            end
                        end
                    end
                    break
                end
            end
        end

        if workspace:FindFirstChild("Map") then
            for _, d in ipairs(workspace.Map:GetDescendants()) do
                checkObj(d)
            end
        end
    end

    -- Group raw pots into distinct tree clusters (~15 studs)
    local clusters = {}
    for _, p in ipairs(rawPots) do
        local pos = p.Position
        local found = false
        for _, cl in ipairs(clusters) do
            if (cl.pos - pos).Magnitude < 18 then
                table.insert(cl.pots, p)
                found = true
                break
            end
        end
        if not found then
            table.insert(clusters, { pos = pos, pots = {p} })
        end
    end

    return clusters
end

local function smashPotCluster(cluster)
    if not cluster or not cluster.pos then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local clusterCF = CFrame.new(cluster.pos.X, cluster.pos.Y + 2, cluster.pos.Z)
    local dist = (hrp.Position - cluster.pos).Magnitude
    if dist > 25 then
        ClearCombatAnchor()
        if not _G.ActiveTween then
            TP(clusterCF, true)
        end
        return
    end

    ClearCombatAnchor()
    -- 1. Position right at cluster center and look directly down at the pots
    hrp.CFrame = CFrame.lookAt(cluster.pos + Vector3.new(0, 2, 0), cluster.pos)
    local cam = workspace.CurrentCamera
    if cam then
        pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cluster.pos) end)
    end

    -- 2. Physical touch via firetouchinterest on all pots in this cluster
    if firetouchinterest then
        for _, p in ipairs(cluster.pots) do
            if p and p.Parent then
                pcall(function()
                    firetouchinterest(hrp, p, 0)
                    task.wait()
                    firetouchinterest(hrp, p, 1)
                end)
            end
        end
    end

    -- 3. Equip Melee weapon
    equipWeapon()
    pcall(function()
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and (t.Name:find("Claw") or t.Name:find("Talon") or t.Name:find("Human") or t.Name:find("Step") or t.Name:find("Karate") or t.Name:find("Kung") or t.Name:find("Melee")) then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then hum:EquipTool(t) end
                    break
                end
            end
        end
    end)

    -- 4. ProximityPrompt / ClickDetector if interactive
    for _, p in ipairs(cluster.pots) do
        local prompt = p:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and fireproximityprompt then
            pcall(function() fireproximityprompt(prompt) end)
        end
        local cd = p:FindFirstChildWhichIsA("ClickDetector", true)
        if cd and fireclickdetector then
            pcall(function() fireclickdetector(cd) end)
        end
    end

    -- 5. Charged Melee AoE Abilities (Hold to charge & unleash heavy blast) - NO M1
    local vim = game:GetService("VirtualInputManager")
    local heavySkillKeys = {Enum.KeyCode.C, Enum.KeyCode.Z, Enum.KeyCode.X}
    for _, key in ipairs(heavySkillKeys) do
        pcall(function()
            if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cluster.pos) end
            vim:SendKeyEvent(true, key, false, game)
            task.wait(0.35) -- Hold key to charge melee skill / release AoE blast
            vim:SendKeyEvent(false, key, false, game)
            task.wait(0.08)
        end)
    end
end


