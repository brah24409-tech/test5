    local function isCombatActiveForAbilities()
        if _G.AutoFarm or _G.KillAura or _G.AutoElitePirates or _G.AutoKatakuri or _G.AutoDoughKing or _G.AutoTyrant or _G.AutoBoss or _G.AutoRaid or _G.AutoRaidChipStart or _G.AutoSeaFarm or _G.HitAllMobs then
            return true
        end
        if workspace:FindFirstChild("RaidMap") then
            return true
        end
        local char = LocalPlayer and LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and workspace:FindFirstChild("Enemies") then
            for _, mob in ipairs(workspace.Enemies:GetChildren()) do
                local mobHrp = mob:FindFirstChild("HumanoidRootPart")
