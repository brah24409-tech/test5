                if boss and boss:FindFirstChild("HumanoidRootPart") then
                    local bHrp = boss:FindFirstChild("HumanoidRootPart")
                    local c = LocalPlayer.Character
                    local r = c and c:FindFirstChild("HumanoidRootPart")
                    if bHrp and r and (bHrp.Position - r.Position).Magnitude > 30 then
                        TP(bHrp.CFrame * CFrame.new(0, 15, 0), true)
                    end
                    while boss and boss.Parent and boss:FindFirstChildOfClass("Humanoid") and boss:FindFirstChildOfClass("Humanoid").Health > 0 do
                        if bHrp then
                            MaintainCombatAnchor(bHrp.CFrame, 15, boss)
                        end
