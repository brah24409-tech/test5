    local function GetEnemy()
        local char = LocalPlayer.Character
        local myPos = char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position
        local nearest = nil
        local minDist = math.huge

        if not Mon then return nil end
        local targetName = Mon:lower()

        local enemiesFolder = workspace:FindFirstChild("Enemies") or Enemies
        if not enemiesFolder then return nil end

        for _, v in pairs(enemiesFolder:GetChildren()) do
            local vHum = v:FindFirstChildOfClass("Humanoid")
            local vHrp = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
            local vName = v.Name:lower()

            local isMatch = false
            if targetName == "gorilla" then
                -- Strictly ignore Gorilla King when doing Gorilla quest
                if not vName:find("king") and not vName:find("boss") and (vName == "gorilla" or vName:find("^gorilla")) then
                    isMatch = true
                end
            elseif targetName == "monkey" then
                if not vName:find("boss") and (vName == "monkey" or vName:find("^monkey")) then
                    isMatch = true
                end
            elseif targetName == "bandit" then
                if not vName:find("leader") and not vName:find("boss") and (vName == "bandit" or vName:find("^bandit")) then
                    isMatch = true
                end
            else
                if vName == targetName or vName:find(targetName, 1, true) then
                    isMatch = true
                end
            end

            if isMatch
                and vHum and (vHum.Health or 0) > 0
                and vHrp
                and not ZelesIsGhost(v) then
                if myPos then
                    local d = (vHrp.Position - myPos).Magnitude
                    if d < minDist then
                        minDist = d
                        nearest = v
                    end
                else
                    return v
                end
            end
        end
        return nearest
    end

