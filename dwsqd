-- Dynamic Universal Berry Scanner (Reads entire Map across all islands with zero streaming blindspots)
local function GetRealBerryTargets()
    local targets = {}
    local seenKeys = {}
    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("LowerTorso"))

    local function getBushWorldCF(bush)
        if not bush then return nil end
        local cf = bush:GetAttribute("CFrame")
        if typeof(cf) == "CFrame" then return cf end
        if bush:IsA("Model") then return bush:GetPivot() end
        if bush:IsA("BasePart") then return bush.CFrame end
        local prim = bush:FindFirstChildOfClass("BasePart")
        if prim then return prim.CFrame end
        return nil
    end

    -- 1. Scan all "Berries" folders across workspace.Map
    if workspace:FindFirstChild("Map") then
        for _, descendant in ipairs(workspace.Map:GetDescendants()) do
            if descendant.Name == "Berries" then
                local bush = descendant.Parent
                local bushCF = getBushWorldCF(bush)
                local bAttrs = descendant:GetAttributes()

                -- Check slot attributes replicated from server (_BerryCFrame1..8)
                for attrName, attrVal in pairs(bAttrs) do
                    if type(attrName) == "string" and attrName:sub(1, 12) == "_BerryCFrame" and type(attrVal) == "string" and #attrVal > 0 then
                        local slotCF = (bush and bush:GetAttribute(attrName)) or CFrame.new()
                        local worldCF = bushCF and (bushCF:ToWorldSpace(slotCF) * CFrame.new(0, 0.5, 0)) or bushCF or CFrame.new()
                        local key = tostring(bush and bush.Name or "Bush") .. "_" .. attrName .. "_" .. tostring(attrVal)
                        if not seenKeys[key] then
                            seenKeys[key] = true
                            table.insert(targets, {
                                Bush = bush,
                                BushName = bush and bush.Name or "Bush",
                                SlotKey = attrName,
                                BerryName = attrVal,
                                Position = worldCF.Position,
                                CFrame = worldCF,
                                Instance = descendant
                            })
                        end
                    end
                end

                -- Check direct model children inside Berries container
                for _, child in ipairs(descendant:GetChildren()) do
                    if child:IsA("Model") or child:IsA("BasePart") then
                        local prompt = child:FindFirstChildOfClass("ProximityPrompt") or child:FindFirstChildWhichIsA("ProximityPrompt", true)
                        local bName = (prompt and prompt.ActionText ~= "" and prompt.ActionText) or child.Name
                        local cf = child:IsA("Model") and child:GetPivot() or child.CFrame
                        local key = "Child_" .. tostring(child)
                        if not seenKeys[key] then
                            seenKeys[key] = true
                            table.insert(targets, {
                                Bush = bush,
                                BushName = bush and bush.Name or "Bush",
                                SlotKey = "_BerryCFrame1",
                                BerryName = bName,
                                Position = cf.Position,
                                CFrame = cf,
                                Instance = child,
                                Prompt = prompt
                            })
                        end
                    end
                end
            end
        end
    end

    -- 2. Check standalone proximity prompts for berries
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local act = obj.ActionText:lower()
            local objText = obj.ObjectText:lower()
            if BERRY_TYPES[act] or act:find("berry") or objText:find("berry") then
                local model = obj.Parent
                if model and not seenKeys[model] then
                    seenKeys[model] = true
                    local parentBush = model.Parent and model.Parent.Parent
                    local pos = model:IsA("Model") and model:GetPivot().Position or (model:IsA("BasePart") and model.Position or Vector3.new(0, 0, 0))
                    local cf = model:IsA("Model") and model:GetPivot() or (model:IsA("BasePart") and model.CFrame or CFrame.new(pos))
                    table.insert(targets, {
                        Bush = parentBush,
                        BushName = parentBush and parentBush.Name or "Bush",
                        SlotKey = "_BerryCFrame1",
                        BerryName = (obj.ActionText ~= "" and obj.ActionText) or "Berry",
                        Position = pos,
                        CFrame = cf,
                        Instance = model,
                        Prompt = obj
                    })
                end
            end
        end
    end

    -- Distance sort closest to player
    if hrp and #targets > 1 then
        local hrpPos = hrp.Position
        table.sort(targets, function(a, b)
            return (hrpPos - a.Position).Magnitude < (hrpPos - b.Position).Magnitude
        end)
    end

    return targets
end

