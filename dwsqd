-- Helper to safely check if behavior is selected (handles both dict and array representations)
local function isBehaviorActive(map, key)
    if not map then return false end
    if map[key] == true then return true end
    if map[key] == false then return false end
    for _, v in pairs(map) do
        if v == key then return true end
    end
    return false
end

