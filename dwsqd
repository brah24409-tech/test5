    --// GHOST MOB GUARD
    -- A "ghost" is a mob whose CFrame was written client-side without network ownership:
    -- it looks stacked on our screen but the server still has it elsewhere, so hits are rejected.
    local _ghostUntil = setmetatable({}, { __mode = "k" })
    local _mobOrigProps = setmetatable({}, { __mode = "k" })
    local _bringHpTrack = setmetatable({}, { __mode = "k" })
    local _lastDamageSeen = 0

    local function ZelesOwnsPart(part)
        if not part or part.Anchored then return false end
        if typeof(isnetworkowner) == "function" then
            local ok, res = pcall(isnetworkowner, part)
            if ok and res == true then return true end
        end
        -- ReceiveAge is 0 when this client is the one simulating the part
        local ok, age = pcall(function() return part.ReceiveAge end)
        return ok and age == 0
    end
    _G.ZelesOwnsPart = ZelesOwnsPart

    local function ZelesIsGhost(mob)
        local t = mob and _ghostUntil[mob]
        return t ~= nil and tick() < t
    end
    _G.ZelesIsGhost = ZelesIsGhost

    local function ZelesMarkGhost(mob, duration)
        if not mob then return end
        _ghostUntil[mob] = tick() + (duration or 20)
        _bringHpTrack[mob] = nil
        local orig = _mobOrigProps[mob]
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if orig and hum then
            pcall(function()
                hum.WalkSpeed = orig.WalkSpeed
                hum.JumpPower = orig.JumpPower
                hum.AutoRotate = orig.AutoRotate
            end)
        end
    end
    _G.ZelesMarkGhost = ZelesMarkGhost

