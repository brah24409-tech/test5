-- ║ TYPEWRITER LOADING SCREEN (name types out, thin line fills as progress)║
-- ╚════════════════════════════════════════════════════════════════════════╝

local function ZelesTypewriterSplash(opts)
    opts = opts or {}
    local TweenService = game:GetService("TweenService")
    local RunService   = game:GetService("RunService")
    local Players      = game:GetService("Players")

    -- NOIR palette (same values as the interface's Theme).
    local C = {
        Bg = Color3.fromRGB(11, 11, 12), Text = Color3.fromRGB(250, 250, 251),
        SubText = Color3.fromRGB(222, 222, 226), Muted = Color3.fromRGB(161, 161, 168),
        Track = Color3.fromRGB(29, 29, 32), Accent = Color3.fromRGB(245, 245, 247),
    }
    local font = opts.Font or Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.SemiBold)

    local function N(class, props)
        local inst = Instance.new(class)
        for k, v in pairs(props) do
            if k ~= "Parent" then inst[k] = v end
        end
        if props.Parent then inst.Parent = props.Parent end
        return inst
    end
    local function tween(inst, dur, props, style, dir)
        local t = TweenService:Create(inst, TweenInfo.new(dur, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
        t:Play()
        return t
    end
    local function seq(colors)
        local kps = {}
        for i, c in ipairs(colors) do
            kps[#kps + 1] = ColorSequenceKeypoint.new((i - 1) / math.max(#colors - 1, 1), c)
        end
        return ColorSequence.new(kps)
    end

    local gui = N("ScreenGui", {
        Name = "ZelesHubSplashTypewriter", IgnoreGuiInset = true, ResetOnSpawn = false,
        DisplayOrder = 100000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    do
        local parent
        local ok, ui = pcall(function() return gethui and gethui() end)
        if ok and ui then parent = ui end
        if not parent then
            ok, ui = pcall(function() return game:GetService("CoreGui") end)
            if ok and ui then parent = ui end
        end
        gui.Parent = parent or Players.LocalPlayer:WaitForChild("PlayerGui")
    end

    local backdrop = N("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Bg, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 1, Parent = gui,
    })
    tween(backdrop, 0.35, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad)

    -- Letters are typed into a left-aligned label placed over the finished word's width,
    -- so the word stays centred and never shifts while it types.
    local letters = string.upper(opts.Title or "ZELES HUB")
    local spaced = letters:gsub(".", "%0 "):gsub("%s+$", "")
    local TEXT_SIZE = 28
    local ghost = N("TextLabel", {
        BackgroundTransparency = 1, Text = spaced, FontFace = font, TextSize = TEXT_SIZE,
        TextTransparency = 1, Size = UDim2.fromOffset(600, 40), Visible = false, Parent = gui,
    })
    local width = ghost.TextBounds.X
    if width < 80 then width = #spaced * 17 end
    width = math.ceil(width) + 4
    ghost:Destroy()

    local W = math.max(width + 20, 320)
    local box = N("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(W, 200), BackgroundTransparency = 1, ZIndex = 2, Parent = backdrop,
    })
    -- Scale the box, never the full-screen backdrop (scaling that shifts everything off-centre).
    N("UIScale", { Scale = math.clamp(((workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.Y) or 720) / 720, 0.7, 1.5), Parent = box })

    local word = N("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(math.floor((W - width) / 2), 42),
        Size = UDim2.fromOffset(width + 40, 40),
        Text = "|", FontFace = font, TextSize = TEXT_SIZE, TextColor3 = C.Text,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3, Parent = box,
    })

    local track = N("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 118),
        Size = UDim2.fromOffset(260, 3), BackgroundColor3 = C.Track, BorderSizePixel = 0,
        ZIndex = 3, Parent = box,
    })
    N("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
    local bar = N("Frame", {
        Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        ZIndex = 4, Parent = track,
    })
    N("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
    N("UIGradient", { Color = seq({ C.Muted, C.SubText, C.Accent }), Parent = bar })

    -- Status line uses the NOIR muted subtext style (13px, muted grey).
    local status = N("TextLabel", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 134),
        Size = UDim2.new(1, 0, 0, 16), Text = string.lower(opts.Subtitle or "loading"),
        FontFace = font, TextSize = 13, TextColor3 = C.Muted, ZIndex = 3, Parent = box,
    })

    local obj = { Instance = gui, Progress = 0, Done = false }
    local startedAt = os.clock()
    local total = #letters
    local START_DELAY, PER_LETTER = 0.3, 0.11
    local INTRO_TIME = START_DELAY + total * PER_LETTER + 0.25

    -- Letter count comes from the clock, so whichever frame draws shows the right text.
    local blink = RunService.RenderStepped:Connect(function()
        local elapsed = os.clock() - startedAt
        local typed = elapsed < START_DELAY and 0 or math.clamp(math.floor((elapsed - START_DELAY) / PER_LETTER) + 1, 0, total)
        local cursorOn = typed < total or (os.clock() % 1) < 0.6
        local shown = ""
        if typed > 0 then
            shown = letters:sub(1, typed):gsub(".", "%0 "):gsub("%s+$", "")
        end
        word.Text = shown .. (cursorOn and "|" or " ")
    end)

    -- The interface build is one long synchronous run that freezes every animation. The
    -- bootstrap calls this right after creating the splash so the name finishes typing
    -- first; the time spent counts toward MinDuration, so loading isn't any longer.
    function obj:WaitIntro()
        local remaining = INTRO_TIME - (os.clock() - startedAt)
        if remaining > 0 then task.wait(remaining) end
    end

    function obj:SetProgress(value, text)
        obj.Progress = math.max(obj.Progress or 0, math.clamp(value or 0, 0, 1))
        tween(bar, 0.4, { Size = UDim2.fromScale(obj.Progress, 1) }, Enum.EasingStyle.Quart)
        if text then status.Text = string.lower(text) end
        if obj.Progress >= 0.8 then status.Text = "ready" end
    end

    function obj:Finish(onClosed)
        if obj.Done then return end
        obj.Done = true
        local remaining = math.max((opts.MinDuration or 0) - (os.clock() - startedAt), 0)
        task.spawn(function()
            if remaining > 0 then task.wait(remaining) end
            obj:SetProgress(1, "ready")
            task.wait(0.6)
            blink:Disconnect()
            word.Text = spaced
            tween(backdrop, 0.4, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
            for _, d in ipairs(backdrop:GetDescendants()) do
                if d:IsA("TextLabel") then
                    tween(d, 0.3, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
                elseif d:IsA("Frame") then
                    tween(d, 0.3, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
                end
            end
            if onClosed then pcall(onClosed) end
            task.wait(0.45)
            gui:Destroy()
        end)
    end

    if opts.Steps and #opts.Steps > 0 then
        local duration = math.max(opts.Duration or 2.4, opts.MinDuration or 0)
        task.spawn(function()
            for i, step in ipairs(opts.Steps) do
                if obj.Done then return end
                obj:SetProgress(i / #opts.Steps * 0.9, step)
                task.wait(duration / #opts.Steps)
            end
        end)
    end

    return obj
end


local _zelesEnv = (getgenv and getgenv()) or _G
local LOADING_FILE = "ZelesHub_BloxFruits_loading.txt"
local LOADING_STYLES = { "Modern", "Classic", "Orb", "Off" }

local function readLoadingStyle()
    local ok, raw = pcall(function()
        if isfile and isfile(LOADING_FILE) then return readfile(LOADING_FILE) end
    end)
    raw = (ok and type(raw) == "string") and raw:lower() or ""
    if raw:find("classic") then return "Classic" end
    if raw:find("orb") then return "Orb" end
    if raw:find("off") then return "Off" end
    return "Modern"
end

local function writeLoadingStyle(style)
    pcall(function() if writefile then writefile(LOADING_FILE, style) end end)
end

local loadingStyle = readLoadingStyle()

local function makeSplash(style, preview)
    local o = {
        Title = "ZELES HUB",
        Subtitle = preview and "preview" or "Blox Fruits",
        Steps = { "initializing", "loading environment", "building interface", "ready" },
        Duration = 2.4, MinDuration = 2.6, Font = InterFont,
    }
    if style == "Classic" then return ZelesClassicSplash(o) end
    if style == "Orb" then return ZelesSplash(o) end
    if style == "Modern" then return ZelesTypewriterSplash(o) end
    if style == "Off" then
        return { SetProgress = function() end, Finish = function(_, cb) if cb then pcall(cb) end end }
    end
    return ZelesTypewriterSplash(o)
end

local Splash
do
    local ok, result = pcall(makeSplash, loadingStyle, false)
    if ok and result then
        Splash = result
    else
        Splash = { SetProgress = function() end, Finish = function(_, cb) if cb then pcall(cb) end end }
    end
end
