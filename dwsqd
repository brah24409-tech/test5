    local function getActiveQuestTitle()
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        if not pgui then return false, "" end

        local hasQuest = false
        local text = ""

        -- Modern Blox Fruits TrackedQuestFrame
        local tq = pgui:FindFirstChild("TrackedQuestFrame")
        if tq and tq:IsA("ScreenGui") and tq.Enabled then
            local frame = tq:FindFirstChild("Frame")
            if (not frame) or frame.Visible then
                hasQuest = true
                for _, desc in ipairs(tq:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Visible and desc.Text and desc.Text ~= "" and desc.Text ~= "?" then
                        text = text .. " " .. desc.Text
                    end
                end
            end
        end

        -- Legacy Blox Fruits Main.Quest
        if not hasQuest then
            local main = pgui:FindFirstChild("Main")
            local quest = main and main:FindFirstChild("Quest")
            if quest and quest.Visible then
                hasQuest = true
                for _, desc in ipairs(quest:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Visible and desc.Text and desc.Text ~= "" and desc.Text ~= "QUEST" and desc.Text ~= "+" then
                        text = text .. " " .. desc.Text
                    end
                end
            end
        end

        return hasQuest, text:lower()
    end

