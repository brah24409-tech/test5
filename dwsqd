                end
                
                local mobData = MobCFrameMap[targetName] or MobCFrameMap[targetName:gsub("s$", "")]
                
                -- Optional Quest Acceptance (checks for wrong quests and replaces them)
                if _G.TakeNPCQuest then
                    local hasQ, isCorrect = hasCorrectActiveQuest(targetName)
                    if not hasQ or not isCorrect then
                        local tookQuest = TryTakeNPCQuest(targetName)
                        if not tookQuest then
                            task.wait(0.2)
                        end
                    end
                end
                
                -- First check if target mob is currently streamed into workspace.Enemies
                local targetMob = nil
                local minDist = math.huge
                
                if workspace:FindFirstChild("Enemies") then
                    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
                        if mob:IsA("Model") and mob.Name:find(targetName, 1, true) then
                            local hum = mob:FindFirstChildOfClass("Humanoid")
                            local mHrp = mob:FindFirstChild("HumanoidRootPart")
                            if hum and (hum.Health or 0) > 0 and mHrp then
                                local dist = (hrp.Position - mHrp.Position).Magnitude
                                if dist < minDist then
                                    minDist = dist
                                    targetMob = mob
                                end
                            end
                        end
                    end
                end
                
                -- If mob model is streamed in, fly above and attack it
                if targetMob then
                    local mHrp = targetMob:FindFirstChild("HumanoidRootPart")
                    local hum = targetMob:FindFirstChildOfClass("Humanoid")
                    
                    if mHrp and hrp and (mHrp.Position - hrp.Position).Magnitude > 30 then
                        TP(mHrp.CFrame * CFrame.new(0, 15, 0), true)
                    end
                    
                    local watchHp, watchSince = nil, tick()
                    while _G.AutoFarmNPCWithQuest and targetMob and targetMob.Parent and hum and (hum.Health or 0) > 0 and mHrp do
                        local char = LocalPlayer.Character
                        local myHum = char and char:FindFirstChildOfClass("Humanoid")
                        local myHrp = char and char:FindFirstChild("HumanoidRootPart")
                        if not char or not myHum or myHum.Health <= 0 or not myHrp or myHum:GetState() == Enum.HumanoidStateType.Dead then
                            stopAllTweens()
                            ClearCombatAnchor()
                            task.wait(1.5)
                            break
                        end

                        -- Ghost watchdog: if mob is stuck or immune, break and skip it
                        local eHp = hum.Health
                        if eHp ~= watchHp or not mHrp or (mHrp.Position - myHrp.Position).Magnitude > 60 then
                            watchHp, watchSince = eHp, tick()
                        elseif tick() - watchSince > 10 then
                            if ZelesMarkGhost then ZelesMarkGhost(targetMob, 30) end
                            break
                        end

                        MaintainCombatAnchor(mHrp.CFrame, 15, targetMob)
                        
                        if _G.BringMobs and BringMobs then
                            BringMobs(targetMob)
                        end
                        
                        local attackFn = SmartAttackTarget or _G.SmartAttackTarget
                        if attackFn then
                            attackFn(targetMob)
                        else
                            local weapon = equipWeapon()
                            if weapon then weapon:Activate() end
                            SafeFire("RE/RegisterAttack", 0)
                            if targetMob:FindFirstChild("Head") then
                                SafeFire("RE/RegisterHit", targetMob.Head, {}, tostring(LocalPlayer.UserId))
                            end
                        end
                        
                        RunService.Heartbeat:Wait()
                    end
                    ClearCombatAnchor()
                else
                    -- Mob not streamed in yet: check submerged first, then fly to spawn
                    local isSub = _G.isSubmergedMob and _G.isSubmergedMob(targetName)
                    local inSub = _G.isInsideSubmerged and _G.isInsideSubmerged()
                    if isSub and not inSub then
                        pcall(SubmergedEntry)
                        task.wait(1)
                        return
                    elseif not isSub and inSub then
                        pcall(SubmergedExit)
                        task.wait(1)
                        return
                    end

                    if mobData and mobData.CF then
                        TP(mobData.CF * CFrame.new(0, 15, 0), true)
                    else
                        -- Fallback: check workspace for NPC spawner location
                        local spawner = workspace:FindFirstChild(targetName, true) or workspace:FindFirstChild(targetName .. " [Lv.", true)
                        if spawner and spawner:IsA("Model") then
                            TP(spawner:GetPivot() * CFrame.new(0, 15, 0), true)
                        end
                    end
                    task.wait(0.3)
                end
            end)
        end
    end)
