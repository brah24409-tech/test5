    --// SAFE NET FIRE
    local function SafeFire(remoteName, ...)
        local net = ReplicatedStorage:FindFirstChild("Modules")
            and ReplicatedStorage.Modules:FindFirstChild("Net")
    
        if not net then return end
    
        local remote = net:FindFirstChild(remoteName)
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(...)
        end
    end

    local function equipItem(itemName)
        local char = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if not char then return false end
        if char:FindFirstChild(itemName) then return true end
        if backpack and backpack:FindFirstChild(itemName) then
            pcall(function() backpack[itemName].Parent = char end)
            return true
        end
        return false
    end
    _G.equipItem = equipItem

    --// CHECK IF GUN IS EQUIPPED OR SELECTED
    local function IsGunEquipped()
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                if tool.ToolTip == "Gun" or (tool:FindFirstChild("Gun") or tool.Name:lower():find("gun")) then
                    return true
                end
            end
        end
        if _G.SelectWeapon == "Gun" or _G.selectedWeapon == "Gun" or _G.SelectedMasterySkill == "Gun" then
            return true
        end
        return false
    end

    --// GUN AIMED M1 ATTACK (for Auto Farm, Boss Farm, etc.)
    local function GunAttackTarget(enemy)
        if not enemy or not enemy:FindFirstChild("HumanoidRootPart") then return end
        pcall(function()
            local VIM = game:GetService("VirtualInputManager")
            local cam = workspace.CurrentCamera
            if not cam or not cam.ViewportSize then return end
            local ePos = enemy.HumanoidRootPart.Position
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 5, 0), ePos)
                task.wait(0.02)
                
                local viewportSize = cam.ViewportSize
                local screenPos, onScreen = cam:WorldToViewportPoint(ePos)
                local clickX = onScreen and screenPos.X or (viewportSize.X / 2)
                local clickY = onScreen and screenPos.Y or (viewportSize.Y / 2 + 120)
                
                VIM:SendMouseButtonEvent(clickX, clickY, 0, true, game, 0)
                task.wait(0.03)
                VIM:SendMouseButtonEvent(clickX, clickY, 0, false, game, 0)
            end
        end)
    end

