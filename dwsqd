                _G.MasteryTarget = nil
                UpdateStatus("No enemies nearby")
                if not _G._noEnemyWarningPrinted then
                    print("go near an enemy for it to work")
                    _G._noEnemyWarningPrinted = true
                end
                task.wait(0.5)
                continue
            else
                _G._noEnemyWarningPrinted = false
            end
        end

        if not _G.AutoMastery then continue end -- toggled off while equipping/searching: do NOT re-anchor

        -- Combat movement & anchor
        if enemy and enemy:FindFirstChild("HumanoidRootPart") then
            local dist = (myHrp.Position - enemy.HumanoidRootPart.Position).Magnitude
            if dist > 30 then
                _G.MasteryTarget = nil
                if not _G.ActiveTween then
                    TP(enemy.HumanoidRootPart.CFrame * CFrame.new(0, 15, 0), true)
                end
            else
                _G.MasteryTarget = enemy
                MaintainCombatAnchor(enemy.HumanoidRootPart.CFrame, 15, enemy)
                if _G.BringMobs then
                    BringMobs(enemy)
                end
            end
        end

        if currentEnemy ~= enemy then
            currentEnemy = enemy
            _G.MasteryTarget = enemy
            UpdateStatus("Mastering " .. _G.SelectedMasterySkill .. " on " .. enemy.Name)
        end

        -- Enemy dead check
        local hum = currentEnemy:FindFirstChildOfClass("Humanoid")
        if not currentEnemy.Parent or not hum or not hum:IsA("Humanoid") or hum.Health <= 0 then
            _G.MasteryTarget = nil
            currentEnemy = nil
            UpdateStatus("Enemy defeated, searching next...")
            local charNow = LocalPlayer.Character
            local myHrpNow = charNow and charNow:FindFirstChild("HumanoidRootPart")
            if myHrpNow then
                myHrpNow.Velocity = Vector3.new(0, 0, 0)
                pcall(function() myHrpNow.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
            end
            task.wait(0.15)
            continue
        end

        -- Revamped Attack Phase
        local isFruitOrGun = (_G.SelectedMasterySkill == "Blox Fruit" or _G.SelectedMasterySkill == "Gun")
        local threshold = tonumber(_G.MasterySwitchThreshold) or 20

        if not isFruitOrGun then
            -- Melee or Sword: Treat as normal, equip selected weapon and spam remote attacks from 100% to 0%
            EquipWeaponByTip(_G.SelectedMasterySkill)
            local curMobHrp = currentEnemy:FindFirstChild("HumanoidRootPart")
            if curMobHrp then MaintainCombatAnchor(curMobHrp.CFrame, 15, currentEnemy) end
            
            if _G.SelectedMasterySkill == "Sword" then
                SpamSkillsForSelectedType(currentEnemy)
            end
            BasicAttack(currentEnemy)
            task.wait(0.04)
        else
            -- Blox Fruit or Gun:
            local maxHp = (hum.MaxHealth and hum.MaxHealth > 0) and hum.MaxHealth or 100
            local curHp = hum.Health or 0
            local hpPercent = (curHp / maxHp) * 100

            if hpPercent > threshold then
                -- Above threshold: Weaken mob with primary weapon (Melee / Sword) via fast remote spam
                UpdateStatus(string.format("Weakening %s (%d%% > %d%%)", enemy.Name, math.floor(hpPercent), threshold))
                if not EquipWeaponByTip("Melee") then
                    EquipWeaponByTip("Sword")
                end
                local curMobHrp = currentEnemy:FindFirstChild("HumanoidRootPart")
                if curMobHrp then MaintainCombatAnchor(curMobHrp.CFrame, 15, currentEnemy) end
                BasicAttack(currentEnemy)
                task.wait(0.04)
            else
                -- At or below threshold: Switch over to selected Fruit/Gun, fire abilities, and use NORMAL M1s (NO remote hit spam!)
                UpdateStatus(string.format("Finishing %s with %s (%d%% <= %d%%)", enemy.Name, _G.SelectedMasterySkill, math.floor(hpPercent), threshold))
                EquipWeaponByTip(_G.SelectedMasterySkill)
                local curMobHrp = currentEnemy:FindFirstChild("HumanoidRootPart")
                if curMobHrp then MaintainCombatAnchor(curMobHrp.CFrame, 15, currentEnemy) end

                -- Fire unlocked skills for Fruit/Gun
                SpamSkillsForSelectedType(currentEnemy)

                -- Perform normal M1 (legitimate client input so Fruit/Gun gets the kill credit)
                if _G.SelectedMasterySkill == "Gun" then
                    GunAttack(currentEnemy)
                else
                    NormalFruitM1(currentEnemy)
                end
                task.wait(0.08)
            end
        end
    end
end)

