        if _G.MasteryFarmSpecificNPC and _G.MasterySelectedNPC and _G.MasterySelectedNPC ~= "" then
            local targetName = _G.MasterySelectedNPC

            -- Optional Quest Acceptance for Auto Mastery (checks for wrong quests and replaces them)
            if _G.MasteryTakeNPCQuest and _G.TryTakeNPCQuest then
                local hasQ, isCorrect = false, false
                if _G.hasCorrectActiveQuest then
                    hasQ, isCorrect = _G.hasCorrectActiveQuest(targetName)
                end
                if not hasQ or not isCorrect then
                    UpdateStatus("Taking quest for " .. targetName .. "...")
                    local took = _G.TryTakeNPCQuest(targetName)
                    if not took then
                        task.wait(0.3)
                    end
                end
            end

            -- Check Submerged Island entry & exit for selected NPC
            local isSub = _G.isSubmergedMob and _G.isSubmergedMob(targetName)
            local inSub = _G.isInsideSubmerged and _G.isInsideSubmerged()
            if isSub and not inSub then
                UpdateStatus("Entering Submerged Island for " .. targetName .. "...")
                pcall(SubmergedEntry)
                task.wait(1)
                continue
            elseif not isSub and inSub then
                UpdateStatus("Leaving Submerged Island for " .. targetName .. "...")
                pcall(SubmergedExit)
                task.wait(1)
                continue
            end

            -- Look for streamed enemy matching targetName
            enemy = GetSpecificMasteryEnemy(targetName)
            if not enemy then
                _G.MasteryTarget = nil
                currentEnemy = nil
                UpdateStatus("Traveling to " .. targetName .. "...")
                local mobMap = _G.MobCFrameMap or MobCFrameMap
                local mobData = mobMap and (mobMap[targetName] or mobMap[targetName:gsub("s$", "")])
                if mobData and mobData.CF then
                    local dist = (myHrp.Position - mobData.CF.Position).Magnitude
                    if dist > 30 then
                        if not _G.ActiveTween then
                            TP(mobData.CF * CFrame.new(0, 15, 0), true)
                        end
                    end
                else
                    local spawner = workspace:FindFirstChild(targetName, true) or workspace:FindFirstChild(targetName .. " [Lv.", true)
                    if spawner and spawner:IsA("Model") then
                        TP(spawner:GetPivot() * CFrame.new(0, 15, 0), true)
                    end
                end
                task.wait(0.4)
                continue
