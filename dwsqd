    -- Auto Solve Active Moments & Jungle Secret Level Implementations
    _G.AutoSolveMoments = false
    
    local isSolvingMoment = false
    local function solveActiveIslandSecrets()
        if isSolvingMoment or not _G.AutoSolveMoments then return end
        isSolvingMoment = true
        
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hrp or not hum or hum.Health <= 0 then
                if stopAllTweens then stopAllTweens() end
                isSolvingMoment = false
                return
            end

            -- 1. Check if an active secret enemy is spawned in workspace (IGNORE standard monkeys)
            local secretEnemy = nil
            local enemyFolders = {workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Characters"), workspace}
            for _, folder in ipairs(enemyFolders) do
                if folder and not secretEnemy then
                    for _, mob in ipairs(folder:GetChildren()) do
                        if mob:IsA("Model") and not Players:GetPlayerFromCharacter(mob) then
                            local mobHum = mob:FindFirstChildOfClass("Humanoid")
                            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
                            if mobHum and mobHum.Health > 0 and mobHrp then
                                local mName = mob.Name:lower()
                                -- Strictly match special secret boss/mobs, NEVER normal farm monkeys
                                if mName:find("thief") or mName == "monkey thief" or mName == "thief monkey" or mName:find("tyrant") or mName:find("awakened gorilla") or (mName:find("skeleton") and mName:find("pyramid")) or mName:find("prospector") then
                                    secretEnemy = mob
                                    break
                                end
                            end
                        end
                    end
                end
            end

            -- 2. If special secret enemy found, stay above them and attack
            if secretEnemy and secretEnemy:FindFirstChild("HumanoidRootPart") then
                local eHrp = secretEnemy.HumanoidRootPart
                if (hrp.Position - eHrp.Position).Magnitude > 250 then
                    TP(eHrp.CFrame * CFrame.new(0, 15, 0), true)
                else
                    hrp.CFrame = eHrp.CFrame * CFrame.new(0, 15, 0)
                    hrp.Velocity = Vector3.new(0, 0, 0)
                end
                SmartAttackTarget(secretEnemy)
                task.wait(0.15)
                isSolvingMoment = false
                return
            end

            -- 3. Check loaded moments from controller
            local bmc = ReplicatedStorage:FindFirstChild("Controllers") and ReplicatedStorage.Controllers:FindFirstChild("BonusMomentsController")
            if not bmc then isSolvingMoment = false return end
            local loaded = require(bmc).GetLoadedMoments()

            for name, moment in pairs(loaded) do
                if not _G.AutoSolveMoments then break end
                if moment.Active and not moment.Completed then
                    -- Priority 1: Jungle Zipline Repair (Hook -> Platforms)
                    if name == "Zipline Repair" then
                        -- Step A: Pick up Grappling Hook if on ground
                        local hook = workspace:FindFirstChild("GroundPickupGrapplingHook")
                        if hook then
                            local hookPrompt = hook:FindFirstChildWhichIsA("ProximityPrompt", true)
                            local hookPart = hook:FindFirstChildWhichIsA("BasePart", true)
                            if hookPart then
                                TP(hookPart.CFrame + Vector3.new(0, 3, 0), true)
                                task.wait(0.4)
                                if hookPrompt then
                                    pcall(function() fireproximityprompt(hookPrompt) end)
                                end
                                task.wait(0.4)
                            end
                        end

                        -- Step B: Equip hook tool
                        pcall(function()
                            if equipItem then
                                local eq = equipItem("Tool") or equipItem("Grappling Hook") or equipItem("Hook")
                            end
                        end)
                        task.wait(0.2)

                        -- Step C: Connect Platform A
                        local p1 = CFrame.new(-1482.84, 78.08, -15.25)
                        TP(p1 + Vector3.new(0, 3, 0), true)
                        task.wait(0.4)
                        local jungle = workspace.Map:FindFirstChild("Jungle")
                        if jungle then
                            for _, p in ipairs(jungle:GetDescendants()) do
                                if p:IsA("ProximityPrompt") and p.Name:lower():find("zipline") then
                                    pcall(function() fireproximityprompt(p) end)
                                end
                            end
                        end
                        task.wait(0.5)

                        -- Step D: Traverse to Platform B
                        local p2 = CFrame.new(-1280.91, 78.22, -247.06)
                        TP(p2 + Vector3.new(0, 3, 0), true)
                        task.wait(0.4)
                    end

                    -- Priority 2: The Thieving Monkey / Banana Tree (Monkey Island Tree Punching)
                    if name == "The Thieving Monkey" or name == "Banana Tree" then
                        local jungle = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Jungle")
                        local footstepsObj = jungle and jungle:FindFirstChild("MonkeyThiefFootsteps")
                        local targetTreeCF = nil

                        if footstepsObj then
                            local lastFootprintPos = nil
                            local footprints = {}
                            for _, child in ipairs(footstepsObj:GetChildren()) do
                                if child:IsA("BasePart") then
                                    table.insert(footprints, child)
                                end
                            end
                            table.sort(footprints, function(a, b)
                                local numA = tonumber(a.Name:match("%d+")) or 0
                                local numB = tonumber(b.Name:match("%d+")) or 0
                                return numA > numB
                            end)
                            if #footprints > 0 then
                                lastFootprintPos = footprints[1].Position
                            end

                            if lastFootprintPos and jungle:FindFirstChild("BananaTrees") then
                                local nearestTree = nil
                                local minDist = math.huge
                                for _, tree in ipairs(jungle.BananaTrees:GetChildren()) do
                                    local tPos = tree:IsA("BasePart") and tree.Position or (tree:IsA("Model") and tree:GetPivot().Position)
                                    if tPos then
                                        local dist = (tPos - lastFootprintPos).Magnitude
                                        if dist < minDist then
                                            minDist = dist
                                            nearestTree = tree
                                        end
                                    end
                                end
                                if nearestTree then
                                    targetTreeCF = nearestTree:IsA("BasePart") and nearestTree.CFrame or nearestTree:GetPivot()
                                end
                            end

                            if not targetTreeCF and lastFootprintPos then
                                targetTreeCF = CFrame.new(lastFootprintPos + Vector3.new(0, 3, 0))
                            end
                        end

                        if targetTreeCF then
                            local standCF = CFrame.new(targetTreeCF.Position + Vector3.new(0, 2, 0) - (targetTreeCF.LookVector * 3), targetTreeCF.Position)
                            if (hrp.Position - standCF.Position).Magnitude > 15 then
                                TP(standCF, true)
                                task.wait(0.3)
                            end

                            -- Lock orientation and camera forward into tree
                            hrp.CFrame = standCF
                            local cam = workspace.CurrentCamera
                            if cam then
                                cam.CFrame = CFrame.new(cam.CFrame.Position, targetTreeCF.Position)
                            end

                            local tool = char:FindFirstChildOfClass("Tool")
                            if not tool or (tool.Name ~= "Electric Claw" and tool.Name ~= "Combat" and tool.Name ~= "Yama") then
                                local melee = LocalPlayer.Backpack:FindFirstChild("Electric Claw") or LocalPlayer.Backpack:FindFirstChild("Combat") or LocalPlayer.Backpack:FindFirstChild("Yama") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                                if melee and hum then
                                    hum:EquipTool(melee)
                                    task.wait(0.2)
                                end
                            end
                            tool = char:FindFirstChildOfClass("Tool")

                            local vim = game:GetService("VirtualInputManager")
                            local vu = game:GetService("VirtualUser")

                            -- Forward M1 clicks
                            if mouse1click then pcall(mouse1click) end
                            if vu and cam then
                                local vp = cam.ViewportSize
                                vu:CaptureController()
                                vu:Button1Down(Vector2.new(vp.X / 2, vp.Y / 2), cam.CFrame)
                                task.wait(0.02)
                                vu:Button1Up(Vector2.new(vp.X / 2, vp.Y / 2), cam.CFrame)
                            end
                            if vim and cam then
                                local vp = cam.ViewportSize
                                vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 1)
                                task.wait(0.02)
                                vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 1)
                            end
                            if tool then pcall(function() tool:Activate() end) end

                            pcall(function()
                                local net = game:GetService("ReplicatedStorage"):FindFirstChild("Modules") and game:GetService("ReplicatedStorage").Modules:FindFirstChild("Net")
                                if net and net:FindFirstChild("RE/RegisterAttack") then
                                    net["RE/RegisterAttack"]:FireServer(0)
                                end
                            end)

                            task.wait(0.12)
                        end
                    end

                    -- Ice Island / Snowman
                    if name:find("Snowman") or name:find("Ice") or name:find("Campfire") then
                        local ice = workspace.Map:FindFirstChild("Ice")
                        local prompt = ice and ice:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
                            if (hrp.Position - prompt.Parent.Position).Magnitude > 15 then
                                TP(prompt.Parent.CFrame + Vector3.new(0, 3, 0), true)
                                task.wait(0.4)
                            end
                            pcall(function() fireproximityprompt(prompt) end)
                            task.wait(0.5)
                        end
                    end

                    -- Prison Moments
                    if name:find("Prison") or name:find("Megalo") or name:find("Guest") then
                        local prison = workspace.Map:FindFirstChild("Prison")
                        local prompt = prison and prison:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
                            if (hrp.Position - prompt.Parent.Position).Magnitude > 15 then
                                TP(prompt.Parent.CFrame + Vector3.new(0, 3, 0), true)
                                task.wait(0.4)
                            end
                            pcall(function() fireproximityprompt(prompt) end)
                            task.wait(0.5)
                        end
                    end

                    break -- Only process one moment at a time
                end
            end
        end)
        
        isSolvingMoment = false
    end

