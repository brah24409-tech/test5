        Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 7, Parent = track,
    })
    round(bar, "full")
    N("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(161, 161, 168)),
            ColorSequenceKeypoint.new(1, C.Accent),
        }),
        Parent = bar,
    })

    -- Entrance
    tween(card, 0.5, { Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 0 })
    tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
    tween(cardStroke, 0.5, { Transparency = 0.3 })
    for i, g in ipairs(glows) do tween(g, 0.6, { BackgroundTransparency = 0.97 + i * 0.006 }) end
    for _, l in ipairs({ title, subtitle, status, percent }) do tween(l, 0.5, { TextTransparency = 0 }, Enum.EasingStyle.Quad) end
    tween(track, 0.5, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad)
    tween(bar, 0.5, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad)

    local obj = { Instance = gui, Progress = 0, Done = false }
    local startedAt = os.clock()

    function obj:SetProgress(value, text)
        obj.Progress = math.max(obj.Progress or 0, math.clamp(value or 0, 0, 1))
        tween(bar, 0.45, { Size = UDim2.fromScale(obj.Progress, 1) }, Enum.EasingStyle.Quart)
        percent.Text = math.floor(obj.Progress * 100 + 0.5) .. "%"
        if text then status.Text = string.lower(text) end
        if obj.Progress >= 0.8 then status.Text = "ready" end
    end

    function obj:Finish(onClosed)
        if obj.Done then return end
        obj.Done = true
        local remaining = math.max((opts.MinDuration or 0) - (os.clock() - startedAt), 0)
        task.spawn(function()
            if remaining > 0 then task.wait(remaining) end
            obj:SetProgress(1, "ready")
            task.wait(0.55)
            -- Hand over to the interface while the card slides away.
            if onClosed then pcall(onClosed) end
            tween(card, 0.4, { Position = UDim2.new(0.5, 0, 0.5, -26), BackgroundTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            tween(scale, 0.4, { Scale = 0.96 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            tween(cardStroke, 0.3, { Transparency = 1 })
            for _, l in ipairs({ title, subtitle, status, percent }) do tween(l, 0.25, { TextTransparency = 1 }, Enum.EasingStyle.Quad) end
            tween(track, 0.3, { BackgroundTransparency = 1 })
            tween(bar, 0.3, { BackgroundTransparency = 1 })
            for _, g in ipairs(glows) do tween(g, 0.3, { BackgroundTransparency = 1 }) end
            tween(dim, 0.45, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
            task.wait(0.5)
            gui:Destroy()
        end)
    end

    if opts.Steps and #opts.Steps > 0 then
        local duration = math.max(opts.Duration or 2.4, opts.MinDuration or 0)
        task.spawn(function()
            for i, step in ipairs(opts.Steps) do
                if obj.Done then return end
                obj:SetProgress(i / #opts.Steps * 0.9, step)
                task.wait(duration / #opts.Steps)
            end
        end)
    end

    return obj
end

