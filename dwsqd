    local function HitAllMobs(targetEnemy)
        local enemiesContainer = workspace:FindFirstChild("Enemies")
        if not enemiesContainer then return end

        local myChar = LocalPlayer and LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myPos = myHrp and myHrp.Position
        if not myPos then return end

        local targetHead = targetEnemy and (targetEnemy:FindFirstChild("Head") or targetEnemy:FindFirstChild("HumanoidRootPart") or targetEnemy.PrimaryPart)
        local primaryHead = targetHead
        local hitTable = {}

        if targetEnemy and targetHead then
            table.insert(hitTable, { [1] = targetEnemy, [2] = targetHead })
        end

        local targetPos = targetHead and targetHead.Position or myPos
        for _, mob in ipairs(enemiesContainer:GetChildren()) do
            if mob ~= targetEnemy then
                local mobHum = mob:FindFirstChildOfClass("Humanoid")
                if mobHum and (mobHum.Health or 0) > 0 then
                    local mobHead = mob:FindFirstChild("Head") or mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                    if mobHead then
                        local dTarget = (mobHead.Position - targetPos).Magnitude
                        local dPlr = (mobHead.Position - myPos).Magnitude
                        if _G.BringMobs or dTarget <= 65 or dPlr <= 65 then
                            if not primaryHead then primaryHead = mobHead end
                            table.insert(hitTable, { [1] = mob, [2] = mobHead })
                        end
                    end
                end
            end
        end

        if primaryHead and #hitTable > 0 then
            SafeFire("RE/RegisterHit", primaryHead, hitTable)
        end
    end
    _G.HitAllMobs = HitAllMobs

