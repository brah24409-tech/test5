	}, { Corner(9), Stroke(Theme.Stroke, 0.45) })
	-- Accent bar on the pill's inner left edge.
	local selectionBar = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(3, 16),
