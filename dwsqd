        local myPos = root and root.Position

        local sbFolder = workspace:FindFirstChild("SeaBeasts")
        if sbFolder then
            for _, v in pairs(sbFolder:GetChildren()) do
                if not Players:GetPlayerFromCharacter(v) and isEntityAlive(v) then
                    local vPart = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head") or v.PrimaryPart
                    local dist = (vPart and myPos) and (vPart.Position - myPos).Magnitude or 0
                    if dist <= 1200 then
                        local isLevi = v.Name:lower():find("leviathan")
                        if isLevi and isTargetAllowed("Leviathan") then
                            return v, "Leviathan"
                        elseif not isLevi and isTargetAllowed("Sea Beast") then
                            return v, "Sea Beast"
                        end
                    end
                end
            end
        end
        local enemies = workspace:FindFirstChild("Enemies")
        if enemies then
            for _, v in pairs(enemies:GetChildren()) do
                if not Players:GetPlayerFromCharacter(v) and isEntityAlive(v) then
                    local vPart = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head") or v.PrimaryPart
                    local dist = (vPart and myPos) and (vPart.Position - myPos).Magnitude or 0
                    if dist <= 1200 then
                        local n = v.Name:lower()
                        if (n:find("sea beast") or n:find("seabeast")) and isTargetAllowed("Sea Beast") then
                            return v, "Sea Beast"
                        elseif n:find("leviathan") and isTargetAllowed("Leviathan") then
                            return v, "Leviathan"
                        end
                    end
                end
            end
        end
        return nil
    end

    -- Banana Hub inspired entity event detection (Sharks, Boats, Crew, Piranhas)
    local function findSeaEvent()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local myPos = root and root.Position

        local containers = {}
        if workspace:FindFirstChild("SeaEvents") then table.insert(containers, workspace.SeaEvents) end
        if workspace:FindFirstChild("Enemies") then table.insert(containers, workspace.Enemies) end

        for _, container in ipairs(containers) do
            for _, v in pairs(container:GetChildren()) do
                if not Players:GetPlayerFromCharacter(v) and isEntityAlive(v) then
                    local vPart = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head") or v.PrimaryPart
                    local dist = (vPart and myPos) and (vPart.Position - myPos).Magnitude or 0
                    if dist <= 1000 then
                        local n = v.Name
                        local nLower = n:lower()

                        -- If yellow belt is active, skip all boats, ships, and crew
                        if _G.AutoDojoBelt or _G.CurrentServerBelt == "Yellow" then
                            if nLower:find("boat") or nLower:find("ship") or nLower:find("brig") or nLower:find("syndicate") or nLower:find("envy") or nLower:find("grandbrigade") or nLower:find("pirate") or nLower:find("crew") then
                                continue
                            end
                        end

                        -- Terrorshark
                        if (nLower == "terrorshark" or nLower:find("terror shark")) and isTargetAllowed("Terror Shark") then
                            return v, "Terror Shark"
                        -- Standard Sharks (Shark, Electric Shark)
                        elseif nLower:find("shark") and not nLower:find("terror") and isTargetAllowed("Shark") then
                            return v, "Shark"
                        -- Piranha
                        elseif nLower:find("piranha") and isTargetAllowed("Piranha") then
                            return v, "Piranha"
                        -- Crew members
                        elseif nLower:find("haunted crew") and isTargetAllowed("Haunted Crew Member") then
                            return v, "Haunted Crew Member"
                        elseif nLower:find("fish crew") and isTargetAllowed("Fish Crew Member") then
                            return v, "Fish Crew Member"
                        -- Boat enemies (Fish Boat, Pirate Grand Brigade, Ghost Ship)
                        elseif (nLower:find("fishboat") or (v:FindFirstChild("VehicleSeat") and nLower:find("fish"))) and isTargetAllowed("Fish Boat") then
                            return v, "Fish Boat"
                        elseif nLower:find("pirategrandbrigade") and isTargetAllowed("Pirate Grand Brigade") then
                            return v, "Pirate Grand Brigade"
                        elseif (nLower:find("ghost ship") or nLower:find("brig") or nLower:find("syndicate") or nLower:find("envy")) and isTargetAllowed("Ghost Ship") then
                            return v, "Ghost Ship"
                        end
                    end
                end
            end
        end
        return nil
    end

    local function getSelectedToolTip()
        local w = _G.selectedWeapon or _G.SelectWeapon
        if not w then return nil end
        local lowerSelected = tostring(w):lower()
        if lowerSelected == "mele" or lowerSelected == "melee" then return "Melee" end
        if lowerSelected == "devil fruit" or lowerSelected == "blox fruit" or lowerSelected == "fruit" then return "Blox Fruit" end
        if lowerSelected == "sword" then return "Sword" end
        if lowerSelected == "gun" then return "Gun" end
        return nil
    end

    local function isSelectedWeapon(child)
        if not child or not child:IsA("Tool") then return false end
        local targetTip = getSelectedToolTip()
        if targetTip then
            return child.ToolTip == targetTip
        else
            local w = _G.selectedWeapon or _G.SelectWeapon
            return child.Name == w
        end
    end

    function equipWeapon(force)
        local char = LocalPlayer.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        local currentlyEquipped = char:FindFirstChildOfClass("Tool")
        if currentlyEquipped and not force then
            if isSelectedWeapon(currentlyEquipped) then
                return currentlyEquipped
            end
        end
        
        local wName = _G.selectedWeapon or _G.SelectWeapon
        local targetTip = getSelectedToolTip()
        
        if targetTip and LocalPlayer:FindFirstChild("Backpack") then
            for _, child in pairs(LocalPlayer.Backpack:GetChildren()) do
                if child:IsA("Tool") and child.ToolTip == targetTip then
                    if hum then hum:EquipTool(child) else child.Parent = char end
                    task.wait(0.04)
                    return char:FindFirstChildOfClass("Tool") or child
                end
            end
        elseif wName and LocalPlayer:FindFirstChild("Backpack") then
            local tool = LocalPlayer.Backpack:FindFirstChild(wName)
            if tool then
                if hum then hum:EquipTool(tool) else tool.Parent = char end
                task.wait(0.04)
                return char:FindFirstChildOfClass("Tool") or tool
            end
        end
        
        if LocalPlayer:FindFirstChild("Backpack") then
            local firstTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
            if firstTool then
                if hum then hum:EquipTool(firstTool) else firstTool.Parent = char end
                task.wait(0.04)
                return char:FindFirstChildOfClass("Tool") or firstTool
            end
        end
        return char:FindFirstChildOfClass("Tool") or nil
    end
    _G.equipWeapon = equipWeapon

    function SmartAttackTarget(target)
        if not target then
            if ClearCombatAnchor then ClearCombatAnchor() elseif _G.ClearCombatAnchor then _G.ClearCombatAnchor() end
            return
        end

        local hum = target:FindFirstChildOfClass("Humanoid")
        if not hum or (hum.Health or 0) <= 0 then
            if ClearCombatAnchor then ClearCombatAnchor() elseif _G.ClearCombatAnchor then _G.ClearCombatAnchor() end
            return
        end

        local targetHead = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
        if not targetHead then return end

        local anchorFn = MaintainCombatAnchor or _G.MaintainCombatAnchor
        if anchorFn then
            pcall(function()
                anchorFn(targetHead.CFrame, 15, target)
            end)
        end

        local tool = equipWeapon()
        if tool then
            pcall(function() tool:Activate() end)
        end

        if IsGunEquipped and IsGunEquipped() then
            if GunAttackTarget then
                pcall(function() GunAttackTarget(target) end)
            end
        else
            pcall(function()
                local VU = game:GetService("VirtualUser")
                VU:CaptureController()
                VU:Button1Down(Vector2.new(1000, 1000))
                VU:Button1Up(Vector2.new(1000, 1000))
            end)
        end

        if _G.BringMobs and BringMobs then
            local isTyrantFight = (_G.BossFightActive and _G.AutoTyrant) or (target and target.Name and target.Name:lower():find("tyrant"))
            if not isTyrantFight then
                pcall(function() BringMobs(target) end)
            end
        end

        local hitTable = { [1] = { [1] = target, [2] = targetHead } }
        local char = LocalPlayer.Character
        local myPos = (char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position) or targetHead.Position

        for _, containerName in ipairs({"Enemies", "SeaEvents"}) do
            local container = workspace:FindFirstChild(containerName)
            if container then
                for _, mob in ipairs(container:GetChildren()) do
                    if mob ~= target and mob.Parent then
                        local mHum = mob:FindFirstChildOfClass("Humanoid")
                        if mHum and (mHum.Health or 0) > 0 then
                            local mHead = mob:FindFirstChild("Head") or mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                            if mHead then
                                local dTarget = (mHead.Position - targetHead.Position).Magnitude
                                local dPlr = (mHead.Position - myPos).Magnitude
                                if _G.BringMobs or dTarget <= 75 or dPlr <= 75 then
                                    table.insert(hitTable, { [1] = mob, [2] = mHead })
                                end
                            end
                        end
                    end
                end
            end
        end

        SafeFire("RE/RegisterAttack", 0)
        SafeFire("RE/RegisterHit", targetHead, hitTable)

        if hum and hum.Health > 0 then
            local now = tick()
            if _G._lastDmgTarget == target then
                if hum.Health < (_G._lastDmgHp or hum.Health) then
                    _G._lastDmgHp = hum.Health
                    _G._lastDmgTime = now
                else
                    if _G._lastDmgTime and (now - _G._lastDmgTime) > 3.0 then
                        pcall(function()
                            if _G.ClearCombatAnchor then _G.ClearCombatAnchor() end
                            local c = LocalPlayer.Character
                            local myRoot = c and c:FindFirstChild("HumanoidRootPart")
                            if myRoot and targetHead then
                                myRoot.Velocity = Vector3.new(0, 0, 0)
                                pcall(function() myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                                local safeY = (_G._combatTargetGroundY and (_G._combatTargetGroundY + 15)) or (targetHead.Position.Y + 15)
                                local tRot = (targetHead:IsA("BasePart") and targetHead.CFrame.Rotation) or CFrame.Angles(0, 0, 0)
                                myRoot.CFrame = CFrame.new(targetHead.Position.X, safeY, targetHead.Position.Z) * tRot * CFrame.Angles(math.rad(-30), 0, 0)
                                if anchorFn then
                                    anchorFn(targetHead.CFrame, 15, target)
                                end
                            end
                        end)
                        _G._lastDmgTime = now - 1.2
                    end
                end
            else
                _G._lastDmgTarget = target
                _G._lastDmgHp = hum.Health
                _G._lastDmgTime = now
            end
        end
    end
    _G.SmartAttackTarget = SmartAttackTarget

