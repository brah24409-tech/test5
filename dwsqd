    local function GetPlayerLevelCap()
        local attr = LocalPlayer:GetAttribute("LevelCap")
        if typeof(attr) == "number" and attr > 0 then
            return attr
        end
        return 2800
    end

    local function GetStatLevel(statName)
        local data = LocalPlayer:FindFirstChild("Data")
        local statsFolder = data and data:FindFirstChild("Stats")
        local statFolder = statsFolder and statsFolder:FindFirstChild(statName)
        local levelVal = statFolder and statFolder:FindFirstChild("Level")
        if levelVal and typeof(levelVal.Value) == "number" then
            return levelVal.Value
        end
        return 0
    end

    local statPointsLabel = StatsSection:NewLabel("Available Points: Checking...")
    
    task.spawn(function()
        while task.wait(1.5) do
            pcall(function()
                local data = LocalPlayer:FindFirstChild("Data")
                local pts = data and data:FindFirstChild("Points") and data.Points.Value or 0
                local cap = GetPlayerLevelCap()
                statPointsLabel:Set("Points: " .. tostring(pts) .. " | Stat Cap: " .. tostring(cap))
            end)
        end
    end)
    
    local function distributePointsImmediately()
        local data = LocalPlayer:FindFirstChild("Data")
        if not data then return end
        
        local pointsObj = data:FindFirstChild("Points")
        local availablePoints = pointsObj and pointsObj.Value or 0
        if availablePoints <= 0 then return end
        
        local cap = GetPlayerLevelCap()
        
        -- Map selected toggles to their candidate stat names
        local candidateStats = {}
        if _G.autoMeleeStats or _G.autoMeeleStats then table.insert(candidateStats, "Melee") end
        if _G.autoDefenseStats then table.insert(candidateStats, "Defense") end
        if _G.autoSwordStats then table.insert(candidateStats, "Sword") end
        if _G.autoGunStats then table.insert(candidateStats, "Gun") end
        if _G.autoDevilFruitStats then table.insert(candidateStats, "Demon Fruit") end

        if #candidateStats == 0 then return end

        -- Filter only stats that still have headroom under the dynamic cap (auto-scales with secret levels up to 3000)
        local eligibleStats = {}
        for _, statName in ipairs(candidateStats) do
            local currentLevel = GetStatLevel(statName)
            local needed = cap - currentLevel
            if needed > 0 then
                table.insert(eligibleStats, {
                    name = statName,
                    needed = needed,
                    allocate = 0
                })
            end
        end

        if #eligibleStats == 0 then return end

        -- Distribute available points evenly without exceeding any stat's needed headroom
        local remainingPoints = availablePoints
        while remainingPoints > 0 do
            local added = false
            for _, stat in ipairs(eligibleStats) do
                if remainingPoints > 0 and (stat.needed - stat.allocate) > 0 then
                    local share = math.max(1, math.floor(remainingPoints / #eligibleStats))
                    local give = math.min(share, remainingPoints, stat.needed - stat.allocate)
                    if give > 0 then
                        stat.allocate = stat.allocate + give
                        remainingPoints = remainingPoints - give
                        added = true
                    end
                end
            end
            if not added then break end
        end

        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if not commF then return end

        for _, stat in ipairs(eligibleStats) do
            if stat.allocate > 0 then
                pcall(function()
                    commF:InvokeServer("AddPoint", stat.name, stat.allocate)
                end)
            end
        end
    end

    StatsSection:NewToggle("Melee", "Auto add stats to Melee", function(state)
        _G.autoMeleeStats = state
        _G.autoMeeleStats = state
