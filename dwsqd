    local function hasCorrectActiveQuest(targetName)
        if not targetName or targetName == "" then return false, false end
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        if not pgui then return false, false end

        local hasQuest = false
        local questText = ""

        local tq = pgui:FindFirstChild("TrackedQuestFrame")
        if tq and tq:IsA("ScreenGui") and tq.Enabled then
            local frame = tq:FindFirstChild("Frame")
            if (not frame) or frame.Visible then
                hasQuest = true
                for _, desc in ipairs(tq:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Visible and desc.Text and desc.Text ~= "" and desc.Text ~= "?" then
                        questText = questText .. " " .. desc.Text
                    end
                end
            end
        end

        if not hasQuest then
            local main = pgui:FindFirstChild("Main")
            local questFrame = main and main:FindFirstChild("Quest")
            if questFrame and questFrame.Visible then
                hasQuest = true
                for _, desc in ipairs(questFrame:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Visible and desc.Text and desc.Text ~= "" and desc.Text ~= "QUEST" and desc.Text ~= "+" then
                        questText = questText .. " " .. desc.Text
                    end
                end
            end
        end

        if not hasQuest then
            return false, false
        end

        local lowerText = questText:lower()
        local lowerTarget = targetName:lower()
        local cleanTarget = lowerTarget:gsub("s$", "")

        local isCorrect = (lowerText:find(lowerTarget, 1, true) ~= nil) or (lowerText:find(cleanTarget, 1, true) ~= nil)
        return true, isCorrect
    end
    _G.hasCorrectActiveQuest = hasCorrectActiveQuest

