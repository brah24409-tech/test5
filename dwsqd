        Notify("Upper Sky", "Heading to sky pad...", 3)
        TP(UPPER_SKY_PAD_CF, true)
        local arriveBy = tick() + 30
        while tick() < arriveBy do
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - UPPER_SKY_PAD_CF.Position).Magnitude < 25 then break end
            task.wait(0.25)
