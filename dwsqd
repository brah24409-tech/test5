do
    --// ========== ESP TAB (ported from the reference hub's "Stats And Esp" tab) ==========
    -- Same 11 ESPs, same labels/colours. Differences from the original, all for fps:
    --  * ONE shared 0.25s driver loop instead of 11 separate per-frame loops
    --  * heavy scans (chests, gear, fruit...) are cached and rescanned every 1-3s
    --  * text is only rewritten when it actually changes
    --  * every billboard lives in one container, so toggling off / unloading is a single Destroy
    local Players = game:GetService("Players")
    local CollectionService = game:GetService("CollectionService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local lp = Players.LocalPlayer
    local espVersion = _G.ScriptVersion

    -- ESP Section attached to Local Player tab
    local ESPSection = LocalPlayerTab:NewSection("ESP")

    -- container (executor-safe GUI parent) + folder for invisible anchor parts
    local guiParent = (gethui and gethui()) or game:GetService("CoreGui")
    pcall(function()
        local old = guiParent:FindFirstChild("ZelesEspGui")
        if old then old:Destroy() end
    end)
    local root = Instance.new("Folder")
    root.Name = "ZelesEspGui"
    local okParent = pcall(function() root.Parent = guiParent end)
    if not okParent then root.Parent = lp:WaitForChild("PlayerGui") end

    local anchorFolder = workspace:FindFirstChild("ZelesEspAnchors")
    if anchorFolder then anchorFolder:Destroy() end
    anchorFolder = Instance.new("Folder")
    anchorFolder.Name = "ZelesEspAnchors"
    anchorFolder.Parent = workspace

    local function myPos()
        local c = lp.Character
        local h = c and (c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart"))
        return h and h.Position
    end

    local function firstPart(inst)
        if not inst then return nil end
        if inst:IsA("BasePart") then return inst end
        if inst:IsA("Model") then
            return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
        end
        return inst:FindFirstChildWhichIsA("BasePart", true)
    end

    local CYAN = Color3.fromRGB(80, 245, 245)

    -- stable per-instance ids (the debug-id API is not available to normal scripts)
    local idMap, idCount = setmetatable({}, { __mode = "k" }), 0
    local function uid(o)
        local v = idMap[o]
        if not v then idCount = idCount + 1 v = idCount idMap[o] = v end
        return v
    end

    -- Each type: scan() -> { {key=, part=Instance | pos=Vector3, label=, color=, extra=function(dist)->string} ... }
    --            label is the first line; the second line is "<dist> M" unless `fmt` is given
    local types = {}

    local function add(def) types[#types + 1] = def return def end

    add({ id = "Berry", name = "Esp Berry", desc = "Berry bushes across the map", scanEvery = 2,
        scan = function()
            local out = {}
            for _, bush in ipairs(CollectionService:GetTagged("BerryBush")) do
                pcall(function()
                    local pos = bush.Parent:GetPivot().Position
                    for _, v in pairs(bush:GetAttributes()) do
                        if v then
                            out[#out + 1] = { key = "b_" .. tostring(v) .. tostring(pos), pos = pos, color = CYAN,
                                fmt = function(d) return "[" .. tostring(v) .. "] " .. d .. " M" end }
                        end
                    end
                end)
            end
            return out
        end })

    add({ id = "Player", name = "Esp Player", desc = "Name, distance and health above each player", scanEvery = 0.25,
        scan = function()
            local out = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp then
                    local c = p.Character
                    local head = c and c:FindFirstChild("Head")
                    if head then
                        local hum = c:FindFirstChildOfClass("Humanoid")
                        local same = p.Team ~= nil and p.Team == lp.Team
                        out[#out + 1] = { key = "p_" .. p.UserId, part = head, color = same and Color3.fromRGB(70, 130, 255) or Color3.fromRGB(255, 60, 60),
                            fmt = function(d)
                                local hp = (hum and hum.MaxHealth > 0) and math.floor(hum.Health * 100 / hum.MaxHealth + 0.5) or 0
                                return p.Name .. " | " .. d .. " M\nHealth : " .. hp .. "%"
                            end }
                    end
                end
            end
            return out
        end })

    add({ id = "Chest", name = "Esp Chest", desc = "Chests (CollectionService tagged)", scanEvery = 1.5,
        scan = function()
            local out = {}
            for _, ch in ipairs(CollectionService:GetTagged("_ChestTagged")) do
                local part = firstPart(ch)
                if part then
                    local nm = (ch.Name:gsub("Label", ""))
                    out[#out + 1] = { key = "c_" .. uid(ch), part = part, offset = Vector3.new(0, 3, 0), color = CYAN,
                        fmt = function(d) return "[" .. nm .. "] " .. d .. " M" end }
                end
            end
            return out
        end })

    add({ id = "Fruit", name = "Esp Fruit", desc = "Spawned devil fruits", scanEvery = 1,
        scan = function()
            local out = {}
            for _, o in ipairs(workspace:GetChildren()) do
                if string.find(o.Name, "Fruit") then
                    local h = o:FindFirstChild("Handle")
                    if h then
                        out[#out + 1] = { key = "f_" .. uid(o), part = h, color = Color3.new(1, 1, 1),
                            fmt = function(d) return "[" .. o.Name .. "]\n" .. d .. " M" end }
                    end
                end
            end
            return out
        end })

    add({ id = "Island", name = "Esp Island", desc = "All island locations", scanEvery = 3,
        scan = function()
            local out = {}
            local locs = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
            if locs then
                for _, o in ipairs(locs:GetChildren()) do
                    if o.Name ~= "Sea" then
                        local part = firstPart(o)
                        if part then
                            out[#out + 1] = { key = "i_" .. o.Name, part = part, color = Color3.fromRGB(98, 252, 252),
                                fmt = function(d) return o.Name .. "\n" .. d .. " M" end }
                        end
                    end
                end
            end
            return out
        end })

    add({ id = "Flower", name = "Esp Flower", desc = "Blue / Red flowers", scanEvery = 1,
        scan = function()
            local out = {}
            for _, o in ipairs(workspace:GetChildren()) do
                if o.Name == "Flower1" or o.Name == "Flower2" then
                    local part = firstPart(o)
                    if part then
                        local nm = (o.Name == "Flower1") and "Blue Flower" or "Red Flower"
                        out[#out + 1] = { key = "fl_" .. uid(o), part = part, color = Color3.fromRGB(88, 214, 252),
                            fmt = function(d) return nm .. "\n" .. d .. " M" end }
                    end
                end
            end
            return out
        end })

    local function npcEntry(npcName, key)
        local out = {}
        local npcs = ReplicatedStorage:FindFirstChild("NPCs")
        local n = npcs and npcs:FindFirstChild(npcName)
        local hrp = n and n:FindFirstChild("HumanoidRootPart")
        if hrp then
            out[1] = { key = key, pos = hrp.Position, color = CYAN,
                fmt = function(d) return npcName .. "\n" .. d .. " M" end }
        end
        return out
    end

    add({ id = "Sword", name = "Esp Legendary Sword", desc = "Legendary Sword Dealer", scanEvery = 5,
        scan = function() return npcEntry("Legendary Sword Dealer", "npc_lsd") end })

    add({ id = "Haki", name = "Esp Haki Color", desc = "Barista Cousin (haki colour dealer)", scanEvery = 5,
        scan = function() return npcEntry("Barista Cousin", "npc_haki") end })

    add({ id = "Gear", name = "Esp Gear", desc = "Gears on Mirage / Mystic Island", scanEvery = 3,
        scan = function()
            local out = {}
            local map = workspace:FindFirstChild("Map")
            local mi = map and map:FindFirstChild("MysticIsland")
            if mi then
                for _, d in ipairs(mi:GetDescendants()) do
                    if d.Name == "Part" and d:IsA("BasePart") and d.Material == Enum.Material.Neon then
                        out[#out + 1] = { key = "g_" .. uid(d), part = d, color = CYAN,
                            fmt = function(dist) return "Gear\n" .. dist .. " M" end }
                    end
                end
            end
            return out
        end })

    add({ id = "EventIsland", name = "Esp SeaEvent Island", desc = "Mirage / Prehistoric / Kitsune island", scanEvery = 2,
        scan = function()
            local out = {}
            local locs = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
            if locs then
                for _, o in ipairs(locs:GetChildren()) do
                    if o.Name == "Mirage Island" or o.Name == "Prehistoric Island" or o.Name == "Kitsune Island" then
                        local part = firstPart(o)
                        if part then
                            out[#out + 1] = { key = "ei_" .. o.Name, part = part, color = Color3.fromRGB(80, 245, 245),
                                fmt = function(d) return o.Name .. "\n" .. d .. " M" end }
                        end
                    end
                end
            end
            return out
        end })

    add({ id = "Dealer", name = "Esp Advanced Dealer", desc = "Advanced Fruit Dealer", scanEvery = 5,
        scan = function() return npcEntry("Advanced Fruit Dealer", "npc_adv") end })

    -- runtime state per type
    for _, t in ipairs(types) do
        t.enabled = false
        t.items = {}        -- key -> { gui, label, part, anchor, last }
        t.cache = {}
        t.lastScan = 0
    end

    local function destroyItem(it)
        pcall(function() if it.gui then it.gui:Destroy() end end)
        pcall(function() if it.anchor then it.anchor:Destroy() end end)
    end

    local function clearType(t)
        for k, it in pairs(t.items) do destroyItem(it) t.items[k] = nil end
        t.cache = {}
        t.lastScan = 0
    end

    local function makeItem(t, e)
        local it = {}
        local adornee = e.part
        if not adornee and e.pos then
            local a = Instance.new("Part")
            a.Name = "ZelesEspAnchor"
            a.Transparency = 1
            a.Size = Vector3.new(1, 1, 1)
            a.Anchored = true
            a.CanCollide = false
            a.CanQuery = false
            a.CanTouch = false
            a.CFrame = CFrame.new(e.pos)
            a.Parent = anchorFolder
            it.anchor = a
            adornee = a
        end
        local gui = Instance.new("BillboardGui")
        gui.Name = "ZelesEsp_" .. t.id
        gui.AlwaysOnTop = true
        gui.Size = UDim2.new(0, 220, 0, 36)
        gui.ExtentsOffset = Vector3.new(0, 1, 0)
        if e.offset then gui.StudsOffset = e.offset end
        gui.MaxDistance = math.huge
        gui.Adornee = adornee
        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Font = Enum.Font.Code
        label.TextSize = 14
        label.TextWrapped = true
        label.Size = UDim2.new(1, 0, 1, 0)
        label.TextYAlignment = Enum.TextYAlignment.Top
        label.BackgroundTransparency = 1
        label.TextStrokeTransparency = 0.5
        label.TextColor3 = e.color or CYAN
        label.Parent = gui
        gui.Parent = root
        it.gui, it.label, it.part = gui, label, adornee
        return it
    end

    local function updateType(t, now, me)
        if now - t.lastScan >= t.scanEvery then
            t.lastScan = now
            local ok, res = pcall(t.scan)
            t.cache = ok and res or {}
            -- drop items whose target vanished
            local alive = {}
            for _, e in ipairs(t.cache) do alive[e.key] = true end
            for k, it in pairs(t.items) do
                if not alive[k] then destroyItem(it) t.items[k] = nil end
            end
        end
        for _, e in ipairs(t.cache) do
            local it = t.items[e.key]
            if not it or (it.gui and not it.gui.Parent) then
                if it then destroyItem(it) end
                local ok, made = pcall(makeItem, t, e)
                if ok then it = made t.items[e.key] = it else it = nil end
            end
            if it then
                local pos = (e.part and e.part.Parent) and e.part.Position or e.pos
                if pos and me then
                    local d = math.floor((me - pos).Magnitude / 3 + 0.5)
                    local text = e.fmt(d)
                    if it.last ~= text then
                        it.last = text
                        it.label.Text = text
                    end
                end
            end
        end
    end
    -- single shared driver
    local driverRunning = false
    local function anyEnabled()
        for _, t in ipairs(types) do if t.enabled then return true end end
        return false
    end
    local function startDriver()
        if driverRunning then return end
        driverRunning = true
        task.spawn(function()
            while anyEnabled() and _G.ScriptVersion == espVersion do
                local now = os.clock()
                local me = myPos()
                for _, t in ipairs(types) do
                    if t.enabled then pcall(updateType, t, now, me) end
                end
                task.wait(0.25)
            end
            driverRunning = false
            -- loop ended because of Unload (ScriptVersion bumped): remove everything
            if _G.ScriptVersion ~= espVersion then
                for _, t in ipairs(types) do t.enabled = false clearType(t) end
            end
        end)
    end

    for _, t in ipairs(types) do
        ESPSection:NewToggle(t.name, t.desc, function(state)
            t.enabled = state
            if state then
                startDriver()
            else
                clearType(t)
            end
        end)
    end

    -- hook for the Unload button
    _G.ZelesESPShutdown = function()
        for _, t in ipairs(types) do t.enabled = false clearType(t) end
        pcall(function() root:Destroy() end)
        pcall(function() anchorFolder:Destroy() end)
    end
end

