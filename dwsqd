        local function enforceOnlySelected(char)
            if not _G.selectedWeapon or not isEquipRequired() then return end
            local targetTip = getSelectedToolTip()
            for _, child in pairs(char:GetChildren()) do
                if child:IsA("Tool") then
                    local shouldKeep = false
                    if targetTip then
                        shouldKeep = (child.ToolTip == targetTip)
                    else
                        shouldKeep = (child.Name == _G.selectedWeapon)
                    end
                    if not shouldKeep then
                        pcall(function()
                            child.Parent = LocalPlayer.Backpack
                        end)
                    end
                end
            end
        end

        local function setupCharacter(char)
            if _G.ScriptVersion ~= myVersion then return end
            char:WaitForChild("Humanoid")
            task.wait(0.5)
            if isEquipRequired() then
                equipSelected()
                enforceOnlySelected(char)
            end

            -- Listen for new tools being equipped
            char.ChildAdded:Connect(function(child)
                if _G.ScriptVersion ~= myVersion then return end
                if not _G.selectedWeapon or not isEquipRequired() then return end
                if child:IsA("Tool") and not isSelectedWeapon(child) then
                    task.wait(0.1) -- brief delay to avoid conflict
                    pcall(function()
                        child.Parent = LocalPlayer.Backpack
                    end)
                end
            end)

            -- If the selected weapon is removed (e.g., manually), re-equip it
            char.ChildRemoved:Connect(function(child)
                if _G.ScriptVersion ~= myVersion then return end
                if not isEquipRequired() then return end
                if isSelectedWeapon(child) then
                    task.wait(0.1)
                    equipSelected()
                end
            end)
        end

        -- Initial character
        if LocalPlayer.Character then
            setupCharacter(LocalPlayer.Character)
        end

