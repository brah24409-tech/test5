do
    -- Server Tab (Server & Teleport / Low Player Server Hop)
    ServerTab = Window:NewTab("Server")

    local serverSection = ServerTab:NewSection("Server & Teleport")

    local cfg = {
        lowPlayerServer = false,
        maxPlayersForHop = 8,
    }

    local function getRootPlaceId()
        if typeof(isSea3) == "function" and isSea3() then return 7449423635 end
        if typeof(isSea2) == "function" and isSea2() then return 4442272183 end
        if typeof(isSea1) == "function" and isSea1() then return 2753915549 end
        local pId = game.PlaceId
        if pId == 2753915549 or pId == 85211729168715 then return 2753915549 end
        if pId == 4442272183 or pId == 79091703265657 then return 4442272183 end
        if pId == 7449423635 or pId == 100117331123089 or pId == 10011733112309 then return 7449423635 end
        return pId
    end

    local isHopping = false
    local function ServerHop()
        if isHopping then return end
        isHopping = true

        pcall(function()
            Notify("Server Hop", "Checking servers, please wait...", 3)
        end)

        task.spawn(function()
            local targetPlaceId = getRootPlaceId()
            local servers = {}
            local req = (syn and syn.request) or http_request or request or (http and http.request)
            local body = nil

            if req then
                local s, res = pcall(function()
                    return req({
                        Url = "https://games.roblox.com/v1/games/" .. tostring(targetPlaceId) .. "/servers/Public?sortOrder=Asc&limit=100",
                        Method = "GET"
                    })
                end)
                if s and res and (res.StatusCode == 200 or res.Status == 200) then
                    body = res.Body or res.body
                end
            end

            if not body then
                pcall(function()
                    body = game:HttpGet("https://games.roblox.com/v1/games/" .. tostring(targetPlaceId) .. "/servers/Public?sortOrder=Asc&limit=100")
                end)
            end

            if body then
                local s, parsed = pcall(function()
                    return game:GetService("HttpService"):JSONDecode(body)
                end)
                if s and parsed and parsed.data then
                    for _, server in pairs(parsed.data) do
                        local playing = tonumber(server.playing) or 0
                        local maxp = tonumber(server.maxPlayers) or 12
                        -- Filter: must be active (>=1 player), have space (<maxPlayers), be <= threshold, and not current server
                        if playing >= 1 and playing < maxp and playing <= cfg.maxPlayersForHop and server.id ~= game.JobId then
                            table.insert(servers, {
                                id = server.id,
                                playing = playing,
                                maxPlayers = maxp
                            })
                        end
                    end
                end
            end

            local p = LocalPlayer or game:GetService("Players").LocalPlayer

            if #servers > 0 then
                -- Sort by lowest player count first
                table.sort(servers, function(a, b)
                    return a.playing < b.playing
                end)

                local chosenServer = servers[1]
                pcall(function()
                    Notify("Server Hop", "Found server with " .. tostring(chosenServer.playing) .. "/" .. tostring(chosenServer.maxPlayers) .. " players! Connecting...", 4)
                end)

                local success = pcall(function()
                    TeleportService:TeleportToPlaceInstance(targetPlaceId, chosenServer.id, p)
                end)

                if not success and #servers > 1 then
                    task.wait(1.5)
                    local secondServer = servers[2]
                    pcall(function()
                        Notify("Server Hop", "Retrying with server (" .. tostring(secondServer.playing) .. "/" .. tostring(secondServer.maxPlayers) .. " players)...", 3)
                        TeleportService:TeleportToPlaceInstance(targetPlaceId, secondServer.id, p)
                    end)
                end
            else
                pcall(function()
                    Notify("Server Hop", "No server with <=" .. tostring(cfg.maxPlayersForHop) .. " players found. Teleporting to public instance...", 3)
                    TeleportService:Teleport(targetPlaceId, p)
                end)
            end

            task.wait(5)
            isHopping = false
        end)
    end

    serverSection:NewButton("Server Hop Now", "Searches for a server with low players and hops immediately", function()
        ServerHop()
    end)

    serverSection:NewToggle("Find Low Player Server", "Continuously hops if current server player count is too high", function(Value)
        cfg.lowPlayerServer = Value
        if Value and not isHopping then
            local currentPlayers = #game:GetService("Players"):GetPlayers()
            if currentPlayers > cfg.maxPlayersForHop then
                ServerHop()
            end
        end
    end)

    local hopSlider = serverSection:NewSlider("Max Players for Hop", "Filter servers with player count below this limit (Default: 8)", 20, 1, function(Value)
        cfg.maxPlayersForHop = Value
    end)

    pcall(function()
        if hopSlider and hopSlider.Set then
            hopSlider:Set(8)
        end
    end)

    serverSection:NewButton("Rejoin Current Server", "Rejoins your current server instance", function()
        pcall(function()
            local p = LocalPlayer or game:GetService("Players").LocalPlayer
            local targetPlaceId = getRootPlaceId()
            TeleportService:TeleportToPlaceInstance(targetPlaceId, game.JobId, p)
        end)
    end)

    serverSection:NewButton("Copy Job ID", "Copies current server Job ID to clipboard", function()
        pcall(function()
            if setclipboard then setclipboard(game.JobId) elseif toclipboard then toclipboard(game.JobId) end
        end)
        Notify("Server Control", "Copied JobID to clipboard!", 3)
    end)

    -- Background watcher for Find Low Player Server
    task.spawn(function()
        while true do
            task.wait(10)
            if cfg.lowPlayerServer and not isHopping then
                local currentPlayers = #game:GetService("Players"):GetPlayers()
                if currentPlayers > cfg.maxPlayersForHop then
                    ServerHop()
                    task.wait(15)
                end
            end
        end
    end)
