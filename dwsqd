function Library.CreateLib(title, theme)
    local windowWrapper = {}

    function windowWrapper:NewTab(tabName)
        tabCount = tabCount + 1
        pcall(function()
            Splash:SetProgress(math.min(0.92, 0.15 + tabCount * 0.038), "loading " .. tostring(tabName):lower())
        end)

        local desc = TabDescriptions[tabName] or "Options and features"

        local NoirTab = NoirWindow:Tab({
            Name = tabName,
            Icon = nil,
            Description = desc,
        })
        firstTab = firstTab or NoirTab
        _G.ZelesUI.firstTab = firstTab
        tabsByName[tabName] = NoirTab

        local tabData = {
            name = tabName,
            noirTab = NoirTab,
            sections = {},
            textBoxes = {}
        }
        tabList[tabCount] = tabData

        local tabWrapper = {}
        local sectionCount = 0

        function tabWrapper:NewSection(secName, sideOption)
            sectionCount = sectionCount + 1
            local side = sideOption or (sectionCount % 2 == 1 and "Left" or "Right")
            local NoirSection = NoirTab:Section({
                Name = secName,
                Side = side
            })

            local secWrapper = {}
            tabData.sections[secName] = secWrapper

            function secWrapper:NewToggle(name, desc, callback)
                local flagName = tabName .. "_" .. secName .. "_" .. name
                local toggleObj = NoirSection:Toggle({
                    Name = name,
                    Tooltip = desc,
                    Callback = callback,
                    Flag = flagName,
                })
                if _G.OrionLib and _G.OrionLib.Flags then
                    _G.OrionLib.Flags[flagName] = toggleObj
                end
                return toggleObj
            end

            function secWrapper:NewButton(name, desc, callback)
                local btnObj = NoirSection:Button({
                    Name = name,
                    Tooltip = desc,
                    Callback = callback,
                })
                local btnWrapper = { currentName = name }
                function btnWrapper:Set(newText)
                    btnWrapper.currentName = newText
                    if btnObj and btnObj.SetText then
                        pcall(function() btnObj:SetText(newText) end)
                    end
                end
                return btnWrapper
            end

            function secWrapper:NewDropdown(name, desc, list, callback, defaultVal)
                local flagName = tabName .. "_" .. secName .. "_" .. name
                local initialVal = defaultVal or (list and list[1]) or ""
                local dropObj = NoirSection:Dropdown({
                    Name = name,
                    Tooltip = desc,
                    Options = list or {},
                    Default = initialVal,
                    Callback = callback,
                    Flag = flagName,
                })
                if _G.OrionLib and _G.OrionLib.Flags then
                    _G.OrionLib.Flags[flagName] = dropObj
                end
                local dropWrapper = {}
                function dropWrapper:Refresh(newList)
                    if dropObj and dropObj.Refresh then
                        pcall(function() dropObj:Refresh(newList or {}, true) end)
                    end
                end
                function dropWrapper:Set(newVal)
                    if dropObj and dropObj.Set then
                        pcall(function() dropObj:Set(newVal, false) end)
                    end
                end
                function dropWrapper:Get()
                    return dropObj and dropObj.Get and dropObj:Get() or (dropObj and dropObj.Value)
                end
                return dropWrapper
            end

            function secWrapper:NewMultiDropdown(name, desc, list, callback, defaultList)
                local flagName = tabName .. "_" .. secName .. "_" .. name
                local selected = {}
                if defaultList then
                    for _, v in ipairs(defaultList) do selected[v] = true end
                else
                    for _, v in ipairs(list or {}) do selected[v] = true end
                end
                local dropObj = NoirSection:Dropdown({
                    Name = name,
                    Tooltip = desc,
                    Options = list or {},
                    Multi = true,
                    Default = selected,
                    Callback = function(chosenMap)
                        if callback then pcall(callback, chosenMap) end
                    end,
                    Flag = flagName,
                })
                if _G.OrionLib and _G.OrionLib.Flags then
                    _G.OrionLib.Flags[flagName] = dropObj
                end
                local multiWrapper = {}
                function multiWrapper:Set(val)
                    if dropObj and dropObj.Set then
                        pcall(function() dropObj:Set(val) end)
                    end
                end
                function multiWrapper:Refresh(newList)
                    if dropObj and dropObj.Refresh then
                        pcall(function() dropObj:Refresh(newList or {}, true) end)
                    end
                end
                function multiWrapper:Get()
                    return dropObj and dropObj.Get and dropObj:Get() or (dropObj and dropObj.Value)
                end
                return multiWrapper
            end

            function secWrapper:NewSlider(name, desc, max, min, callback, defaultVal)
                local flagName = tabName .. "_" .. secName .. "_" .. name
                local minVal = tonumber(min) or 0
                local maxVal = tonumber(max) or 100
                local initialVal = tonumber(defaultVal) or minVal
                local sliderObj = NoirSection:Slider({
                    Name = name,
                    Tooltip = desc,
                    Min = minVal,
                    Max = maxVal,
                    Default = initialVal,
                    Increment = 1,
                    Callback = callback,
                    Flag = flagName,
                })
                if _G.OrionLib and _G.OrionLib.Flags then
                    _G.OrionLib.Flags[flagName] = sliderObj
                end
                local sliderWrapper = {}
                function sliderWrapper:Set(val)
                    if sliderObj and sliderObj.Set then
                        pcall(function() sliderObj:Set(val) end)
                    end
                end
                function sliderWrapper:Get()
                    return sliderObj and sliderObj.Get and sliderObj:Get() or (sliderObj and sliderObj.Value)
                end
                return sliderWrapper
            end

            function secWrapper:NewTextBox(name, placeholder, callback)
                local flagName = tabName .. "_" .. secName .. "_" .. name
                local inputObj = NoirSection:Input({
                    Name = name,
                    Placeholder = placeholder or "Type here...",
                    Finished = false,
                    Callback = callback,
                    Flag = flagName,
                })
                if _G.OrionLib and _G.OrionLib.Flags then
                    _G.OrionLib.Flags[flagName] = inputObj
                end
                local tbWrapper = {}
                function tbWrapper:GetText()
                    return inputObj and inputObj.Get and inputObj:Get() or (inputObj and inputObj.Value) or ""
                end
                function tbWrapper:SetText(txt)
                    if inputObj and inputObj.Set then
                        pcall(function() inputObj:Set(txt) end)
                    end
                end
                return tbWrapper
            end

            function secWrapper:NewLabel(text)
                local lblObj = NoirSection:Label({ Name = text or "" })
                local lblWrapper = { currentText = text }
                function lblWrapper:Set(newText)
                    lblWrapper.currentText = newText
                    if lblObj and lblObj.Set then
                        pcall(function() lblObj:Set(newText) end)
                    end
                end
                function lblWrapper:Update(newText)
                    lblWrapper:Set(newText)
                end
                return lblWrapper
            end

            function secWrapper:NewTextList(name, desc, callback)
                return secWrapper:NewLabel(name or "TextList")
            end

            return secWrapper
        end

        return tabWrapper
    end

    return windowWrapper
end

