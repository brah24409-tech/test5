				local localCorner = corner - ScreenGui.AbsolutePosition
				bubble.Position = UDim2.fromOffset(math.clamp(localCorner.X + 26, math.min(34, vp.X / 2), math.max(vp.X / 2, vp.X - 34)), math.clamp(localCorner.Y + 26, math.min(34, vp.Y / 2), math.max(vp.Y / 2, vp.Y - 34)))
			end
			self:SetOpen(false)
            main.Visible = false
            bubble.Visible = true
            bubbleScale.Scale = 0.96
            bubbleTween = Tween(bubbleScale, TweenInfo.new(0.12, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Scale = 1 })
