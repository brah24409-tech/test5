    local function MaintainCombatAnchor(targetCF, heightOffset, mobInstance)
        _G.ZelesAnchorStamp = tick() -- watchdog heartbeat: an anchor only lives while something keeps refreshing it
        local char = LocalPlayer.Character
        if not char or not char:IsDescendantOf(workspace) then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        -- 1. Ground Lock & Combat Positioning Calculations
        local targetPos = (typeof(targetCF) == "CFrame" and targetCF.Position) or (typeof(targetCF) == "Vector3" and targetCF) or hrp.Position
        local targetRot = (typeof(targetCF) == "CFrame" and targetCF.Rotation) or CFrame.Angles(0, 0, 0)
        local yOff = (heightOffset ~= nil) and heightOffset or 15

        -- Desync Prevention: Never instant-snap or maintain anchor over 55 studs away!
        -- Instant CFrame snaps cause the server to reject position updates, leaving the server-side player behind
        local hoverDesiredPos = targetPos + Vector3.new(0, yOff, 0)
        local currentDist = (hoverDesiredPos - hrp.Position).Magnitude
        if currentDist > 55 then
            ClearCombatAnchor()
            local tpFn = TP or _G.TP
            if tpFn then
                pcall(function()
                    tpFn(CFrame.new(hoverDesiredPos), true)
                end)
            end
            return
        end

        -- 2. Anti-gravity & physics anchor via BodyVelocity (only within combat range)
        if not _hoverBV or _hoverBV.Parent ~= hrp then
            ClearCombatAnchor()
            local bv = Instance.new("BodyVelocity")
            bv.Name = "Zeles_CombatAnchor_BV"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.P = 9e9
            bv.Parent = hrp
            _hoverBV = bv
        else
            _hoverBV.Velocity = Vector3.new(0, 0, 0)
        end

        -- 3. Clear residual velocities to prevent server desync/falling flags
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.RotVelocity = Vector3.new(0, 0, 0)
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)

        -- 4. Prevent sitting or ragdoll states from mob attacks
        if hum.Sit then hum.Sit = false end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end

        -- 5. Disable part collisions to avoid fling impulses
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end

        if yOff > 0 then
            -- Find and lock ground level beneath target to prevent sky desync / elevator climbing
            if not _combatTargetGroundY or not _lastCombatTargetPos or (_lastCombatTargetPos - targetPos).Magnitude > 25 then
                _lastCombatTargetPos = targetPos
                local groundY = nil
                pcall(function()
                    local p = RaycastParams.new()
                    p.FilterType = Enum.RaycastFilterType.Exclude
                    p.IgnoreWater = true
                    local exList = { char }
                    local enemies = workspace:FindFirstChild("Enemies")
                    if enemies then table.insert(exList, enemies) end
                    p.FilterDescendantsInstances = exList
                    local r = workspace:Raycast(targetPos + Vector3.new(0, 10, 0), Vector3.new(0, -150, 0), p)
                    if r then groundY = r.Position.Y end
                end)
                _combatTargetGroundY = groundY or targetPos.Y
                _G._combatTargetGroundY = _combatTargetGroundY
            end

            -- Clamp target Y: never follow mobs upward into the sky
            local clampedTargetY = targetPos.Y
            if _combatTargetGroundY then
                clampedTargetY = math.clamp(targetPos.Y, _combatTargetGroundY - 4, _combatTargetGroundY + 3)
            end

            -- Suppress mob upward physics impulses from weapons (Electric Claw combos, etc.)
            local mobHrp = nil
            if mobInstance and mobInstance:IsA("Model") then
                mobHrp = mobInstance:FindFirstChild("HumanoidRootPart") or mobInstance.PrimaryPart
            elseif typeof(targetCF) == "Instance" and targetCF:IsA("BasePart") then
                mobHrp = targetCF
            end
            if mobHrp then
                pcall(function()
                    if mobHrp.Parent then
                        for _, p in ipairs(mobHrp.Parent:GetDescendants()) do
                            if p:IsA("BasePart") and p.CanCollide then
                                p.CanCollide = false
                            end
                        end
                    end
                    if mobHrp.Velocity.Y > 0 then
                        mobHrp.Velocity = Vector3.new(mobHrp.Velocity.X, -10, mobHrp.Velocity.Z)
                    end
                    if mobHrp.AssemblyLinearVelocity.Y > 0 then
                        mobHrp.AssemblyLinearVelocity = Vector3.new(mobHrp.AssemblyLinearVelocity.X, -10, mobHrp.AssemblyLinearVelocity.Z)
                    end
                    if _combatTargetGroundY and (mobHrp.Position.Y - _combatTargetGroundY) > 3.5 then
                        mobHrp.CFrame = CFrame.new(mobHrp.Position.X, _combatTargetGroundY + 1.5, mobHrp.Position.Z) * mobHrp.CFrame.Rotation
                        mobHrp.Velocity = Vector3.new(0, 0, 0)
                        mobHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end)
            end

            local hoverPos = Vector3.new(targetPos.X, clampedTargetY + yOff, targetPos.Z)

            -- 6. Rock-solid CFrame with downward pitch angle: ZERO GIMBAL LOCK & ZERO FLICKERING
            hrp.CFrame = CFrame.new(hoverPos) * targetRot * CFrame.Angles(math.rad(-30), 0, 0)
        else
            -- Flat position (e.g. inside raid tube)
            hrp.CFrame = CFrame.new(targetPos) * targetRot
        end
    end
