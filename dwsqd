                        task.wait(1)
                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("BartiloQuestProgress", "Bartilo")
                        task.wait(1)
                    else
                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("BartiloQuestProgress", "Bartilo")
                        task.wait(1)
                        OrionLib:MakeNotification({
                            Name = "Coliseum Quest",
                            Content = "Farming Jeremy Boss...",
                            Time = 3
                        })
                        TP(CFrame.new(2338.00, 451.43, 700.11), true)
                        task.wait(1)
                    end
                end
                
                -- Farming Jeremy loop
                while _G.AutoColiseumQuest and not progress.KilledSpring do
                    if _G.ScriptVersion ~= myVersion then break end
                    local enemy = nil
                    for _, v in pairs(workspace.Enemies:GetChildren()) do
                        if v.Name:find("Jeremy") and v:FindFirstChildOfClass("Humanoid") and (v:FindFirstChildOfClass("Humanoid") and v:FindFirstChildOfClass("Humanoid").Health or 0) > 0 and v:FindFirstChild("HumanoidRootPart") then
                            enemy = v
                            break
                        end
                    end
                    
                    if enemy then
                        while _G.AutoColiseumQuest and enemy and enemy.Parent and enemy:FindFirstChildOfClass("Humanoid") and (enemy:FindFirstChildOfClass("Humanoid") and enemy:FindFirstChildOfClass("Humanoid").Health or 0) > 0 do
                            local myChar = LocalPlayer.Character
                            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
                            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            if not myChar or not myHum or myHum.Health <= 0 or not myHrp or myHum:GetState() == Enum.HumanoidStateType.Dead then
                                stopAllTweens()
                                ClearCombatAnchor()
                                task.wait(1.5)
                                break
                            end

                            local enemyHrp = enemy:FindFirstChild("HumanoidRootPart")
                            if not enemyHrp then break end

                            local dist = (myHrp.Position - enemyHrp.Position).Magnitude
                            if dist > 30 then
                                if not _G.ActiveTween then
                                    TP(enemyHrp.CFrame * CFrame.new(0, 15, 0), true)
                                end
                            else
                                MaintainCombatAnchor(enemyHrp.CFrame, 15, enemy)
                                local weapon = equipWeapon()
                                if weapon then
                                    weapon:Activate()
                                end
                                SafeFire("RE/RegisterAttack", 0)
                                if enemy:FindFirstChild("Head") then
                                    SafeFire("RE/RegisterHit", enemy.Head, {}, tostring(LocalPlayer.UserId))
                                end
                            end
                            RunService.Heartbeat:Wait()
                        end
                        ClearCombatAnchor()
                    else
                        -- Teleport to Jeremy spawn if far
                        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if myHrp then
                            local spawnPos = Vector3.new(2338.00, 451.43, 700.11)
                            if (myHrp.Position - spawnPos).Magnitude > 150 then
                                TP(CFrame.new(spawnPos), true)
                                task.wait(1)
                            end
                        end
                        task.wait(0.1)
                    end
                    
                    pcall(function()
                        progress = game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("BartiloQuestProgress")
                    end)
                end
                
            elseif progress.KilledSpring and not progress.DidPlates then
                -- Step 3: Talk to Bartilo to submit Jeremy
                local character = LocalPlayer.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bartiloPos = Vector3.new(-461.53, 72.35, 300.31)
                    local dist = (hrp.Position - bartiloPos).Magnitude
                    if dist > 150 then
                        OrionLib:MakeNotification({
                            Name = "Coliseum Quest",
                            Content = "Talking to Bartilo to unlock Plates...",
                            Time = 3
                        })
                        TP(CFrame.new(bartiloPos), true)
                        task.wait(1)
                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("BartiloQuestProgress", "Bartilo")
                        task.wait(1)
                    else
                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("BartiloQuestProgress", "Bartilo")
                        task.wait(1)
                    end
                end
                
                -- Teleport to plates in order
                OrionLib:MakeNotification({
                    Name = "Coliseum Quest",
                    Content = "Activating Coliseum Plates...",
                    Time = 3
                })
                local platesFolder = workspace.Map.Dressrosa:FindFirstChild("BartiloPlates")
                if platesFolder then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    for i = 1, 8 do
                        local plate = platesFolder:FindFirstChild("Plate" .. i)
                        if plate and _G.AutoColiseumQuest then
                            if firetouchinterest and hrp then
                                firetouchinterest(hrp, plate, 0)
                                task.wait(0.2)
                                firetouchinterest(hrp, plate, 1)
                                task.wait(0.2)
                            else
                                TP(plate.CFrame * CFrame.new(0, 2, 0), true)
                                task.wait(1)
                            end
                        end
                    end
                end
                
                -- Talk to Bartilo one last time to complete the quest!
                OrionLib:MakeNotification({
                    Name = "Coliseum Quest",
                    Content = "Completing Quest with Bartilo...",
                    Time = 3
                })
                TP(CFrame.new(-461.53, 72.35, 300.31), true)
                task.wait(1)
                game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("BartiloQuestProgress", "Bartilo")
                task.wait(1)
                
                pcall(function()
                    progress = game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("BartiloQuestProgress")
                end)
                if progress and progress.DidPlates then
                    OrionLib:MakeNotification({
                        Name = "Coliseum Quest",
                        Content = "Coliseum Quest Completed Successfully!",
                        Time = 5
                    })
                else
                    OrionLib:MakeNotification({
                        Name = "Coliseum Quest",
                        Content = "Puzzle solved! Speak with Bartilo if not completed.",
                        Time = 5
                    })
                end
                _G.AutoColiseumQuest = false
            end
        end
    end)

