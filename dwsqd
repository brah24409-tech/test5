local InterFont
do
    local function loadInter()
        local HttpService = game:GetService("HttpService")
        local fontName = "InterSemiBold"
        local ttfName, dataName = fontName .. ".ttf", fontName .. ".font"
        local function validTtf(body)
            if type(body) ~= "string" or #body < 20000 then return false end
            local head = body:sub(1, 4)
            return head == "\0\1\0\0" or head == "true" or head == "OTTO"
        end
        if not (isfile and isfile(ttfName)) or not validTtf(readfile(ttfName)) then
            local urls = {
                "https://raw.githubusercontent.com/toeerolo-z/ethossuiterewriteA/main/InterSemibold%20(1).ttf",
                "https://github.com/toeerolo-z/ethossuiterewriteA/raw/main/InterSemibold%20(1).ttf",
                "https://github.com/toeerolo-z/ethossuiterewriteA/blob/main/InterSemibold%20(1).ttf?raw=true",
            }
            local got
            for _, url in ipairs(urls) do
                local ok, body = pcall(game.HttpGet, game, url)
                if ok and validTtf(body) then got = body break end
            end
            assert(got, "font download failed")
            writefile(ttfName, got)
        end
        writefile(dataName, HttpService:JSONEncode({
            name = fontName,
            faces = { { name = fontName, weight = 600, style = "normal", assetId = getcustomasset(ttfName) } },
        }))
        return Font.new(getcustomasset(dataName))
    end
    local ok, face = pcall(loadInter)
    if not ok then warn("[ZELES HUB] Inter font failed, using Gotham: " .. tostring(face)) end
    InterFont = (ok and face) or Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.SemiBold)
end



