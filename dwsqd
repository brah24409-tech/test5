    local originalTextMap = {}

    local function applyLanguageToUI(targetLang)
        local dict = Translations[targetLang] or Translations["English"]
        local engDict = Translations["English"]
        
        local function processTextObj(obj)
            if not obj:IsA("TextLabel") and not obj:IsA("TextButton") and not obj:IsA("TextBox") then return end
            local currentText = obj.Text
            if not currentText or currentText == "" then return end

            local originalKey = originalTextMap[obj]
            if not originalKey then
                for engKey, _ in pairs(engDict) do
                    if currentText == engKey then
                        originalKey = engKey
                        break
                    else
                        for _, langTable in pairs(Translations) do
                            if langTable[engKey] and currentText == langTable[engKey] then
                                originalKey = engKey
                                break
                            end
                        end
                    end
                    if originalKey then break end
                end
                if originalKey then
                    originalTextMap[obj] = originalKey
                end
            end

            if originalKey and dict[originalKey] then
                obj.Text = dict[originalKey]
            end
        end

        local searchRoots = {}
        pcall(function()
            local coreGui = game:GetService("CoreGui")
            if coreGui:FindFirstChild("RobloxGui") and coreGui.RobloxGui:FindFirstChild("Orion") then
                table.insert(searchRoots, coreGui.RobloxGui.Orion)
            end
            if coreGui:FindFirstChild("Orion") then
                table.insert(searchRoots, coreGui.Orion)
            end
            for _, c in ipairs(coreGui:GetChildren()) do
                if c.Name:find("Orion") or c.Name:find("Zeles") then
                    table.insert(searchRoots, c)
                end
            end
        end)
        pcall(function()
            if gethui then
                for _, c in ipairs(gethui():GetChildren()) do
                    if c.Name:find("Orion") or c.Name:find("Zeles") then
                        table.insert(searchRoots, c)
                    end
                end
            end
        end)
        pcall(function()
            local plrGui = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
            if plrGui then
                for _, c in ipairs(plrGui:GetChildren()) do
                    if c.Name:find("Orion") or c.Name:find("Zeles") then
                        table.insert(searchRoots, c)
                    end
                end
            end
        end)

        for _, root in ipairs(searchRoots) do
            if root then
                for _, desc in ipairs(root:GetDescendants()) do
                    pcall(function() processTextObj(desc) end)
                end
            end
        end
    end

