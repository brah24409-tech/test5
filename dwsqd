    local function executeSeaSkillRotation(enemy, targetPart)
        if not enemy or not enemy.Parent or not isEntityAlive(enemy) then return end
        targetPart = targetPart or enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("Head") or enemy.PrimaryPart
        if not targetPart then return end

        for _, cat in ipairs(seaSkillCategories) do
            if not _G.AutoSeaFarm or not enemy or not enemy.Parent or not isEntityAlive(enemy) then
                break
            end

            local hasWeapon = false
            local char = LocalPlayer.Character
            if char then
                for _, t in ipairs(char:GetChildren()) do
                    if t:IsA("Tool") and t.ToolTip == cat.tip then
                        hasWeapon = true
                        break
                    end
                end
            end
            if not hasWeapon and LocalPlayer:FindFirstChild("Backpack") then
                for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
                    if t:IsA("Tool") and t.ToolTip == cat.tip then
                        hasWeapon = true
                        break
                    end
                end
            end

            if hasWeapon then
                local tool = equipWeaponCategory(cat.tip)
                if tool and tool.Parent == char then
                    local toolName = tool.Name
                    task.wait(0.04)
                    
                    for _, key in ipairs(cat.keys) do
                        if not _G.AutoSeaFarm or not enemy or not enemy.Parent or not isEntityAlive(enemy) then
                            break
                        end

                        if isSeaSkillReady(toolName, key) then
                            aimAtSeaTarget(targetPart)
                            
                            pcall(function()
                                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                                task.wait(0.08)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                            end)
                            
                            pcall(function()
                                SmartAttackTarget(enemy)
                            end)
                            
                            task.wait(0.06)
                        end
                    end
                end
            end
        end

        equipWeapon(true)
    end
    _G.executeSeaSkillRotation = executeSeaSkillRotation

    -- Banana Hub combat logic (Word-for-word skill rotation for Sea Beast + Bring Mobs)
    local function handleSeaCombat(enemy, targetType, boat)
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then return end
        
        humanoid.Sit = false
        task.wait(0.1)
        humanoid.Jump = true
        task.wait(0.4)
        
        local noclipConn = RunService.Stepped:Connect(function()
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
        
        local hoverBv = root:FindFirstChild("Zeles_SeaHover_BV")
        if not hoverBv then
            hoverBv = Instance.new("BodyVelocity")
            hoverBv.Name = "Zeles_SeaHover_BV"
            hoverBv.Velocity = Vector3.new(0, 0, 0)
            hoverBv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            hoverBv.P = 9e9
            hoverBv.Parent = root
        end
        root.Anchored = false

        local isSeaMonster = (targetType == "Sea Beast" or targetType == "Leviathan")
        local isBoat = (targetType == "Fish Boat" or targetType == "Pirate Grand Brigade" or targetType == "Ghost Ship")
        
        while enemy and enemy.Parent and isEntityAlive(enemy) do
            if not _G.AutoSeaFarm or not isTargetAllowed(enemy.Name) then
                break
            end

            local targetPart = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("Leviathan Segment") or enemy:FindFirstChild("Head") or enemy.PrimaryPart
            if not targetPart then break end
            
            local targetCF
            if isSeaMonster then
                -- Sea Beast & Leviathan positioning (+200 above water plane)
                local waterPlane = workspace.Map:FindFirstChild("WaterBase-Plane")
                local planeY = (waterPlane and waterPlane.Position.Y) or targetPart.Position.Y
                local attackPos = Vector3.new(targetPart.Position.X, planeY + 200, targetPart.Position.Z)
                targetCF = CFrame.new(attackPos, targetPart.Position)
            elseif isBoat then
                -- Boat targets: hover 30 studs above
                local attackPos = targetPart.Position + Vector3.new(0, 30, 0)
                targetCF = CFrame.new(attackPos, targetPart.Position)
            else
                -- Mobs taking pure fast M1 remote spam: Shark, Terror Shark, Piranha
                local isTerrorShark = (targetType == "Terror Shark")
                local yOffset = isTerrorShark and 45 or 15
                targetCF = CFrame.new(targetPart.Position + Vector3.new(0, yOffset, 0), targetPart.Position)
            end

            local dist = (targetCF.Position - root.Position).Magnitude
            if dist > 60 then
                TP(targetCF, true)
            else
                root.CFrame = targetCF
                root.Velocity = Vector3.zero
            end

            -- Combat execution
            SmartAttackTarget(enemy)
            if isSeaMonster or isBoat or (targetType == "Terror Shark") then
                executeSeaSkillRotation(enemy, targetPart)
            else
                task.wait(0.02)
            end
            task.wait(0.03)
        end
        
        if not isEntityAlive(enemy) then
            _G.YellowBeltKills = (_G.YellowBeltKills or 0) + 1
            if _G.AutoDojoBelt then
                print(string.format("[DOJO-BELT] Sea Entity Defeated (%s)! Yellow Belt Progress: %d/5", tostring(targetType or enemy.Name), _G.YellowBeltKills))
                if OrionLib and OrionLib.MakeNotification then
                    pcall(function()
                        OrionLib:MakeNotification({
                            Name = "Yellow Belt Progress",
                            Content = string.format("Sea Entity Defeated (%s)! Progress: %d/5", tostring(targetType or enemy.Name), _G.YellowBeltKills),
                            Time = 3
                        })
                    end)
                end
            end
        end

        if hoverBv and hoverBv.Parent then
            pcall(function() hoverBv:Destroy() end)
        end
        root.Anchored = false
        noclipConn:Disconnect()
        
        if boat and boat.Parent then
            local seat = boat:FindFirstChildOfClass("VehicleSeat")
            if seat then
                local startPos = root.Position
                local targetPos = seat.Position + Vector3.new(0, 3, 0)
                local duration = math.clamp((targetPos - startPos).Magnitude / 250, 0.2, 3)
                local startTime = os.clock()
                
                local returnNoclip = RunService.Stepped:Connect(function()
                    if char then
                        for _, part in pairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                end)
                
                while os.clock() - startTime < duration do
                    local t = (os.clock() - startTime) / duration
                    root.CFrame = CFrame.new(startPos:Lerp(targetPos, t))
                    task.wait()
                end
                root.CFrame = CFrame.new(targetPos)
                returnNoclip:Disconnect()
                task.wait(0.2)
                
                seat:Sit(humanoid)
                task.wait(0.4)
            end
        end
    end

    local function startJourney()
        local mySession = (_G.SeaJourney_SessionId or 0) + 1
        _G.SeaJourney_SessionId = mySession

        if not _G.AutoSeaFarm and not _G.AutoDojoBelt then return end

        local myBoat = checkSittingInBoat() or getMyBoat()
        
        if not myBoat then
            myBoat = spawnBoatAtTiki()
        else
            sitInBoat(myBoat)
        end
        
        if not myBoat or not _G.AutoSeaFarm or _G.SeaJourney_SessionId ~= mySession then
            return
        end
        
        local seat = myBoat:FindFirstChildOfClass("VehicleSeat")
        if not seat then
            return
        end
        
        while _G.AutoSeaFarm and (_G.AutoDojoBelt or isAnyAutomationActive()) and _G.SeaJourney_SessionId == mySession and myBoat and myBoat.Parent do
            if not checkSittingInBoat() then
                if not _G.AutoSeaFarm or _G.SeaJourney_SessionId ~= mySession then break end
                sitInBoat(myBoat)
            end

            -- Mirage Island & Blue Gear Auto-TP Check
            local mirage = workspace.Map:FindFirstChild("Mirage Island") or (workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin.Locations:FindFirstChild("Mirage Island")) or workspace:FindFirstChild("Mirage Island")
            local gear = workspace:FindFirstChild("Mysterious Dev", true)
            
            if mirage or gear then
                local target = gear or mirage
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if root and humanoid then
                    humanoid.Sit = false
                    task.wait(0.2)
                    root.CFrame = target:GetPivot() + Vector3.new(0, gear and 2 or 50, 0)
                    task.wait(2)
                end
                task.wait(2)
                continue
            end

            local boatParts = myBoat:GetDescendants()
            for _, part in pairs(boatParts) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
            
            local seaBeast, sbType = findSeaBeast()
            if seaBeast then
                handleSeaCombat(seaBeast, sbType, myBoat)
            end
            if not _G.AutoSeaFarm or _G.SeaJourney_SessionId ~= mySession then break end
            
            local seaEvent, seType = findSeaEvent()
            if seaEvent then
                handleSeaCombat(seaEvent, seType, myBoat)
            end
            if not _G.AutoSeaFarm or _G.SeaJourney_SessionId ~= mySession then break end
            
            local chosenLevel = _G.SeaStopLevel or "Lv 6"
            local destination = SeaDangerZones[chosenLevel] or SeaDangerZones["Lv 6"]
            local diff = Vector3.new(destination.X - seat.Position.X, 0, destination.Z - seat.Position.Z)
            local dist = diff.Magnitude

            local isInfinite = (chosenLevel == "Infinite" or chosenLevel == "Lv Infinite")
            if not isInfinite and dist <= 100 then
                -- Reached the target danger zone level: hold position, scan and fight spawns
                task.wait(0.25)
            else
                local targetDir = diff.Unit
                local stepDist = (_G.TweenSpeed or 250) * task.wait()
                if not isInfinite and dist < stepDist then
                    stepDist = dist
                end
                local currentPos = seat.Position
                local nextPos = currentPos + targetDir * stepDist
                if not _G.AutoSeaFarm or _G.SeaJourney_SessionId ~= mySession then break end
                myBoat:PivotTo(CFrame.new(nextPos, nextPos + targetDir))
            end
        end
    end
