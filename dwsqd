    local function getChestsSorted()
        local now = os.clock()
        if FirstRun or #UncheckedChests == 0 then
            FirstRun = false
            UncheckedChests = {}
            local Objects = workspace:GetDescendants()
            for i, Object in pairs(Objects) do
                if Object.Name:find("Chest") and (Object.ClassName == "Part" or Object:IsA("BasePart")) then
                    table.insert(UncheckedChests, Object)
                end
            end
        end
        local Chests = {}
        for i, Chest in pairs(UncheckedChests) do
            if Chest and Chest.Parent and Chest:FindFirstChild("TouchInterest") then
                if not blacklistedChests[Chest] or now > blacklistedChests[Chest] then
                    table.insert(Chests, Chest)
                end
            end
        end
        if #Chests == 0 then
            -- Fallback scan: if all cached chests lost TouchInterest or new chests streamed in, rescan workspace descendants
            UncheckedChests = {}
            for _, Object in ipairs(workspace:GetDescendants()) do
                if Object.Name:find("Chest") and (Object.ClassName == "Part" or Object:IsA("BasePart")) then
                    table.insert(UncheckedChests, Object)
                    if Object:FindFirstChild("TouchInterest") then
                        if not blacklistedChests[Object] or now > blacklistedChests[Object] then
                            table.insert(Chests, Object)
                        end
                    end
                end
            end
        end
        DistanceFromPlrSort(Chests)
        return Chests
    end

