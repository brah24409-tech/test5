local function find1MFruitInTools()
    local fruitNames = {
        "quake", "buddha", "love", "creation", "spider", "sound",
        "phoenix", "portal", "rumble", "lightning", "pain", "blizzard",
        "gravity", "mammoth", "t-rex", "trex", "dough", "shadow",
        "venom", "gas", "spirit", "tiger", "yeti", "kitsune",
        "control", "dragon", "leopard", "magnet"
    }
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    for _, container in ipairs({backpack, char}) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") then
                    if tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Gun" then
                        continue
                    end
                    local tName = tool.Name:lower()
                    if tName:find("claw") or tName:find("breath") or tName:find("talon") or tName:find("step")
                       or tName:find("karate") or tName:find("combat") or tName:find("katana") or tName:find("blade")
                       or tName:find("rod") or tName:find("helmet") or tName:find("hat") or tName:find("cape") then
                        continue
                    end

                    local isFruit = (tool.ToolTip == "Blox Fruit")
                        or tool:FindFirstChild("Fruit") ~= nil
                        or tool:FindFirstChild("EatRemote") ~= nil
                        or tool:FindFirstChild("ClientEatScript") ~= nil
                        or tName:find("fruit") ~= nil
                        or tName:find("%-") ~= nil

                    if isFruit then
                        for _, f in ipairs(fruitNames) do
                            if tName:find(f, 1, true) then
                                return tool
                            end
                        end
                        if tName:find("legendary") or tName:find("mythical") then
                            return tool
                        end
                    end
                end
            end
        end
    end
    return nil
end

