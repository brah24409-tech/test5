    local function TryTakeNPCQuest(targetName)
        if not targetName or targetName == "" then return false end

        local hasAnyQuest, isCorrect = hasCorrectActiveQuest(targetName)
        if hasAnyQuest and isCorrect then
            return true
        end

        -- If player has another (wrong) quest active, abandon it so we can accept the correct one!
        if hasAnyQuest and not isCorrect then
            abandonActiveQuest()
            task.wait(0.2)
        end

        local mobMap = _G.MobCFrameMap or MobCFrameMap
        if not mobMap then return false end
        local mobData = mobMap[targetName] or mobMap[targetName:gsub("s$", "")]
        if not mobData or not mobData.Quest then return false end

        local questGiverCF = mobData.QuestGiver or mobData.CF
        if not questGiverCF then return false end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        -- Check Submerged Island entry/exit for the quest giver
        local isSub = _G.isSubmergedMob and _G.isSubmergedMob(targetName)
        local inSub = _G.isInsideSubmerged and _G.isInsideSubmerged()
        if isSub and not inSub then
            pcall(SubmergedEntry)
            task.wait(1)
            return false
        elseif not isSub and inSub then
            pcall(SubmergedExit)
            task.wait(1)
            return false
        end

        -- Travel to Quest Giver if distant
        local dist = (hrp.Position - questGiverCF.Position).Magnitude
        if dist > 25 then
            TP(questGiverCF, true)
            local waitStart = tick()
            while (tick() - waitStart) < 3 do
                local hasQ, correct = hasCorrectActiveQuest(targetName)
                if hasQ and correct then break end
                task.wait(0.1)
            end
        end

        -- Invoke StartQuest remote
        pcall(function()
            local rs = game:GetService("ReplicatedStorage")
            local remotes = rs:FindFirstChild("Remotes")
            local commF = remotes and remotes:FindFirstChild("CommF_")
            if commF then
                commF:InvokeServer("StartQuest", mobData.Quest, mobData.Level or 1)
            end
        end)
        task.wait(0.4)

        local finalHasQ, finalCorrect = hasCorrectActiveQuest(targetName)
        return finalHasQ and finalCorrect
    end
