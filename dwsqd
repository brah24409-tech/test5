        -- Tyrant of the Skies boss guard: NEVER bring mobs when fighting Tyrant boss
        if targetName:find("tyrant") or (_G.BossFightActive and _G.AutoTyrant) then
            return
        end

        local enemiesContainer = workspace:FindFirstChild("Enemies")
        if not enemiesContainer then return end

        local isRaid = _G.AutoRaid
        local currentRaidIslandLoc = nil
        if isRaid then
            local mainGui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("Main")
            local timer = mainGui and mainGui.TopHUDList:FindFirstChild("RaidTimer")
            if timer and timer.Visible then
                local searchContainers = {}
                if workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations") then
                    table.insert(searchContainers, workspace._WorldOrigin.Locations)
                end
                if workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("RaidMap") then
                    table.insert(searchContainers, workspace.Map.RaidMap)
                end
                for _, container in ipairs(searchContainers) do
                    for i = 1, 5 do
                        local testLoc = container:FindFirstChild("Island " .. i) or container:FindFirstChild("RaidIsland" .. i)
                        if testLoc then
                            local tPos = (testLoc:IsA("Model") and testLoc:GetPivot().Position) or (testLoc:IsA("BasePart") and testLoc.Position)
                            if tPos and (targetPos - tPos).Magnitude <= 800 then
                                currentRaidIslandLoc = tPos
                                break
                            end
                        end
                    end
                    if currentRaidIslandLoc then break end
                end
            end
        end

        local isKatakuriFarm = _G.AutoKatakuri or _G.AutoDoughKing or (katakuriMobNames and katakuriMobNames[targetName] ~= nil)
        local isTikiFarm = (_G.AutoTyrant and not _G.BossFightActive and not targetName:find("tyrant")) or (tikiMobNames and tikiMobNames[targetName] ~= nil)

        -- Damage heartbeat: if the target is losing HP we know hits are landing
        local now = tick()
        local tHum = targetEnemy:FindFirstChildOfClass("Humanoid")
        if tHum then
            local rec = _bringHpTrack[targetEnemy]
            if rec and tHum.Health < rec.hp then _lastDamageSeen = now end
            if not rec or tHum.Health ~= rec.hp then
                _bringHpTrack[targetEnemy] = { hp = tHum.Health, since = now }
            end
        end

        for _, v in pairs(enemiesContainer:GetChildren()) do
            if v ~= targetEnemy and v.Parent and not ZelesIsGhost(v) then
                local vHum = v:FindFirstChildOfClass("Humanoid")
                local vHrp = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head") or v.PrimaryPart
                if vHum and vHrp and (vHum.Health or 0) > 0 then
                    local isDead = (vHum.Health <= 0)
                        or (vHum:GetState() == Enum.HumanoidStateType.Dead)
                        or (v:FindFirstChild("Dead") ~= nil)
                        or (v:GetAttribute("Dead") == true)
                    
                    if not isDead then
                        local vName = v.Name:lower()
                        local shouldBring = false

                        if isRaid then
                            -- Inside Raid: ONLY bring mobs on the active raid island (NEVER from normal world)
                            if currentRaidIslandLoc then
                                if (vHrp.Position - currentRaidIslandLoc).Magnitude <= 800 then
                                    shouldBring = true
                                end
                            else
                                if (vHrp.Position - targetPos).Magnitude <= 400 then
                                    shouldBring = true
                                end
                            end
                        else
                            -- Normal World: ONLY bring mobs with matching quest name / island cluster (supports stripped level tags)
                            local cleanTargetName = targetName:gsub("%s*%[.-%]%s*", ""):gsub("%s+", " ")
                            local cleanVName = vName:gsub("%s*%[.-%]%s*", ""):gsub("%s+", " ")
                            if (vName == targetName) or (v.Name == targetEnemy.Name) or (cleanVName == cleanTargetName) then
                                shouldBring = true
                            elseif isKatakuriFarm and katakuriMobNames and katakuriMobNames[vName] then
                                shouldBring = true
                            elseif isTikiFarm and tikiMobNames and tikiMobNames[vName] then
                                shouldBring = true
                            end
                        end

                        if shouldBring and _mobOrigProps[v] and (vHrp.Position - targetPos).Magnitude <= 30 then
                            -- Brought + stacked mob that stopped losing HP while others are taking hits = ghost
                            local rec = _bringHpTrack[v]
                            if rec and vHum.Health < rec.hp then _lastDamageSeen = now end
                            if not rec or vHum.Health ~= rec.hp then
                                _bringHpTrack[v] = { hp = vHum.Health, since = now }
                            elseif (now - rec.since) > 8 and (now - _lastDamageSeen) < 2 then
                                ZelesMarkGhost(v)
                                shouldBring = false
                            end
                        end

                        -- Only move mobs we simulate; writing an unowned CFrame creates a client-only ghost
                        if shouldBring and not ZelesOwnsPart(vHrp) then
                            shouldBring = false
                        end

                        if shouldBring then
                            local dist = (vHrp.Position - targetPos).Magnitude
                            if dist <= 400 then
                                pcall(function()
                                    if not _mobOrigProps[v] then
                                        _mobOrigProps[v] = { WalkSpeed = vHum.WalkSpeed, JumpPower = vHum.JumpPower, AutoRotate = vHum.AutoRotate }
                                    end
                                    if sethiddenproperty then
                                        sethiddenproperty(vHrp, "NetworkIsSleeping", false)
                                    end
                                    local bringY = (_combatTargetGroundY and (_combatTargetGroundY + 1.5)) or (_G._combatTargetGroundY and (_G._combatTargetGroundY + 1.5)) or targetCF.Position.Y
                                    vHrp.CFrame = CFrame.new(targetCF.Position.X, bringY, targetCF.Position.Z) * targetCF.Rotation
                                    for _, p in pairs(v:GetChildren()) do
                                        if p:IsA("BasePart") then
                                            p.CanCollide = false
                                        end
                                    end
                                    vHum.WalkSpeed = 0
                                    vHum.JumpPower = 0
                                    vHum.PlatformStand = false
                                    vHum.Sit = false
                                    vHum.AutoRotate = false
                                    vHrp.Velocity = Vector3.new(0, 0, 0)
                                    vHrp.RotVelocity = Vector3.new(0, 0, 0)
                                    pcall(function()
                                        vHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        vHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                    end)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
