local function getEliteSpawnCFrame(statusText)
    if not statusText or type(statusText) ~= "string" then return CFrame.new(-12500, 350, -8500) end
    local sLower = statusText:lower()
    if sLower:find("floating turtle") or sLower:find("turtle") then
        return CFrame.new(-12500, 350, -8500)
    elseif sLower:find("port town") or sLower:find("port") then
        return CFrame.new(-2850, 50, 5450)
    elseif sLower:find("great tree") or sLower:find("tree") then
        return CFrame.new(2500, 430, -7200)
    elseif sLower:find("hydra") then
        return CFrame.new(5400, 600, 600)
    end
    return CFrame.new(-12500, 350, -8500)
end

