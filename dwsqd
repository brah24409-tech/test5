        Notify("Upper Sky", "Clouds cleared, entering...", 3)

        pcall(function()
            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer("requestEntrance", UPPER_SKY_ENTER_POS)
        end)
        local upBy = tick() + 6
        while tick() < upBy and not isInUpperSky() do task.wait(0.25) end
        return isInUpperSky()
    end
