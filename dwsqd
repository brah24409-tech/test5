    local function getSkyClouds()
        local CS = game:GetService("CollectionService")
        local sky = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Sky")
        if not sky then return {} end
        local entrance = sky:FindFirstChild("Entrance")
        local center = entrance and entrance.Position or UPPER_SKY_PAD_CF.Position
        local list = {}
        for _, c in ipairs(CS:GetTagged("M1HitRegistry")) do
            if c:IsA("BasePart") and c:IsDescendantOf(sky) and (c.Position - center).Magnitude <= 90 then
                table.insert(list, c)
            end
        end
        return list
    end

    local function equipMeleeForClouds()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local cur = char:FindFirstChildOfClass("Tool")
        if cur and cur.ToolTip == "Melee" then return end
        for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == "Melee" then
                hum:EquipTool(t)
                task.wait(0.25)
                return
            end
        end
        if not cur then
            local any = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
            if any then hum:EquipTool(any) task.wait(0.25) end
        end
    end

    local function breakSkyClouds(timeout)
        local CS = game:GetService("CollectionService")
        local vim = game:GetService("VirtualInputManager")
        local deadline = tick() + (timeout or 45)
        equipMeleeForClouds()

        while tick() < deadline do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then return false end

            local clouds = getSkyClouds()
            if #clouds == 0 then return true end
            table.sort(clouds, function(a, b)
                return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
            end)
            local cloud = clouds[1]

            -- Stand 6 studs off the cloud facing it so the M1 hitbox overlaps it
            local flat = (hrp.Position - cloud.Position) * Vector3.new(1, 0, 1)
            local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
            local standPos = cloud.Position + dir * 6 + Vector3.new(0, 2, 0)
            local standCF = CFrame.lookAt(standPos, Vector3.new(cloud.Position.X, standPos.Y, cloud.Position.Z))
            if (hrp.Position - standPos).Magnitude > 20 then
                TP(standCF, true)
            end

            local cloudDeadline = tick() + 6
            while tick() < cloudDeadline and cloud.Parent and CS:HasTag(cloud, "M1HitRegistry") do
                hrp.CFrame = standCF
                hrp.AssemblyLinearVelocity = Vector3.zero
                local cam = workspace.CurrentCamera
                if cam then
                    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cloud.Position)
                    local vp = cam.ViewportSize
                    vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 1)
                    task.wait(0.03)
                    vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 1)
                end
                task.wait(0.15)
            end
            -- Cloud survived 6s of clicks: weapon probably got swapped, re-equip and retry
            if cloud.Parent and CS:HasTag(cloud, "M1HitRegistry") then
                equipMeleeForClouds()
            end
        end
        return #getSkyClouds() == 0
    end

