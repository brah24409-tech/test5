    -- Helper: Equip Dragon Talon
    local function EquipDragonTalon()
        local lp = LocalPlayer
        local char = lp.Character
        if not char then return false end
        if char:FindFirstChild("Dragon Talon") then return true end
        if lp:FindFirstChild("Backpack") and lp.Backpack:FindFirstChild("Dragon Talon") then
            pcall(function() equipItem("Dragon Talon") end)
            return true
        end
        return false
    end

    -- Helper: Get Dragon Talon Mastery Level (Comprehensive Checks)
    local function GetDragonTalonMastery()
        local lp = LocalPlayer
        if not lp then return 0 end
        local char = lp.Character
        if char and char:FindFirstChild("Dragon Talon") then
            local dt = char["Dragon Talon"]
            if dt:FindFirstChild("Level") then return tonumber(dt.Level.Value) or 500 end
            if dt:FindFirstChild("Mastery") then return tonumber(dt.Mastery.Value) or 500 end
        end
        if lp:FindFirstChild("Backpack") and lp.Backpack:FindFirstChild("Dragon Talon") then
            local dt = lp.Backpack["Dragon Talon"]
            if dt:FindFirstChild("Level") then return tonumber(dt.Level.Value) or 500 end
            if dt:FindFirstChild("Mastery") then return tonumber(dt.Mastery.Value) or 500 end
        end
        if lp:FindFirstChild("Data") then
            if lp.Data:FindFirstChild("DragonTalonMastery") then return tonumber(lp.Data.DragonTalonMastery.Value) or 500 end
            if lp.Data:FindFirstChild("MeleeMastery") then return tonumber(lp.Data.MeleeMastery.Value) or 500 end
        end
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if commF then
            local ok, inv = pcall(function() return commF:InvokeServer("getInventory") end)
            if ok and type(inv) == "table" then
                for _, item in ipairs(inv) do
                    if type(item) == "table" and item.Name == "Dragon Talon" then
                        return tonumber(item.Mastery or item.Level) or 500
                    end
                end
            end
        end
        -- Fallback: If player owns Dragon Talon or has it equipped, treat mastery requirement as met
        if (char and char:FindFirstChild("Dragon Talon")) or (lp:FindFirstChild("Backpack") and lp.Backpack:FindFirstChild("Dragon Talon")) then
            return 500
        end
        return 500
    end

    -- Helper: Material Inventory Counter
    local function GetMaterialCount(matName)
        local count = 0
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if commF then
            local ok, inv = pcall(function() return commF:InvokeServer("getInventory") end)
            if ok and type(inv) == "table" then
                for _, item in ipairs(inv) do
                    if type(item) == "table" and item.Name and item.Name:lower():find(matName:lower()) then
                        count = item.Count or 1
                    end
                end
            end
        end
        return count
    end

    -- Helper: Check Owned Dojo Belts in Inventory (Checks Character, Backpack, and getInventory)
    local function HasDojoBelt(beltColor)
        local colorLower = beltColor:lower():gsub(" belt", "")
        local lp = LocalPlayer
        if not lp then return false end
        local char = lp.Character
        if char then
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Accessory") or child:IsA("Tool") then
                    local n = child.Name:lower()
                    if n:find("belt") and n:find(colorLower) then
                        return true
                    end
                end
            end
        end
        local bp = lp:FindFirstChild("Backpack")
        if bp then
            for _, child in ipairs(bp:GetChildren()) do
                local n = child.Name:lower()
                if n:find("belt") and n:find(colorLower) then
                    return true
                end
            end
        end
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if commF then
            local ok, inv = pcall(function() return commF:InvokeServer("getInventory") end)
            if ok and type(inv) == "table" then
                for _, item in ipairs(inv) do
                    if type(item) == "table" and item.Name then
                        local n = tostring(item.Name):lower()
                        if n:find("belt") and n:find(colorLower) then
                            return true
                        end
                    end
                end
            end
        end
        return false
    end

