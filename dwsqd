local function getNearestMob()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local mobs = {"Chocolate Bar Battler", "Cocoa Warrior", "Candy Pirate", "Snow Demon", "Cookie Crafter", "Cake Guard", "Baking Staff", "Head Baker"}
    local nearest, minDist = nil, math.huge
    for _, name in ipairs(mobs) do
        for _, mob in pairs(workspace.Enemies:GetChildren()) do
            if mob.Name:find(name, 1, true) 
               and mob:FindFirstChildOfClass("Humanoid") 
               and (mob:FindFirstChildOfClass("Humanoid") and mob:FindFirstChildOfClass("Humanoid").Health or 0) > 0 
               and mob:FindFirstChild("HumanoidRootPart") then
                local dist = (hrp.Position - mob.HumanoidRootPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = mob
                end
            end
        end
    end
    return nearest
end

local function attackTarget(target)
    if not target or not target:FindFirstChild("Head") then return end
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        
        -- Always check if player is holding a combat tool
        local currentTool = char:FindFirstChildOfClass("Tool")
        if not currentTool and backpack then
            local combatTool = nil
            -- Search backpack for Melee, Sword, Blox Fruit, or Gun tools
            for _, t in pairs(backpack:GetChildren()) do
                if t:IsA("Tool") then
                    local toolType = t.ToolTip or ""
                    if toolType == "Melee" or toolType == "Sword" or toolType == "Blox Fruit" or toolType == "Gun" then
                        combatTool = t
                        break
                    end
                end
            end
            
            -- Fallback to first tool in backpack
            if not combatTool then
                combatTool = backpack:FindFirstChildOfClass("Tool")
            end
            
            if combatTool then
                if hum then
                    hum:EquipTool(combatTool)
                else
                    combatTool.Parent = char
                end
                currentTool = combatTool
            end
        end

        -- Trigger primary weapon attack
        if currentTool then
            currentTool:Activate()
        end

        -- Virtual User click trigger for melee/fruit combos
        local vu = game:GetService("VirtualUser")
        pcall(function()
            vu:CaptureController()
            vu:Button1Down(Vector2.new(100, 100))
        end)

        -- Fire Blox Fruits combat hit registration remotes
        SafeFire("RE/RegisterAttack", 0)
        local head = target:FindFirstChild("Head")
        if head then
            SafeFire("RE/RegisterHit", head, {}, tostring(LocalPlayer.UserId))
        end
    end)
end

